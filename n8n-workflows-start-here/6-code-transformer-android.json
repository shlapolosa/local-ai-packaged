{
  "name": "Agent - Code Transformer Android",
  "nodes": [
    {
      "parameters": {"httpMethod": "POST", "path": "agent-transform-android", "responseMode": "responseNode"},
      "id": "android-trigger",
      "name": "Android Transformer Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT artifact_data FROM artifacts WHERE migration_id = '{{ $json.migrationId }}' AND artifact_type = 'component_analysis' LIMIT 5"
      },
      "id": "get-contracts-android",
      "name": "Get Contracts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [450, 300],
      "credentials": {"postgres": {"id": "postgres-main"}}
    },
    {
      "parameters": {"fieldName": "artifact_data"},
      "id": "split-contracts-android",
      "name": "Split Contracts",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "url": "http://open-webui:8080/api/chat/completions",
        "requestMethod": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5:7b-instruct-q4_K_M\",\n  \"messages\": [\n    {\"role\": \"system\", \"content\": \"You are a Jetpack Compose expert. Generate Compose component following Material Design 3. Include TalkBack support. Return ONLY Kotlin code.\"},\n    {\"role\": \"user\", \"content\": \"Component: {{ $json.artifact_data.name }}\\n\\nGenerate Jetpack Compose implementation.\"}\n  ],\n  \"temperature\": 0.2\n}"
      },
      "id": "generate-kotlin",
      "name": "Generate Compose Code",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 300]
    },
    {
      "parameters": {
        "functionCode": "const code = $json.choices[0].message.content.match(/```kotlin\\n([\\s\\S]*?)\\n```/)?.[1] || $json.choices[0].message.content;\nconst name = $('Split Contracts').item.json.artifact_data.name;\nreturn {json: {componentName: name, code, filePath: `packages/native-components/android/${name}.kt`}};"
      },
      "id": "parse-kotlin",
      "name": "Parse Kotlin",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "command": "mkdir -p /tmp/migrations/{{ $('Android Transformer Trigger').item.json.migrationId }}/packages/native-components/android && echo '{{ $json.code }}' > /tmp/migrations/{{ $('Android Transformer Trigger').item.json.migrationId }}/{{ $json.filePath }}"
      },
      "id": "write-kotlin",
      "name": "Write Kotlin File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1250, 300]
    },
    {
      "parameters": {"mode": "combine"},
      "id": "aggregate-android",
      "name": "Aggregate Android Components",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [1450, 300]
    },
    {
      "parameters": {"respondWith": "json", "responseBody": "={{ {components: $input.all().map(i => i.json)} }}"},
      "id": "return-android",
      "name": "Return Android Components",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1650, 300]
    }
  ],
  "connections": {
    "Android Transformer Trigger": {"main": [[{"node": "Get Contracts"}]]},
    "Get Contracts": {"main": [[{"node": "Split Contracts"}]]},
    "Split Contracts": {"main": [[{"node": "Generate Compose Code"}]]},
    "Generate Compose Code": {"main": [[{"node": "Parse Kotlin"}]]},
    "Parse Kotlin": {"main": [[{"node": "Write Kotlin File"}]]},
    "Write Kotlin File": {"main": [[{"node": "Aggregate Android Components"}]]},
    "Aggregate Android Components": {"main": [[{"node": "Return Android Components"}]]}
  }
}
