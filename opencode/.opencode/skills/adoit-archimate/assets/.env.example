# ADOIT API Configuration
# Copy this file to .env and fill in your credentials
# DO NOT commit .env files with real credentials to version control

# ADOIT Instance URL (required)
ADOIT_URL=https://adoit-ce.boc-cloud.com

# Authentication (required)
ADOIT_USERNAME=your.email@example.com
ADOIT_PASSWORD=your_password_here

# Default Repository ID (optional)
# Find this in ADOIT: Administration > Repositories
ADOIT_REPOSITORY_ID=
