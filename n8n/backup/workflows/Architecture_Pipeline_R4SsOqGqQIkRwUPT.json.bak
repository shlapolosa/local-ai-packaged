          "name": "Postgres account"
        }
      }
    },
    {
      "id": "prepare-project-context",
      "name": "Prepare Project Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        504
      ],
      "parameters": {
        "jsCode": "// Prepare context for newly created project\nconst project = $json;\nconst initParams = $('Initialize Parameters').first().json;\n\nreturn [{\n  json: {\n    id: project.id,\n    slug: project.slug,\n    name: project.name || initParams.projectName || project.slug,\n    projectId: project.id,\n    projectSlug: project.slug,\n    projectName: project.name || initParams.projectName || project.slug,\n    requirements: initParams.requirements,\n    isNewProject: true\n  }\n}];"
      }
    }
  ],
