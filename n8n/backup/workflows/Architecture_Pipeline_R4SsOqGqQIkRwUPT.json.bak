      {
        "parameters": {
          "jsCode": "const ctx = $('Pass Context').first().json;\nconst archDir = ctx.projectSlug + '-docs/architecture';\nreturn [{ json: { success: true, jobId: ctx.jobId, projectSlug: ctx.projectSlug, stage: 'architecture', archPaths: { business: archDir + '/business.archimate', application: archDir + '/application.archimate', data: archDir + '/data.archimate', technology: archDir + '/technology.archimate', full: archDir + '/full.archimate', orgFull: 'org-architecture/full.archimate' } } }];"
        },
        "id": "return-result",
        "name": "Return Result",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          6000,
          304
        ]
      },
      {
        "parameters": {
          "rules": {
            "values": [
              {
                "conditions": {
                  "options": {
                    "version": 2,
                    "combinator": "and"
                  },
                  "conditions": [
                    {
                      "operator": {
                        "name": "equals",
                        "type": "string",
                        "operation": "equals"
                      },
                      "leftValue": "={{ $json.mode }}",
                      "rightValue": "chat"
                    }
                  ]
                }
              },
              {
                "conditions": {
                  "options": {
                    "version": 2,
                    "combinator": "and"
                  },
                  "conditions": [
                    {
                      "operator": {
                        "name": "equals",
                        "type": "string",
                        "operation": "equals"
                      },
                      "leftValue": "={{ $json.mode }}",
                      "rightValue": "execute"
                    }
                  ]
                }
              }
            ]
          },
          "options": {
            "fallbackOutput": "extra"
          }
        },
        "id": "mode-router",
        "name": "Mode Router",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3,
        "position": [
          288,
          32
        ]
      },
      {
        "parameters": {
          "jsCode": "// Architecture Pipeline Chat Handler\nconst input = $input.all()[0].json;\nconst intent = input.intent || 'help';\nconst projectSlug = input.projectSlug || null;\nconst query = input.query || input.rawInput || '';\n\nconst STAGE = 'architecture';\nconst ARTIFACT_TYPES = \"'business_arch', 'application_arch', 'data_arch', 'infrastructure_arch', 'archimate_xml_full'\";\n\nlet response = {\n  agent: 'Enterprise Architect',\n  stage: STAGE,\n  intent: intent,\n  success: true\n};\n\nswitch (intent) {\n  case 'help':\n    response.content = `# Architecture Pipeline\\n\\n## Available Commands\\n\\n| Command | Description |\\n|---------|-------------|\\n| help | Show this help message |\\n| status [project] | Check job status for a project |\\n| artifacts [project] | List architecture artifacts for a project |\\n| jobs | List recent jobs for this pipeline |\\n| list | List all projects |\\n\\n## Architecture Domains Generated\\n- Business Architecture (capabilities, actors, processes, services)\\n- Application Architecture (components, interfaces, data objects)\\n- Data Architecture (entities, flows, databases)\\n- Infrastructure Architecture (nodes, networks, deployments)\\n- ArchiMate XML Models\\n\\n## Execute Mode\\n\\nTo generate architecture, provide a project slug:\\n\\`\\`\\`\\nGenerate architecture for my-project\\n\\`\\`\\`\\n\\nNote: Requires an existing BRD from the Business Analysis pipeline.`;\n    response.message = 'Architecture Pipeline Help';\n    break;\n    \n  case 'status':\n    response.action = 'query_db';\n    response.queryType = 'status';\n    response.sql = projectSlug \n      ? `SELECT j.id, j.stage, j.status, j.created_at, j.completed_at, p.slug, p.name FROM architecture.jobs j JOIN architecture.projects p ON j.project_id = p.id WHERE j.stage = '${STAGE}' AND p.slug = '${projectSlug}' ORDER BY j.created_at DESC LIMIT 5`\n      : `SELECT j.id, j.stage, j.status, j.created_at, j.completed_at, p.slug, p.name FROM architecture.jobs j JOIN architecture.projects p ON j.project_id = p.id WHERE j.stage = '${STAGE}' ORDER BY j.created_at DESC LIMIT 10`;\n    break;\n    \n  case 'artifacts':\n    response.action = 'query_db';\n    response.queryType = 'artifacts';\n    response.sql = projectSlug\n      ? `SELECT a.id, a.type, a.version, a.created_at, p.slug, p.name FROM architecture.artifacts a JOIN architecture.projects p ON a.project_id = p.id WHERE a.type IN (${ARTIFACT_TYPES}) AND p.slug = '${projectSlug}' ORDER BY a.created_at DESC LIMIT 20`\n      : `SELECT a.id, a.type, a.version, a.created_at, p.slug, p.name FROM architecture.artifacts a JOIN architecture.projects p ON a.project_id = p.id WHERE a.type IN (${ARTIFACT_TYPES}) ORDER BY a.created_at DESC LIMIT 20`;\n    break;\n    \n  case 'jobs':\n    response.action = 'query_db';\n    response.queryType = 'jobs';\n    response.sql = `SELECT j.id, j.stage, j.status, j.created_at, j.completed_at, p.slug, p.name FROM architecture.jobs j JOIN architecture.projects p ON j.project_id = p.id WHERE j.stage = '${STAGE}' ORDER BY j.created_at DESC LIMIT 20`;\n    break;\n    \n  case 'list':\n    response.action = 'query_db';\n    response.queryType = 'projects';\n    response.sql = `SELECT p.id, p.slug, p.name, p.created_at, p.updated_at, (SELECT COUNT(*) FROM architecture.artifacts a WHERE a.project_id = p.id AND a.type IN (${ARTIFACT_TYPES})) as arch_count, (SELECT COUNT(*) FROM architecture.jobs j WHERE j.project_id = p.id AND j.stage = '${STAGE}') as job_count FROM architecture.projects p ORDER BY p.updated_at DESC LIMIT 20`;\n    break;\n    \n  default:\n    response.success = false;\n    response.message = `Unknown intent: ${intent}`;\n    response.content = 'Try \"help\" to see available commands.';\n}\n\nreturn [{ json: response }];"
        },
        "id": "chat-handler",
        "name": "Chat Handler",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
