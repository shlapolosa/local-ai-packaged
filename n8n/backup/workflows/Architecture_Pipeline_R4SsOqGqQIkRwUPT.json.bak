    {
      "id": "normalize-brd-rows",
      "name": "Normalize BRD Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
        304
      ],
      "parameters": {
        "jsCode": "// Normalize rows from Postgres\nconst items = $input.all();\nif (!items.length) return [{ json: { rows: [] } }];\nconst rows = items.map(i => i.json);\nreturn [{ json: { rows } }];"
      },
      "alwaysOutputData": true
    },
    {
      "id": "determine-brd-flow",
      "name": "Determine BRD Flow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        304
      ],
      "parameters": {
        "jsCode": "// Determine if we have an existing BRD from DB\nconst rows = Array.isArray($json.rows) ? $json.rows : [];\nconst first = rows[0] || null;\nconst brd = first && typeof first.content === 'object' ? first.content : null;\nconst hasBrd = !!(brd && brd.type === 'brd' && brd.title && brd.executiveSummary);\n\nreturn hasBrd\n  ? [{ json: { hasBrd: true, brdFromDb: brd } }]\n  : [{ json: { hasBrd: false } }];"
      }
    },
