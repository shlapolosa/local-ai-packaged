                "type": "string",
                "value": "={{ $('Initialize Parameters').first().json.projectSlug || 'direct-requirements' }}"
              },
              {
                "id": "requirements",
                "name": "requirements",
                "type": "string",
                "value": "={{ $('Initialize Parameters').first().json.requirements }}"
              },
              {
                "id": "jobId",
                "name": "jobId",
                "type": "string",
                "value": "direct-{{ Date.now() }}"
              }
            ]
          },
