    "workflowId": "R4SsOqGqQIkRwUPT",
    "nodes": [
      {
        "parameters": {
          "inputSource": "passthrough"
        },
        "id": "trigger",
        "name": "Execute Workflow Trigger",
        "type": "n8n-nodes-base.executeWorkflowTrigger",
        "typeVersion": 1.1,
        "position": [
          0,
          304
        ]
      },
      {
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "name": "requirements",
                "value": "={{ $json.requirements || '' }}",
                "type": "string"
              },
              {
                "name": "projectName",
                "value": "={{ $json.projectName || $json.extractedProjectSlug || $json.projectSlug }}",
                "type": "string"
              },
              {
                "name": "projectSlug",
                "value": "={{ $json.extractedProjectSlug || $json.projectSlug }}",
                "type": "string"
              },
              {
                "name": "inputJobId",
                "value": "={{ $json.inputJobId || null }}",
                "type": "string"
              },
              {
                "name": "comments",
                "value": "={{ $json.comments || null }}",
                "type": "string"
              },
              {
                "name": "ackJobId",
                "value": "={{ $json.ackJobId || null }}",
                "type": "string"
              },
              {
                "name": "ollamaModel",
                "value": "llama3.1:8b-instruct-q4_K_M",
                "type": "string"
              },
              {
                "name": "ollamaTemperature",
                "value": 0,
                "type": "number"
              },
              {
                "name": "ollamaSeed",
                "value": 42,
                "type": "number"
              }
            ]
          },
          "options": {}
        },
        "id": "init-params",
        "name": "Initialize Parameters",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          352,
          592
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT p.id, p.slug, p.name FROM architecture.projects p WHERE p.slug = $1;",
          "options": {
            "queryReplacement": "={{ [ $json.projectSlug ] }}"
          }
        },
        "id": "get-project",
        "name": "Load Project",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          480,
          304
        ],
        "credentials": {
          "postgres": {
            "id": "M5eIfNwtZu8y3dOp",
            "name": "Postgres account"
          }
        },
        "onError": "continueRegularOutput",
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id FROM architecture.jobs WHERE project_id = $1 AND stage = 'business-analysis' AND status = 'completed' ORDER BY created_at DESC LIMIT 1;",
          "options": {
            "queryReplacement": "={{ [ $json.id ] }}"
          }
        },
        "id": "get-ba-job",
        "name": "Get Latest BA Job",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          720,
          304
        ],
        "alwaysOutputData": true,
        "credentials": {
          "postgres": {
            "id": "M5eIfNwtZu8y3dOp",
            "name": "Postgres account"
          }
        }
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO architecture.jobs (project_id, stage, input_job_id, status, meta) VALUES ($1, 'architecture', $2, 'running', $3::jsonb) RETURNING id, stage, status;",
          "options": {
            "queryReplacement": "={{ [ $('Load Project').first().json.id, $json.id || null, JSON.stringify({ comments: $('Initialize Parameters').first().json.comments }) ] }}"
          }
        },
        "id": "create-job",
        "name": "Create Arch Job",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          960,
          304
        ],
        "credentials": {
          "postgres": {
            "id": "M5eIfNwtZu8y3dOp",
            "name": "Postgres account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const init = $('Initialize Parameters').first().json;\nconst project = $('Load Project').first().json;\nconst job = $json;\nreturn [{ json: { ...init, projectId: project.id, projectSlug: project.slug, projectName: project.name || project.slug, jobId: job.id } }];"
        },
        "id": "pass-context",
        "name": "Pass Context",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1200,
          304
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT content FROM architecture.artifacts WHERE project_id = $1 AND type = 'brd' ORDER BY version DESC LIMIT 1;",
          "options": {
            "queryReplacement": "={{ [ $json.projectId ] }}"
          }
        },
        "id": "load-brd",
        "name": "Load BRD",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1440,
          304
        ],
        "credentials": {
          "postgres": {
            "id": "M5eIfNwtZu8y3dOp",
            "name": "Postgres account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Collect BRD from either DB, existing BRD, or generated from requirements\nconst ctx = $('Pass Context').first().json;\nconst brdSource = $json.brdSource || 'db';\n\nlet brd;\nif (brdSource === 'db') {\n  // From database via Use Existing BRD\n  const dbContent = $('Determine BRD Flow').first().json.brdFromDb;\n  brd = dbContent || {};\n} else if (brdSource === 'generated') {\n  // From generated BRD via Format Generated BRD\n  try {\n    const msgContent = $json.message?.content;\n    if (typeof msgContent === 'string') {\n      brd = JSON.parse(msgContent);\n    } else {\n      brd = msgContent || {};\n    }\n  } catch (e) {\n    brd = { type: 'brd', title: 'Generated BRD', executiveSummary: 'BRD generated from requirements' };\n  }\n} else {\n  // Direct requirements (fallback)\n  const requirements = $('Initialize Parameters').first().json.requirements || '';\n  if (requirements.startsWith('{')) {\n    try {\n      brd = JSON.parse(requirements);\n    } catch (e) {\n      brd = { type: 'requirements', content: requirements };\n    }\n  } else {\n    brd = { type: 'requirements', content: requirements };\n  }\n}\n\nreturn [{ json: { ...ctx, brd, brdSource } }];"
        },
        "id": "collect-brd",
        "name": "Collect BRD",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2160,
          304
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "http://ollama:11434/api/chat",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ {\n  model: $('Initialize Parameters').first().json.ollamaModel,\n  messages: [\n    { role: 'system', content: 'You are an Enterprise Architect following ArchiMate 3.0 standard.\\n\\nParse the BRD document and extract elements for Motivation, Strategy, and Business layers.\\n\\n## ID CONVENTIONS (FOLLOW EXACTLY):\\n- Stakeholders: id-sh-{kebab-case-name}\\n- Drivers: id-dr-{kebab-case-name}\\n- Goals: id-gl-{kebab-case-name}\\n- Outcomes: id-oc-{kebab-case-name}\\n- Courses of Action: id-coa-{kebab-case-name}\\n- Capabilities: id-cap-{kebab-case-name}\\n- Resources: id-res-{kebab-case-name}\\n- Business Actors: id-ba-{kebab-case-name}\\n- Business Processes: id-bp-{kebab-case-name}\\n- Business Services: id-bs-{kebab-case-name}\\n- Business Objects: id-bo-{kebab-case-name}\\n\\n## EXTRACTION RULES:\\n### MOTIVATION LAYER\\n- Stakeholders: Named organizations with interest (government agencies, companies)\\n- Drivers: Current problems/challenges (keywords: low, minimal, fragmented, lack of)\\n- Goals: Measurable objectives (keywords: increase by, reduce, achieve, enable)\\n- Outcomes: Tangible results (keywords: higher uptake, reduced friction, early detection)\\n\\n### STRATEGY LAYER\\n- Courses of Action: Major initiatives/epics that address outcomes\\n- Capabilities: Business abilities required (Patient Management, Appointment Scheduling)\\n- Resources: External APIs/data sources needed\\n\\n### BUSINESS LAYER\\n- Business Actors: Human roles (citizen, patient, provider, admin)\\n- Business Processes: User journey steps\\n- Business Services: Value exposed to actors\\n- Business Objects: Key information items\\n\\nOutput ONLY valid JSON matching the required schema.' },\n    { role: 'user', content: 'BRD: ' + JSON.stringify($json.brd).slice(0, 14000) }\n  ],\n  stream: false,\n  format: { type: 'object', required: ['motivation','strategy','business','relationships'], properties: { motivation: { type: 'object', required: ['stakeholders','drivers','goals','outcomes'], properties: { stakeholders: { type: 'array' }, drivers: { type: 'array' }, goals: { type: 'array' }, outcomes: { type: 'array' } } }, strategy: { type: 'object', required: ['coursesOfAction','capabilities','resources'], properties: { coursesOfAction: { type: 'array' }, capabilities: { type: 'array' }, resources: { type: 'array' } } }, business: { type: 'object', required: ['actors','processes','services','objects'], properties: { actors: { type: 'array' }, processes: { type: 'array' }, services: { type: 'array' }, objects: { type: 'array' } } }, relationships: { type: 'array', items: { type: 'object', properties: { source: { type: 'string' }, target: { type: 'string' }, type: { type: 'string' } }, required: ['source', 'target', 'type'] } } } },\n  options: { temperature: $('Initialize Parameters').first().json.ollamaTemperature, seed: $('Initialize Parameters').first().json.ollamaSeed }\n} }}",
          "options": {
            "timeout": 240000
          }
        },
        "id": "gen-business",
        "name": "Generate Business Architecture",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.3,
        "position": [
          2400,
          304
        ],
        "retryOnFail": true
      },
      {
        "parameters": {
          "jsCode": "// Validate and extract Motivation, Strategy, and Business layers\nconst raw = $json.message?.content;\nlet arch;\ntry {\n  arch = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { valid: false, error: 'Failed to parse LLM response', businessArch: null, businessRelationships: [] } }];\n}\n\nconst errors = [];\nconst fnv1a = (s) => { let h = 0x811c9dc5; for (let i = 0; i < (s||'').length; i++) { h ^= s.charCodeAt(i); h = (h * 0x01000193) >>> 0; } return ('0000000' + h.toString(16)).slice(-8); };\n\n// ID pattern validation\nconst idPatterns = {\n  stakeholder: /^id-sh-[a-z0-9-]+$/,\n  driver: /^id-dr-[a-z0-9-]+$/,\n  goal: /^id-gl-[a-z0-9-]+$/,\n  outcome: /^id-oc-[a-z0-9-]+$/,\n  courseOfAction: /^id-coa-[a-z0-9-]+$/,\n  capability: /^id-cap-[a-z0-9-]+$/,\n  resource: /^id-res-[a-z0-9-]+$/,\n  actor: /^id-ba-[a-z0-9-]+$/,\n  process: /^id-bp-[a-z0-9-]+$/,\n  service: /^id-bs-[a-z0-9-]+$/,\n  object: /^id-bo-[a-z0-9-]+$/\n};\n\n// Validate element has required fields\nconst validateElement = (el, layerName, elemType, pattern) => {\n  if (!el.id) errors.push(`${layerName}.${elemType}: missing id`);\n  else if (pattern && !pattern.test(el.id)) errors.push(`${layerName}.${elemType}: invalid id format '${el.id}'`);\n  if (!el.name) errors.push(`${layerName}.${elemType}: missing name`);\n  if (!el.type) errors.push(`${layerName}.${elemType}: missing type`);\n};\n\n// Validate Motivation layer\nconst motivation = arch.motivation || {};\nfor (const sh of (motivation.stakeholders || [])) validateElement(sh, 'motivation', 'stakeholder', idPatterns.stakeholder);\nfor (const dr of (motivation.drivers || [])) validateElement(dr, 'motivation', 'driver', idPatterns.driver);\nfor (const gl of (motivation.goals || [])) validateElement(gl, 'motivation', 'goal', idPatterns.goal);\nfor (const oc of (motivation.outcomes || [])) validateElement(oc, 'motivation', 'outcome', idPatterns.outcome);\n\n// Validate Strategy layer\nconst strategy = arch.strategy || {};\nfor (const coa of (strategy.coursesOfAction || [])) validateElement(coa, 'strategy', 'courseOfAction', idPatterns.courseOfAction);\nfor (const cap of (strategy.capabilities || [])) validateElement(cap, 'strategy', 'capability', idPatterns.capability);\nfor (const res of (strategy.resources || [])) validateElement(res, 'strategy', 'resource', idPatterns.resource);\n\n// Validate Business layer\nconst business = arch.business || {};\nfor (const actor of (business.actors || [])) validateElement(actor, 'business', 'actor', idPatterns.actor);\nfor (const proc of (business.processes || [])) validateElement(proc, 'business', 'process', idPatterns.process);\nfor (const svc of (business.services || [])) validateElement(svc, 'business', 'service', idPatterns.service);\nfor (const obj of (business.objects || [])) validateElement(obj, 'business', 'object', idPatterns.object);\n\n// Collect all element IDs for relationship validation\nconst allIds = new Set();\nconst addIds = (arr) => (arr || []).forEach(el => el.id && allIds.add(el.id));\naddIds(motivation.stakeholders); addIds(motivation.drivers); addIds(motivation.goals); addIds(motivation.outcomes);\naddIds(strategy.coursesOfAction); addIds(strategy.capabilities); addIds(strategy.resources);\naddIds(business.actors); addIds(business.processes); addIds(business.services); addIds(business.objects);\n\n// Validate relationships\nconst relationships = (arch.relationships || []).map(r => ({\n  ...r,\n  sourceLayer: r.source.startsWith('id-sh-') || r.source.startsWith('id-dr-') || r.source.startsWith('id-gl-') || r.source.startsWith('id-oc-') ? 'motivation' :\n               r.source.startsWith('id-coa-') || r.source.startsWith('id-cap-') || r.source.startsWith('id-res-') ? 'strategy' : 'business',\n  targetLayer: r.target.startsWith('id-sh-') || r.target.startsWith('id-dr-') || r.target.startsWith('id-gl-') || r.target.startsWith('id-oc-') ? 'motivation' :\n               r.target.startsWith('id-coa-') || r.target.startsWith('id-cap-') || r.target.startsWith('id-res-') ? 'strategy' : 'business'\n}));\n\nfor (const rel of relationships) {\n  if (!allIds.has(rel.source)) errors.push(`relationship: source '${rel.source}' not found`);\n  if (!allIds.has(rel.target)) errors.push(`relationship: target '${rel.target}' not found`);\n}\n\n// Return validation result\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors: errors.slice(0, 10),\n    motivation: arch.motivation,\n    strategy: arch.strategy,\n    businessArch: arch.business,\n    businessRelationships: relationships,\n    businessArchHash: fnv1a(JSON.stringify(arch))\n  }\n}];"
        },
        "id": "val-business",
        "name": "Validate Business Arch",
        "type": "n8n-nodes-base.code",
