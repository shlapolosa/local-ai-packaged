    {
      "parameters": {
        "jsCode": "// Parse and normalize incoming request\n// Detect Open WebUI system prompts (auto-tagging, follow-ups, title generation)\nconst input = $json.body || $json;\n\n// Check multiple possible field names for user input\n// Open WebUI may send as chatInput, projectSlug, message, or query\nconst chatInput = input.chatInput || input.message || input.query || input.projectSlug || '';\nconst requirements = input.requirements || '';\n\n// Detect Open WebUI system prompts\nconst isAutoTag = chatInput.includes('### Task:') && chatInput.includes('Generate 1-3 broad tags');\nconst isFollowUp = chatInput.includes('### Task:') && chatInput.includes('Suggest 3-5 relevant follow-up');\nconst isTitleGen = chatInput.includes('### Task:') && chatInput.includes('Generate a concise');\nconst isSystemPrompt = isAutoTag || isFollowUp || isTitleGen;\n\n// Also check requirements field for system prompts\nconst reqIsAutoTag = requirements.includes('### Task:') && requirements.includes('Generate 1-3 broad tags');\nconst reqIsFollowUp = requirements.includes('### Task:') && requirements.includes('Suggest 3-5 relevant follow-up');\nconst reqIsTitleGen = requirements.includes('### Task:') && requirements.includes('Generate a concise');\nconst reqIsSystemPrompt = reqIsAutoTag || reqIsFollowUp || reqIsTitleGen;\n\n// Determine system prompt type\nlet systemPromptType = null;\nif (isAutoTag || reqIsAutoTag) systemPromptType = 'auto-tag';\nelse if (isFollowUp || reqIsFollowUp) systemPromptType = 'follow-up';\nelse if (isTitleGen || reqIsTitleGen) systemPromptType = 'title-gen';\n\n// Only use projectSlug from input if it looks like a slug (no spaces, short)\n// Otherwise it might be the user message sent with wrong field name\nconst inputProjectSlug = input.projectSlug || null;\nconst looksLikeSlug = inputProjectSlug && inputProjectSlug.length < 100 && !inputProjectSlug.includes(' ');\nconst actualProjectSlug = looksLikeSlug ? inputProjectSlug : null;\n\n// FIX: Use requirements as fallback for rawInput when not a system prompt\n// This handles Open WebUI sending user messages in the requirements field\nlet rawInput = chatInput;\nif (!rawInput && !(isSystemPrompt || reqIsSystemPrompt) && requirements) {\n  rawInput = requirements;\n}\n\nreturn [{ json: {\n  rawInput: rawInput,\n  projectSlug: actualProjectSlug,\n  projectName: input.projectName || null,\n  requirements: input.requirements || null,\n  sessionId: input.sessionId || null,\n  isSystemPrompt: isSystemPrompt || reqIsSystemPrompt,\n  systemPromptType: systemPromptType\n} }];\n"
      },
      "id": "parse-input",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
