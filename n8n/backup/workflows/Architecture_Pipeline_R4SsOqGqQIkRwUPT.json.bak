    {
      "parameters": {
        "jsCode": "// Format DB query results for chat response\nconst chatHandler = $('Chat Handler').first().json;\nconst queryType = chatHandler.queryType;\nconst rows = $input.all().map(i => i.json);\n\nlet content = '';\nlet message = '';\n\nif (rows.length === 0) {\n  content = 'No results found.';\n  message = 'Empty result set';\n} else {\n  switch (queryType) {\n    case 'projects':\n      content = '# Projects\\\\n\\\\n| Slug | Name | Arch Artifacts | Jobs | Updated |\\\\n|------|------|----------------|------|---------|\\\\n';\n      for (const row of rows) {\n        const updated = row.updated_at ? new Date(row.updated_at).toLocaleDateString() : 'N/A';\n        content += `| ${row.slug} | ${row.name || 'N/A'} | ${row.arch_count || 0} | ${row.job_count || 0} | ${updated} |\\\\n`;\n      }\n      message = `Found ${rows.length} project(s)`;\n      break;\n      \n    case 'status':\n    case 'jobs':\n      content = '# Jobs\\\\n\\\\n| ID | Project | Stage | Status | Created | Completed |\\\\n|----|---------|-------|--------|---------|-----------|\\\\n';\n      for (const row of rows) {\n        const created = row.created_at ? new Date(row.created_at).toLocaleDateString() : 'N/A';\n        const completed = row.completed_at ? new Date(row.completed_at).toLocaleDateString() : '-';\n        const shortId = (row.id || '').substring(0, 8);\n        content += `| ${shortId}... | ${row.slug || 'N/A'} | ${row.stage} | ${row.status} | ${created} | ${completed} |\\\\n`;\n      }\n      message = `Found ${rows.length} job(s)`;\n      break;\n      \n    case 'artifacts':\n      content = '# Artifacts\\\\n\\\\n| ID | Project | Type | Version | Created |\\\\n|----|---------|------|---------|---------|\\\\n';\n      for (const row of rows) {\n        const created = row.created_at ? new Date(row.created_at).toLocaleDateString() : 'N/A';\n        const shortId = (row.id || '').substring(0, 8);\n        content += `| ${shortId}... | ${row.slug || 'N/A'} | ${row.type} | v${row.version} | ${created} |\\\\n`;\n      }\n      message = `Found ${rows.length} artifact(s)`;\n      break;\n      \n    default:\n      content = '```json\\\\n' + JSON.stringify(rows, null, 2) + '\\\\n```';\n      message = `Query returned ${rows.length} row(s)`;\n  }\n}\n\nreturn [{ json: {\n  agent: chatHandler.agent,\n  stage: chatHandler.stage,\n  intent: chatHandler.intent,\n  success: true,\n  content: content,\n  message: message,\n  rowCount: rows.length\n} }];"
      },
