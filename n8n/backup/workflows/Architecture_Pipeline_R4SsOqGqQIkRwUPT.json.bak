        "typeVersion": 2.2,
        "position": [
          -400,
          144
        ]
      },
      {
        "parameters": {
          "jsCode": "// Handle Open WebUI system prompts (auto-tag, follow-up, title-gen)\nconst input = $json;\nconst promptType = input.systemPromptType;\n\nlet response = {};\n\nswitch (promptType) {\n  case 'auto-tag':\n    response = { tags: ['Architecture', 'Enterprise', 'ArchiMate'] };\n    break;\n  case 'follow-up':\n    response = { follow_ups: [\n      'What is the current project status?',\n      'Can you show me the architecture artifacts?',\n      'What are the recent architecture jobs?'\n    ] };\n    break;\n  case 'title-gen':\n    response = { title: 'Architecture Session' };\n    break;\n  default:\n    response = { message: 'Unknown system prompt type' };\n}\n\nreturn [{ json: response }];"
        },
        "id": "system-prompt-handler",
        "name": "System Prompt Handler",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          -96,
          80
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $json }}",
          "options": {}
        },
        "id": "respond-system-prompt",
        "name": "Respond: System Prompt",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          112,
          80
        ]
      },
      {
        "parameters": {
          "jsCode": "// Process LLM classification response\nconst parseInput = $('Parse Input').first().json;\nconst llmResponse = $json.message?.content || '{}';\n\nlet classified;\ntry {\n  classified = typeof llmResponse === 'string' ? JSON.parse(llmResponse) : llmResponse;\n} catch (e) {\n  classified = { mode: 'chat', intent: 'help' };\n}\n\nconst mode = classified.mode || 'chat';\nconst intent = classified.intent || 'help';\n\nconst projectSlug = parseInput.projectSlug || classified.projectSlug || null;\nconst requirements = parseInput.requirements || classified.requirements || parseInput.rawInput;\nconst projectName = parseInput.projectName || projectSlug || 'new-project';\n\nreturn [{ json: {\n  mode,\n  intent,\n  projectSlug,\n  projectName,\n  requirements,\n  rawInput: parseInput.rawInput,\n  sessionId: parseInput.sessionId\n} }];"
        },
