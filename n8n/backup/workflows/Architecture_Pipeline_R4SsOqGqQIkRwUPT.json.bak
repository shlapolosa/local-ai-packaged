      {
        "parameters": {
          "jsCode": "// Convert all architecture layers to ArchiMate 3.0 Exchange Format XML\n// Implements Steps 5-8 of the doc-to-archimate formula\n\nconst ctx = $('Pass Context').first().json;\nconst bizVal = $('Validate Business Arch').first().json;\nconst appVal = $('Validate Application Arch').first().json;\nconst dataVal = $('Validate Data Arch').first().json;\nconst infraVal = $('Validate Infrastructure Arch').first().json;\n\n// Extract layer data\nconst motivation = bizVal.motivation || {};\nconst strategy = bizVal.strategy || {};\nconst business = bizVal.businessArch || {};\nconst application = appVal.applicationArch || {};\nconst data = dataVal.dataArch || {};\nconst infra = infraVal.infraArch || {};\n\n// Collect existing relationships from all layers\nconst existingRels = [\n  ...(bizVal.businessRelationships || []),\n  ...(appVal.applicationRelationships || []),\n  ...(dataVal.dataRelationships || []),\n  ...(infraVal.infraRelationships || [])\n];\n\n// Utilities\nconst escXml = (s) => String(s || '').replace(/&/g, '&amp;').replace(/\"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/'/g, '&apos;');\nconst fnv1a = (s) => { let h = 0x811c9dc5; for (let i = 0; i < (s||'').length; i++) { h ^= s.charCodeAt(i); h = (h * 0x01000193) >>> 0; } return ('0000000' + h.toString(16)).slice(-8); };\n\n// ArchiMate type mapping\nconst typeMap = {\n  // Motivation\n  'Stakeholder': 'Stakeholder', 'Driver': 'Driver', 'Goal': 'Goal', 'Outcome': 'Outcome',\n  // Strategy\n  'CourseOfAction': 'CourseOfAction', 'Capability': 'Capability', 'Resource': 'Resource',\n  // Business\n  'BusinessActor': 'BusinessActor', 'BusinessProcess': 'BusinessProcess',\n  'BusinessService': 'BusinessService', 'BusinessObject': 'BusinessObject',\n  // Application\n  'ApplicationComponent': 'ApplicationComponent', 'ApplicationService': 'ApplicationService',\n  'ApplicationInterface': 'ApplicationInterface', 'ApplicationFunction': 'ApplicationFunction',\n  'DataObject': 'DataObject', 'ApplicationEvent': 'ApplicationEvent',\n  // Technology\n  'Node': 'Node', 'CommunicationNetwork': 'CommunicationNetwork',\n  'SystemSoftware': 'SystemSoftware', 'Artifact': 'Artifact'\n};\n\n// Collect all elements with their ArchiMate types\nconst elements = [];\nconst addElements = (arr, defaultType) => {\n  for (const el of (arr || [])) {\n    if (!el || !el.id) continue;\n    const archType = typeMap[el.type] || defaultType;\n    elements.push({ id: el.id, name: el.name || el.id, type: archType, layer: el.layer });\n  }\n};\n\n// Motivation layer\naddElements(motivation.stakeholders, 'Stakeholder');\naddElements(motivation.drivers, 'Driver');\naddElements(motivation.goals, 'Goal');\naddElements(motivation.outcomes, 'Outcome');\n\n// Strategy layer\naddElements(strategy.coursesOfAction, 'CourseOfAction');\naddElements(strategy.capabilities, 'Capability');\naddElements(strategy.resources, 'Resource');\n\n// Business layer\naddElements(business.actors, 'BusinessActor');\naddElements(business.processes, 'BusinessProcess');\naddElements(business.services, 'BusinessService');\naddElements(business.objects, 'BusinessObject');\n\n// Application layer\naddElements(application.components, 'ApplicationComponent');\naddElements(application.services, 'ApplicationService');\naddElements(application.interfaces, 'ApplicationInterface');\naddElements(application.functions, 'ApplicationFunction');\naddElements(application.dataObjects, 'DataObject');\naddElements(application.events, 'ApplicationEvent');\n\n// Data layer (merged into application as DataObjects)\naddElements(data.dataEntities, 'DataObject');\naddElements(data.databases, 'Artifact');\n\n// Infrastructure layer\naddElements(infra.nodes, 'Node');\naddElements(infra.networks, 'CommunicationNetwork');\naddElements(infra.deployments, 'SystemSoftware');\naddElements(infra.artifacts, 'Artifact');\n\n// Build element ID lookup\nconst elementIds = new Set(elements.map(e => e.id));\n\n// STEP 5: Generate Relationships\n// Normalize relationship type\nconst normalizeRelType = (type) => {\n  if (!type) return 'Association';\n  const t = type.replace(/Relationship$/i, '').trim();\n  const map = {\n    'serving': 'Serving', 'composition': 'Composition', 'aggregation': 'Aggregation',\n    'assignment': 'Assignment', 'realization': 'Realization', 'access': 'Access',\n    'triggering': 'Triggering', 'flow': 'Flow', 'association': 'Association',\n    'specialization': 'Specialization', 'influence': 'Influence'\n  };\n  return map[t.toLowerCase()] || t;\n};\n\nconst relationships = [];\nlet relCounter = 1;\n\n// Add existing relationships\nfor (const rel of existingRels) {\n  if (!rel.source || !rel.target) continue;\n  if (!elementIds.has(rel.source) || !elementIds.has(rel.target)) continue;\n  relationships.push({\n    id: `id-rel-${String(relCounter++).padStart(3, '0')}`,\n    source: rel.source,\n    target: rel.target,\n    type: normalizeRelType(rel.type)\n  });\n}\n\n// Generate standard ArchiMate relationships by pattern\n// Stakeholder -> Driver (Association)\nfor (const sh of (motivation.stakeholders || [])) {\n  for (const dr of (motivation.drivers || [])) {\n    relationships.push({ id: `id-rel-${String(relCounter++).padStart(3, '0')}`, source: sh.id, target: dr.id, type: 'Association' });\n  }\n}\n\n// Driver -> Goal (Influence)\nfor (const dr of (motivation.drivers || [])) {\n  for (const gl of (motivation.goals || [])) {\n    relationships.push({ id: `id-rel-${String(relCounter++).padStart(3, '0')}`, source: dr.id, target: gl.id, type: 'Influence' });\n  }\n}\n\n// Outcome -> Goal (Realization)\nfor (const oc of (motivation.outcomes || [])) {\n  for (const gl of (motivation.goals || [])) {\n    relationships.push({ id: `id-rel-${String(relCounter++).padStart(3, '0')}`, source: oc.id, target: gl.id, type: 'Realization' });\n  }\n}\n\n// CourseOfAction -> Outcome (Realization)\nfor (const coa of (strategy.coursesOfAction || [])) {\n  for (const oc of (motivation.outcomes || [])) {\n    relationships.push({ id: `id-rel-${String(relCounter++).padStart(3, '0')}`, source: coa.id, target: oc.id, type: 'Realization' });\n  }\n}\n\n// Capability -> CourseOfAction (Realization)\nfor (const cap of (strategy.capabilities || [])) {\n  for (const coa of (strategy.coursesOfAction || [])) {\n    relationships.push({ id: `id-rel-${String(relCounter++).padStart(3, '0')}`, source: cap.id, target: coa.id, type: 'Realization' });\n  }\n}\n\n// BusinessProcess -> Capability (Realization)\nfor (const bp of (business.processes || [])) {\n  for (const cap of (strategy.capabilities || []).slice(0, 3)) {\n    relationships.push({ id: `id-rel-${String(relCounter++).padStart(3, '0')}`, source: bp.id, target: cap.id, type: 'Realization' });\n  }\n}\n\n// ApplicationService -> BusinessProcess (Serving)\nfor (const as of (application.services || [])) {\n  for (const bp of (business.processes || []).slice(0, 2)) {\n    relationships.push({ id: `id-rel-${String(relCounter++).padStart(3, '0')}`, source: as.id, target: bp.id, type: 'Serving' });\n  }\n}\n\n// STEP 6: Generate Organizations (Folder Structure)\nconst genOrgItem = (label, refs) => {\n  if (!refs || refs.length === 0) return '';\n  const items = refs.map(r => `      <item><idRef>${escXml(r.id)}</idRef></item>`).join('\\n');\n  return `    <item>\\n      <label xml:lang=\"en\">${escXml(label)}</label>\\n${items}\\n    </item>`;\n};\n\nlet orgXml = '  <organizations>\\n';\norgXml += genOrgItem('Motivation', [...(motivation.stakeholders||[]), ...(motivation.drivers||[]), ...(motivation.goals||[]), ...(motivation.outcomes||[])]);\norgXml += '\\n';\norgXml += genOrgItem('Strategy', [...(strategy.coursesOfAction||[]), ...(strategy.capabilities||[]), ...(strategy.resources||[])]);\norgXml += '\\n';\norgXml += genOrgItem('Business', [...(business.actors||[]), ...(business.processes||[]), ...(business.services||[]), ...(business.objects||[])]);\norgXml += '\\n';\norgXml += genOrgItem('Application', [...(application.components||[]), ...(application.services||[]), ...(application.interfaces||[]), ...(application.functions||[]), ...(application.dataObjects||[]), ...(application.events||[])]);\norgXml += '\\n';\norgXml += genOrgItem('Relations', relationships);\norgXml += '\\n  </organizations>';\n\n// STEP 7: Generate Views\n// Standard ArchiMate colors\nconst colors = {\n  motivation: '#CCCCFF', strategy: '#F5DEB3', business: '#FFFFB5',\n  application: '#B5D3E7', dataObject: '#C9E7B5', event: '#FFB5B5', external: '#D5D5D5'\n};\n\nconst getColor = (el) => {\n  if (el.id.startsWith('id-sh-') || el.id.startsWith('id-dr-') || el.id.startsWith('id-gl-') || el.id.startsWith('id-oc-')) return colors.motivation;\n  if (el.id.startsWith('id-coa-') || el.id.startsWith('id-cap-') || el.id.startsWith('id-res-')) return colors.strategy;\n  if (el.id.startsWith('id-ba-') || el.id.startsWith('id-bp-') || el.id.startsWith('id-bs-') || el.id.startsWith('id-bo-')) return colors.business;\n  if (el.id.startsWith('id-do-')) return colors.dataObject;\n  if (el.id.startsWith('id-ae-')) return colors.event;\n  if (el.id.includes('-ext-')) return colors.external;\n  return colors.application;\n};\n\n// Application Architecture View (main view)\nlet appViewNodes = '';\nlet y = 50;\nconst nodeWidth = 180, nodeHeight = 60, gap = 30;\n\n// Layer: Presentation\nlet x = 50;\nfor (const comp of (application.components || []).filter(c => c.layer === 'presentation')) {\n  appViewNodes += `      <node xsi:type=\"Element\" identifier=\"view-node-${fnv1a(comp.id)}\" elementRef=\"${escXml(comp.id)}\" x=\"${x}\" y=\"${y}\" w=\"${nodeWidth}\" h=\"${nodeHeight}\">\n        <style><fillColor r=\"181\" g=\"211\" b=\"231\"/></style>\n      </node>\\n`;\n  x += nodeWidth + gap;\n}\n\n// Layer: Gateway\ny += nodeHeight + gap;\nx = 50;\nfor (const comp of (application.components || []).filter(c => c.layer === 'gateway' || c.name?.toLowerCase().includes('gateway'))) {\n  appViewNodes += `      <node xsi:type=\"Element\" identifier=\"view-node-${fnv1a(comp.id)}\" elementRef=\"${escXml(comp.id)}\" x=\"${x}\" y=\"${y}\" w=\"${nodeWidth}\" h=\"${nodeHeight}\">\n        <style><fillColor r=\"181\" g=\"211\" b=\"231\"/></style>\n      </node>\\n`;\n  x += nodeWidth + gap;\n}\n\n// Layer: Service (remaining internal components)\ny += nodeHeight + gap;\nx = 50;\nfor (const comp of (application.components || []).filter(c => !c.layer || c.layer === 'service')) {\n  if (comp.id.includes('-ext-')) continue;\n  appViewNodes += `      <node xsi:type=\"Element\" identifier=\"view-node-${fnv1a(comp.id)}\" elementRef=\"${escXml(comp.id)}\" x=\"${x}\" y=\"${y}\" w=\"${nodeWidth}\" h=\"${nodeHeight}\">\n        <style><fillColor r=\"181\" g=\"211\" b=\"231\"/></style>\n      </node>\\n`;\n  x += nodeWidth + gap;\n  if (x > 800) { x = 50; y += nodeHeight + gap; }\n}\n\n// Layer: External\ny += nodeHeight + gap;\nx = 50;\nfor (const comp of (application.components || []).filter(c => c.id.includes('-ext-') || c.layer === 'external')) {\n  appViewNodes += `      <node xsi:type=\"Element\" identifier=\"view-node-${fnv1a(comp.id)}\" elementRef=\"${escXml(comp.id)}\" x=\"${x}\" y=\"${y}\" w=\"${nodeWidth}\" h=\"${nodeHeight}\">\n        <style><fillColor r=\"213\" g=\"213\" b=\"213\"/></style>\n      </node>\\n`;\n  x += nodeWidth + gap;\n}\n\nlet viewsXml = `  <views>\\n    <diagrams>\\n      <view identifier=\"id-view-application\" xsi:type=\"Diagram\">\\n        <name xml:lang=\"en\">Application Architecture</name>\\n${appViewNodes}      </view>\\n    </diagrams>\\n  </views>`;\n\n// STEP 8: Assemble Final ArchiMate 3.0 Exchange Format XML\nlet elementsXml = '  <elements>\\n';\nfor (const el of elements) {\n  elementsXml += `    <element identifier=\"${escXml(el.id)}\" xsi:type=\"${escXml(el.type)}\">\\n      <name xml:lang=\"en\">${escXml(el.name)}</name>\\n    </element>\\n`;\n}\nelementsXml += '  </elements>';\n\nlet relationshipsXml = '  <relationships>\\n';\nfor (const rel of relationships) {\n  relationshipsXml += `    <relationship identifier=\"${escXml(rel.id)}\" source=\"${escXml(rel.source)}\" target=\"${escXml(rel.target)}\" xsi:type=\"${escXml(rel.type)}\"/>\\n`;\n}\nrelationshipsXml += '  </relationships>';\n\nconst modelId = 'id-' + fnv1a(ctx.projectName + '-model');\nconst fullXml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<model xmlns=\"http://www.opengroup.org/xsd/archimate/3.0/\"\n       xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\"\n       xsi:schemaLocation=\"http://www.opengroup.org/xsd/archimate/3.0/ http://www.opengroup.org/xsd/archimate/3.1/archimate3_Diagram.xsd\"\n       identifier=\"${modelId}\">\n  <name xml:lang=\"en\">${escXml(ctx.projectName)}</name>\n  <documentation xml:lang=\"en\">ArchiMate model generated from BRD using doc-to-archimate formula</documentation>\n${elementsXml}\n${relationshipsXml}\n${orgXml}\n${viewsXml}\n</model>`;\n\nreturn [{\n  json: {\n    ...ctx,\n    fullXml,\n    fullXmlHash: fnv1a(fullXml),\n    elementCount: elements.length,\n    relationshipCount: relationships.length\n  }\n}];"
        },
        "id": "convert-archimate",
        "name": "Convert to ArchiMate XML",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          4800,
          304
        ]
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH next_version AS (SELECT COALESCE(MAX(version), 0) + 1 AS v FROM architecture.artifacts WHERE project_id = $1 AND type = 'archimate_xml_full') INSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta) SELECT $1, 'archimate_xml_full', next_version.v, $2::jsonb, $3, $4::jsonb FROM next_version RETURNING id, version;",
          "options": {
            "queryReplacement": "={{ [ $json.projectId, JSON.stringify({ xml: $json.fullXml }), $json.fullXmlHash, JSON.stringify({ jobId: $json.jobId }) ] }}"
          }
        },
        "id": "store-xml",
        "name": "Store ArchiMate XML",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          5040,
          304
        ],
        "credentials": {
          "postgres": {
            "id": "M5eIfNwtZu8y3dOp",
            "name": "Postgres account"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const ctx = $('Convert to ArchiMate XML').first().json;\nconst { businessXml, applicationXml, dataXml, technologyXml, fullXml, projectSlug, jobId } = ctx;\nconst repoDir = '/opt/workspace/software-delivery';\nconst projectDir = repoDir + '/' + projectSlug + '-docs';\nconst orgDir = repoDir + '/org-architecture';\nconst remote = 'git@github.com:shlapolosa/software-delivery.git';\n\n// Escape content for heredoc\nconst safeHeredoc = (content, marker) => content.replace(new RegExp(marker, 'g'), marker + '_ESC');\n\n// Extract element lines from fullXml\nconst elementLines = fullXml.split('\\n').filter(line => line.includes('<element ')).join('\\n');\n\nlet sh = `set -e\nmkdir -p /opt/workspace\n\n# Clone or fetch repo\nif [ ! -d '${repoDir}/.git' ]; then\n  git clone '${remote}' '${repoDir}'\nfi\ncd '${repoDir}'\ngit fetch origin --prune\n\n# ============================================\n# STEP 1: Update org-architecture on main branch\n# ============================================\n# Reset any local changes and checkout main\ngit reset --hard HEAD 2>/dev/null || true\ngit checkout main 2>/dev/null || git checkout -b main origin/main 2>/dev/null || git checkout -b main\ngit reset --hard origin/main 2>/dev/null || true\ngit pull origin main --rebase 2>/dev/null || true\nmkdir -p '${orgDir}'\n\n# Write new project elements to temp file\nNEW_ELEMENTS_FILE='/tmp/new_elements_${jobId}.txt'\nMERGED_FILE='/tmp/merged_${jobId}.archimate'\nORG_FILE='${orgDir}/full.archimate'\n\ncat > \"$NEW_ELEMENTS_FILE\" <<'EOFNEW_${jobId}'\n` + elementLines + `\nEOFNEW_${jobId}\n\n# Merge with existing org-architecture\nif [ -f \"$ORG_FILE\" ] && ! grep -q '<<<<<<' \"$ORG_FILE\" 2>/dev/null; then\n  # Extract existing elements (skip if file has merge conflicts)\n  EXISTING_ELEMENTS=$(grep '<element ' \"$ORG_FILE\" 2>/dev/null || true)\n  \n  # Combine and deduplicate by id attribute (field 4 in quotes)\n  ALL_ELEMENTS=$(cat \"$NEW_ELEMENTS_FILE\"; echo \"$EXISTING_ELEMENTS\")\n  UNIQUE_ELEMENTS=$(echo \"$ALL_ELEMENTS\" | sort -t'\"' -k4,4 -u | grep -v '^$' || true)\nelse\n  UNIQUE_ELEMENTS=$(cat \"$NEW_ELEMENTS_FILE\")\nfi\n\n# Build merged org-architecture file with proper folder structure\ncat > \"$MERGED_FILE\" <<'EOFHDR'\n<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<archimate:model xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:archimate=\"http://www.archimatetool.com/archimate\" name=\"Organization Architecture\" id=\"org-arch-001\">\n  <folder name=\"Business\" type=\"business\">\nEOFHDR\n\n# Filter and write business elements\necho \"$UNIQUE_ELEMENTS\" | grep -E 'Capability|BusinessActor|BusinessProcess|BusinessService' >> \"$MERGED_FILE\" || true\ncat >> \"$MERGED_FILE\" <<'EOFBIZ'\n  </folder>\n  <folder name=\"Application\" type=\"application\">\nEOFBIZ\n\n# Filter and write application elements\necho \"$UNIQUE_ELEMENTS\" | grep -E 'ApplicationComponent|ApplicationInterface|DataObject' >> \"$MERGED_FILE\" || true\ncat >> \"$MERGED_FILE\" <<'EOFAPP'\n  </folder>\n  <folder name=\"Technology\" type=\"technology\">\nEOFAPP\n\n# Filter and write technology elements\necho \"$UNIQUE_ELEMENTS\" | grep -E 'Node|CommunicationNetwork|SystemSoftware|Artifact' >> \"$MERGED_FILE\" || true\ncat >> \"$MERGED_FILE\" <<'EOFTEC'\n  </folder>\n  <folder name=\"Relations\" type=\"relations\">\n  </folder>\n</archimate:model>\nEOFTEC\n\nmv \"$MERGED_FILE\" \"$ORG_FILE\"\nrm -f \"$NEW_ELEMENTS_FILE\"\n\n# Commit and push org-architecture to main with retry logic\ngit add 'org-architecture/full.archimate'\ngit commit -m 'Merge architecture from ${projectSlug} into org-architecture (job ${jobId})' || true\n\n# Retry push up to 3 times with pull --rebase in between\nfor i in 1 2 3; do\n  if git push origin main; then\n    echo \"Successfully pushed to main on attempt $i\"\n    break\n  else\n    echo \"Push failed, pulling and retrying (attempt $i)...\"\n    git pull origin main --rebase || git pull origin main -X theirs\n    git add 'org-architecture/full.archimate'\n    git commit -m 'Merge architecture from ${projectSlug} into org-architecture (job ${jobId}) - retry' || true\n  fi\ndone\n\n# ============================================\n# STEP 2: Update project-specific files on project branch\n# ============================================\ngit checkout -B '${projectSlug}' 'origin/${projectSlug}' 2>/dev/null || git checkout -B '${projectSlug}'\nmkdir -p '${projectDir}/architecture'\n\n`;\n\n// Write project-specific layer files\nsh += \"cat > '\" + projectDir + \"/architecture/business.archimate' <<'EOFBIZ_\" + jobId + \"'\\n\" + safeHeredoc(businessXml, 'EOFBIZ_' + jobId) + \"\\nEOFBIZ_\" + jobId + \"\\n\";\nsh += \"cat > '\" + projectDir + \"/architecture/application.archimate' <<'EOFAPP_\" + jobId + \"'\\n\" + safeHeredoc(applicationXml, 'EOFAPP_' + jobId) + \"\\nEOFAPP_\" + jobId + \"\\n\";\nsh += \"cat > '\" + projectDir + \"/architecture/data.archimate' <<'EOFDAT_\" + jobId + \"'\\n\" + safeHeredoc(dataXml, 'EOFDAT_' + jobId) + \"\\nEOFDAT_\" + jobId + \"\\n\";\nsh += \"cat > '\" + projectDir + \"/architecture/technology.archimate' <<'EOFTEC_\" + jobId + \"'\\n\" + safeHeredoc(technologyXml, 'EOFTEC_' + jobId) + \"\\nEOFTEC_\" + jobId + \"\\n\";\nsh += \"cat > '\" + projectDir + \"/architecture/full.archimate' <<'EOFFULL_\" + jobId + \"'\\n\" + safeHeredoc(fullXml, 'EOFFULL_' + jobId) + \"\\nEOFFULL_\" + jobId + \"\\n\";\n\nsh += `\n# Commit project-specific files to project branch\ngit add '${projectSlug}-docs/architecture'\ngit commit -m 'Add architecture for ${projectSlug} (job ${jobId})' || true\ngit push -u origin '${projectSlug}'\n`;\n\nreturn [{ json: { ...ctx, gitScript: sh } }];"
        },
