      {
        "id": "use-requirements",
        "name": "Use Requirements",
        "type": "n8n-nodes-base.set",
        "typeVersion": 3.4,
        "position": [
          2000,
          404
        ],
        "parameters": {
          "assignments": {
            "assignments": [
              {
                "id": "brdSource",
                "name": "brdSource",
                "type": "string",
                "value": "requirements"
              },
              {
                "id": "requirements",
                "name": "requirements",
                "type": "string",
                "value": "={{ $('Initialize Parameters').first().json.requirements }}"
              }
            ]
          },
