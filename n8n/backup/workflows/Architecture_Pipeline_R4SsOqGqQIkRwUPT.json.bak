    {
      "id": "generate-brd-from-requirements",
      "name": "Generate BRD from Requirements",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2160,
        504
      ],
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Initialize Parameters').first().json.ollamaModel,\n  messages: [\n    {\n      role: 'system',\n      content: 'You are a Business Analyst. Generate a Business Requirements Document (BRD) from the provided requirements. Output ONLY valid JSON matching the schema - no markdown, no code fences.'\n    },\n    { role: 'user', content: $('Use Requirements').first().json.requirements }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['type','title','version','executiveSummary','problemStatement','businessObjectives','stakeholders','scope','constraints','assumptions','successCriteria'],\n    properties: {\n      type: { const: 'brd' },\n      title: { type: 'string' },\n      version: { type: 'string' },\n      executiveSummary: { type: 'string' },\n      problemStatement: {\n        type: 'object',\n        additionalProperties: false,\n        required: ['currentState','painPoints','impact'],\n        properties: {\n          currentState: { type: 'string' },\n          painPoints: { type: 'array', items: { type: 'string' } },\n          impact: { type: 'string' }\n        }\n      },\n      businessObjectives: { type: 'array' },\n      stakeholders: { type: 'array' },\n      scope: { type: 'object' },\n      constraints: { type: 'array' },\n      assumptions: { type: 'array' },\n      successCriteria: { type: 'array' }\n    }\n  },\n  options: {\n    temperature: $('Initialize Parameters').first().json.ollamaTemperature,\n    seed: $('Initialize Parameters').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "parse-generated-brd",
      "name": "Parse Generated BRD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2320,
        504
      ],
      "parameters": {
        "jsCode": "// Parse BRD from Ollama response\nconst response = $json;\nlet brd;\n\ntry {\n  // Ollama returns response in message.content\n  const content = response.message?.content;\n  if (typeof content === 'string') {\n    brd = JSON.parse(content);\n  } else if (typeof content === 'object') {\n    brd = content;\n  } else {\n    throw new Error('Unexpected BRD response format');\n  }\n} catch (e) {\n  // Fallback: wrap requirements as simple BRD structure\n  const requirements = $('Use Requirements').first().json.requirements;\n  brd = {\n    type: 'brd',\n    title: 'Generated from Requirements',\n    version: '1.0',\n    executiveSummary: requirements.substring(0, 500),\n    problemStatement: {\n      currentState: 'Requirements provided directly',\n      painPoints: ['Requirements need to be analyzed'],\n      impact: 'Architecture generation from raw requirements'\n    },\n    businessObjectives: [{ objective: 'Implement requirements', priority: 'high' }],\n    stakeholders: [],\n    scope: { inScope: [requirements], outOfScope: [] },\n    constraints: [],\n    assumptions: [],\n    successCriteria: []\n  };\n}\n\nreturn [{ json: { brdSource: 'generated', brdFromGenerated: brd } }];"
      }
    },
