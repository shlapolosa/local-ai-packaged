      {
        "parameters": {
          "jsCode": "// Build Azure DevOps push payload\nconst ctx = $(\"Build Git Script\").first().json;\nconst repoInfo = $(\"Get Azure Repo Info\").first().json;\nconst branchCheck = $(\"Check Azure Branch\").first().json;\nconst fileCheck = $json;\nconst projectSlug = ctx.projectSlug;\nconst jobId = ctx.jobId;\n\nconst artifactContent = ctx.artifactContent || ctx.artifactMarkdown || ctx.content || \"\";\nconst artifactPath = \"/docs/artifact.md\";\nconst branchName = `refs/heads/${projectSlug}`;\n\nlet oldObjectId = \"0000000000000000000000000000000000000000\";\nlet changeType = \"add\";\n\n// Check if branch exists\nif (branchCheck.value && branchCheck.value.length > 0) {\n  oldObjectId = branchCheck.value[0].objectId;\n}\n\n// Check if file exists (statusCode 200 = exists, 404 = doesn't exist)\nconst fileExists = fileCheck.statusCode === 200;\nif (fileExists) {\n  changeType = \"edit\";\n} else {\n  changeType = \"add\";\n}\n\nconst changes = [{\n  changeType: changeType,\n  item: { path: `/${projectSlug}-docs${artifactPath}` },\n  newContent: {\n    content: Buffer.from(artifactContent).toString(\"base64\"),\n    contentType: \"base64encoded\"\n  }\n}];\n\nreturn [{\n  json: {\n    ...ctx,\n    azurePushPayload: {\n      refUpdates: [{ name: branchName, oldObjectId: oldObjectId }],\n      commits: [{ comment: `Add artifacts for ${projectSlug} (job ${jobId})`, changes: changes }]\n    },\n    azureRepoInfo: repoInfo,\n    branchExists: branchCheck.value && branchCheck.value.length > 0,\n    fileExists: fileExists,\n    changeType: changeType\n  }\n}];"
        },
        "id": "build-azure-payload-2d8ae4d2",
        "name": "Build Azure Push Payload",
