      {
        "id": "merge-paths",
        "name": "Merge Project Paths",
        "type": "n8n-nodes-base.merge",
        "typeVersion": 3,
        "position": [
          1320,
          404
        ],
        "parameters": {
          "mode": "chooseBranch",
          "output": "input1"
        }
