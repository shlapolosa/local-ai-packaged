    {
      "parameters": {
        "method": "POST",
        "url": "http://ollama:11434/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Initialize Parameters').first().json.ollamaModel,\n  messages: [\n    { role: 'system', content: 'You are a Data Architect. Output JSON with dataEntities, dataFlows, databases, and relationships. Include: 1) Internal relationships between dataEntities/databases/dataFlows (use AssociationRelationship, FlowRelationship, CompositionRelationship). 2) Cross-layer relationships from dataEntities to application dataObjects (use AccessRelationship - application accesses data). Each relationship must have: source (element name), target (element name), type (ArchiMate relationship type).' },\n    { role: 'user', content: 'BRD: ' + JSON.stringify($('Collect BRD').first().json.brd).slice(0,6000) + '\\nAPP_ARCH: ' + JSON.stringify($('Validate Application Arch').first().json.applicationArch).slice(0,8000) }\n  ],\n  stream: false,\n  format: { type: 'object', required: ['dataEntities','dataFlows','databases','relationships'], properties: { dataEntities: { type: 'array' }, dataFlows: { type: 'array' }, databases: { type: 'array' }, relationships: { type: 'array', items: { type: 'object', properties: { source: { type: 'string' }, target: { type: 'string' }, type: { type: 'string' }, layer: { type: 'string' } }, required: ['source', 'target', 'type'] } } } },\n  options: { temperature: $('Initialize Parameters').first().json.ollamaTemperature, seed: $('Initialize Parameters').first().json.ollamaSeed }\n} }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "gen-data",
      "name": "Generate Data Architecture",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        3360,
        304
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Validate Data Architecture (legacy support - data objects now in Application layer)\nconst raw = $json.message?.content;\nlet arch;\ntry {\n  arch = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { valid: false, error: 'Failed to parse LLM response', dataArch: null, dataRelationships: [] } }];\n}\n\nconst errors = [];\nconst fnv1a = (s) => { let h = 0x811c9dc5; for (let i = 0; i < (s||'').length; i++) { h ^= s.charCodeAt(i); h = (h * 0x01000193) >>> 0; } return ('0000000' + h.toString(16)).slice(-8); };\n\n// Validate elements have basic required fields\nconst validateElement = (el, elemType) => {\n  if (!el) return;\n  if (!el.id && !el.name) errors.push(`data.${elemType}: element has no id or name`);\n};\n\n// Validate Data entities\nfor (const ent of (arch.dataEntities || [])) validateElement(ent, 'dataEntity');\nfor (const db of (arch.databases || [])) validateElement(db, 'database');\nfor (const flow of (arch.dataFlows || [])) validateElement(flow, 'dataFlow');\n\n// Process relationships\nconst relationships = (arch.relationships || []).map(r => ({\n  ...r,\n  sourceLayer: 'data',\n  targetLayer: r.layer || 'data'\n}));\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors: errors.slice(0, 10),\n    dataArch: arch,\n    dataRelationships: relationships,\n    dataArchHash: fnv1a(JSON.stringify(arch))\n  }\n}];"
      },
      "id": "val-data",
      "name": "Validate Data Arch",
      "type": "n8n-nodes-base.code",
