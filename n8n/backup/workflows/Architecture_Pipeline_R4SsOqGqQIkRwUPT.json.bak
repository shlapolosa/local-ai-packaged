      {
        "id": "ensure-project-output",
        "name": "Ensure Project Output",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          520,
          304
        ],
        "parameters": {
          "jsCode": "const projectItems = $input.all();\nconst firstItem = projectItems[0]?.json || {};\nconst hasProject = Object.keys(firstItem).length > 0 && firstItem.id;\n\nif (hasProject) {\n  return projectItems.map(item => ({\n    json: {\n      ...item.json,\n      projectExists: true,\n      projectData: item.json\n    }\n  }));\n} else {\n  const initParams = $('Initialize Parameters').first()?.json || {};\n  return [{\n    json: {\n      projectExists: false,\n      projectSlug: initParams.projectSlug || 'direct-requirements',\n      requirements: initParams.requirements || '',\n      jobId: 'direct-' + Date.now()\n    }\n  }];\n}"
        }
      },
      {
        "id": "respond-direct-ack",
        "name": "Respond: Direct Requirements Ack",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          720,
          504
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ status: 'processing', message: 'Generating architecture from direct requirements', jobId: $json.jobId || 'direct-' + Date.now() }) }}"
        }
      },
      {
        "id": "create-project",
        "name": "Create Project",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          640,
          504
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO architecture.projects (slug, name, created_at, updated_at) VALUES ($1, $2, NOW(), NOW()) ON CONFLICT (slug) DO UPDATE SET updated_at = NOW() RETURNING id, slug, name;",
          "options": {
            "queryReplacement": "={{ [ $json.projectSlug, $json.projectSlug ] }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "M5eIfNwtZu8y3dOp",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "prepare-project-context",
        "name": "Prepare Project Context",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          800,
          504
        ],
        "parameters": {
          "jsCode": "// Prepare context for newly created project\nconst project = $json;\nconst initParams = $('Initialize Parameters').first().json;\n\nreturn [{\n  json: {\n    id: project.id,\n    slug: project.slug,\n    name: project.name || initParams.projectName || project.slug,\n    projectId: project.id,\n    projectSlug: project.slug,\n    projectName: project.name || initParams.projectName || project.slug,\n    requirements: initParams.requirements,\n    isNewProject: true\n  }\n}];"
        }
      }
    ],
