        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are repairing a PRD markdown document to comply with the RPG Method template.',\n        'Return ONLY JSON {\"markdown\": \"...\"} matching the schema, no extra keys.',\n        'Keep existing content, but you MUST add/repair missing RPG structure.',\n        'CRITICAL: Ensure the PRD contains and populates QA-related sections:',\n        '- ## Coverage Requirements (derive from TEST_STRATEGY_MD coverage targets)',\n        '- ## Critical Test Scenarios (derive from TEST_SCENARIOS_MD)',\n        'Do NOT remove existing content; insert or expand sections in-place.',\n        'Do NOT include <instruction> tags.',\n        'You MAY use markdown fences only where appropriate for repo tree/test pyramid.',\n        'First line must remain \"# PRD: <Project Name>\".'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'VALIDATION_ERRORS: ' + JSON.stringify($json.errors || []),\n        'ORIGINAL_PRD_MD:',\n        ($json.prdMarkdown || '').slice(0, 14000),\n        '',\n        'TEST_STRATEGY_MD:',\n        String(($('Validate QA Package').first().json.testStrategyMarkdown || '')).slice(0, 9000),\n        '',\n        'TEST_SCENARIOS_MD:',\n        String(($('Validate QA Package').first().json.testScenariosMarkdown || '')).slice(0, 9000)\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['markdown'],\n    properties: { markdown: { type: 'string' } }\n  },\n  options: {\n    temperature: 0,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
