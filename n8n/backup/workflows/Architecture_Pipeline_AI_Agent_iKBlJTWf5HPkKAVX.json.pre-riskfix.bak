    {
      "id": "security-note",
      "name": "Security Architect Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        9248,
        336
      ],
      "parameters": {
        "content": "## Phase 5: Security Architect (Risk Assessment)\nGenerates markdown risk assessment and stores in DB.",
        "height": 100,
        "width": 360,
        "color": 3
      }
    },
    {
      "id": "gen-risk",
      "name": "Generate Risk Assessment (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        9248,
        512
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are a Security Architect producing a project risk assessment.',\n        'Output ONLY markdown content (no JSON, no code fences), but you MUST wrap it into the JSON schema field when using tool-format.',\n        'First character of the markdown must be # and the first line must start with: \"# Risk Assessment:\"',\n        'No preamble text.',\n        'Use the provided architecture artifacts as sources and cite them in each risk as: Source: <artifactType>.',\n        'Focus on realistic security/availability/compliance risks for this system and architecture.',\n        'Include specific mitigations, owners, and monitoring indicators.',\n        'Prefer deterministic, concrete items; avoid generic filler.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT_NAME: ' + $('Apply Classification + Slugify').first().json.projectName,\n        'PROJECT_SLUG: ' + $('Apply Classification + Slugify').first().json.projectSlug,\n        'JOB_ID: ' + ($('Initialize Parameters').first().json.jobId || ''),\n        '',\n        'BRD: ' + JSON.stringify($('Validate BRD').first().json.brd).slice(0, 6000),\n        '',\n        'BUSINESS_ARCH: ' + JSON.stringify($('Validate Business Architecture').first().json.businessArch).slice(0, 6000),\n        '',\n        'APPLICATION_ARCH: ' + JSON.stringify($('Validate Application Architecture').first().json.applicationArch).slice(0, 6000),\n        '',\n        'DATA_ARCH: ' + JSON.stringify($('Validate Data Architecture').first().json.dataArch).slice(0, 6000),\n        '',\n        'INFRA_ARCH: ' + JSON.stringify($('Validate Infrastructure Architecture').first().json.infraArch).slice(0, 6000)\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['markdown'],\n    properties: {\n      markdown: { type: 'string' }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "val-risk",
      "name": "Validate Risk Markdown",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        9488,
        512
      ],
      "parameters": {
        "jsCode": "const raw = $json.message?.content;\nlet parsed;\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { valid: false, errors: ['Risk assessment parse failed: ' + e.message], markdown: '' } }];\n}\n\nconst md = String(parsed?.markdown || '');\nconst errors = [];\nif (!md.startsWith('#')) errors.push('Markdown must start with #');\nif (!md.startsWith('# Risk Assessment:')) errors.push('First line must start with \"# Risk Assessment:\"');\nif (md.includes('```')) errors.push('Must not include fenced code blocks');\n\n// FNV-1a hash\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nreturn [{ json: { ...$json, valid: errors.length === 0, errors, riskMarkdown: md, riskMarkdownHash: fnv1a(md) } }];"
      }
    },
    {
      "id": "store-risk",
      "name": "Store Risk Assessment Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        9728,
        512
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'risk_assessment_md'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'risk_assessment_md', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify({ markdown: $json.riskMarkdown }), $json.riskMarkdownHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'security_architect', model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature }) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "solution-note",
      "name": "Solution Architect Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        9968,
        336
      ],
      "parameters": {
        "content": "## Phase 6: Solution Architect\nProduces public API + integration artifacts.\n- Always: solution_arch_md\n- Optional (based on decision): openapi_yaml, asyncapi_yaml, sql_schema_sql, cloudevents_md, avro_schemas_json",
        "height": 120,
        "width": 420,
        "color": 5
      }
    },
    {
      "id": "gen-solution",
      "name": "Generate Solution Package (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        9968,
        512
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are a Solution Architect.',\n        'You produce public-facing integration artifacts for an APIM front door.',\n        '',\n        'You MUST choose integrationStyle for THIS solution: rest_only | events_only | hybrid.',\n        'You MUST ALWAYS produce solutionMarkdown and (if rest_only or hybrid) openapiYaml and sqlSchemaSql.',\n        'If you choose events_only or hybrid, you MUST produce asyncapiYaml, cloudEventsMarkdown, and avroSchemasJson.',\n        '',\n        'Do not invent services that do not exist in application_arch.',\n        'Public API only (no internal APIs).',\n        'Ensure endpoints and events map back to application_arch components and brd use-cases.',\n        '',\n        'ABSOLUTE FORMATTING RULES:',\n        '- Return ONLY JSON that matches the schema (no extra keys).',\n        '- Do NOT include ``` anywhere in any string fields.',\n        '- solutionMarkdown: raw markdown, first line starts exactly with \"# Solution Architecture:\"',\n        '- openapiYaml: OpenAPI 3.0 YAML string, no code fences.',\n        '- asyncapiYaml: AsyncAPI 2.x YAML string, no code fences.',\n        '- sqlSchemaSql: SQL DDL string, no code fences.',\n        '- cloudEventsMarkdown: markdown, no code fences.',\n        '- avroSchemasJson: JSON object of AVSC schemas (objects), keyed by event name.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT_NAME: ' + $('Apply Classification + Slugify').first().json.projectName,\n        'PROJECT_SLUG: ' + $('Apply Classification + Slugify').first().json.projectSlug,\n        'JOB_ID: ' + ($('Initialize Parameters').first().json.jobId || ''),\n        '',\n        'BRD: ' + JSON.stringify($('Validate BRD').first().json.brd).slice(0, 7000),\n        '',\n        'APPLICATION_ARCH: ' + JSON.stringify($('Validate Application Architecture').first().json.applicationArch).slice(0, 7000),\n        '',\n        'DATA_ARCH: ' + JSON.stringify($('Validate Data Architecture').first().json.dataArch).slice(0, 7000),\n        '',\n        'INFRA_ARCH: ' + JSON.stringify($('Validate Infrastructure Architecture').first().json.infraArch).slice(0, 7000),\n        '',\n        'RISK_ASSESSMENT_MD: ' + String($('Validate Risk Markdown').first().json.riskMarkdown || '').slice(0, 7000)\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['integrationStyle','solutionMarkdown','openapiYaml','sqlSchemaSql','asyncapiYaml','cloudEventsMarkdown','avroSchemasJson'],\n    properties: {\n      integrationStyle: { type: 'string', enum: ['rest_only','events_only','hybrid'] },\n      solutionMarkdown: { type: 'string' },\n      openapiYaml: { type: ['string','null'] },\n      sqlSchemaSql: { type: ['string','null'] },\n      asyncapiYaml: { type: ['string','null'] },\n      cloudEventsMarkdown: { type: ['string','null'] },\n      avroSchemasJson: { type: ['object','null'] }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "val-solution",
      "name": "Validate Solution Package",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10208,
        512
      ],
      "parameters": {
        "jsCode": "const raw = $json.message?.content;\nlet parsed;\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { valid: false, errors: ['Solution package parse failed: ' + e.message] } }];\n}\n\nconst errors = [];\nconst style = String(parsed?.integrationStyle || '');\nconst md = String(parsed?.solutionMarkdown || '');\nconst openapi = parsed?.openapiYaml ?? null;\nconst asyncapi = parsed?.asyncapiYaml ?? null;\nconst sql = parsed?.sqlSchemaSql ?? null;\nconst ce = parsed?.cloudEventsMarkdown ?? null;\nconst avro = parsed?.avroSchemasJson ?? null;\n\nif (!['rest_only','events_only','hybrid'].includes(style)) errors.push('integrationStyle invalid');\nif (!md.startsWith('# Solution Architecture:')) errors.push('solutionMarkdown first line must start with \"# Solution Architecture:\"');\nif (md.includes('```')) errors.push('solutionMarkdown must not include code fences');\n\nconst hasOpenApi = typeof openapi === 'string' && openapi.trim().length > 0;\nconst hasAsyncApi = typeof asyncapi === 'string' && asyncapi.trim().length > 0;\nconst hasSql = typeof sql === 'string' && sql.trim().length > 0;\nconst hasCe = typeof ce === 'string' && ce.trim().length > 0;\nconst hasAvro = avro && typeof avro === 'object' && !Array.isArray(avro) && Object.keys(avro).length > 0;\n\nif (style === 'rest_only' && !hasOpenApi) errors.push('rest_only requires openapiYaml');\nif (style === 'events_only' && !hasAsyncApi) errors.push('events_only requires asyncapiYaml');\nif (style === 'events_only' && !hasCe) errors.push('events_only requires cloudEventsMarkdown');\nif (style === 'events_only' && !hasAvro) errors.push('events_only requires avroSchemasJson');\nif (style === 'hybrid' && !(hasOpenApi || hasAsyncApi)) errors.push('hybrid requires at least one of openapiYaml or asyncapiYaml');\n\nconst forbidFence = (s, label) => {\n  if (typeof s === 'string' && s.includes('```')) errors.push(label + ' must not include code fences');\n};\nforbidFence(openapi, 'openapiYaml');\nforbidFence(asyncapi, 'asyncapiYaml');\nforbidFence(sql, 'sqlSchemaSql');\nforbidFence(ce, 'cloudEventsMarkdown');\n\n// FNV-1a hash (32-bit) => 8 hex\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    integrationStyle: style,\n    solutionMarkdown: md,\n    openapiYaml: hasOpenApi ? openapi : null,\n    asyncapiYaml: hasAsyncApi ? asyncapi : null,\n    sqlSchemaSql: hasSql ? sql : null,\n    cloudEventsMarkdown: hasCe ? ce : null,\n    avroSchemasJson: hasAvro ? avro : null,\n    hashes: {\n      solution_arch_md: fnv1a(md),\n      openapi_yaml: hasOpenApi ? fnv1a(openapi) : null,\n      asyncapi_yaml: hasAsyncApi ? fnv1a(asyncapi) : null,\n      sql_schema_sql: hasSql ? fnv1a(sql) : null,\n      cloudevents_md: hasCe ? fnv1a(ce) : null,\n      avro_schemas_json: hasAvro ? fnv1a(JSON.stringify(avro)) : null,\n    }\n  }\n}];"
      }
    },
    {
      "id": "explode-solution",
      "name": "Explode Solution Artifacts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10448,
        512
      ],
      "parameters": {
        "jsCode": "// Turn validated package into multiple items for DB insert\nconst j = $json;\n\nif (!j.valid) {\n  // Return zero items so downstream store node is skipped\n  return [];\n}\n\nconst jobId = $('Initialize Parameters').first().json.jobId;\nconst model = $('Run Config').first().json.ollamaModel;\nconst seed = $('Run Config').first().json.ollamaSeed;\nconst temperature = $('Run Config').first().json.ollamaTemperature;\n\nconst metaBase = {\n  jobId,\n  stage: 'solution_architect',\n  model,\n  seed,\n  temperature,\n  integrationStyle: j.integrationStyle,\n};\n\nconst out = [];\n\nout.push({\n  json: {\n    artifactType: 'solution_arch_md',\n    content: { markdown: j.solutionMarkdown },\n    contentHash: j.hashes.solution_arch_md,\n    meta: metaBase,\n  }\n});\n\nif (j.openapiYaml) out.push({ json: { artifactType: 'openapi_yaml', content: { yaml: j.openapiYaml }, contentHash: j.hashes.openapi_yaml, meta: metaBase } });\nif (j.asyncapiYaml) out.push({ json: { artifactType: 'asyncapi_yaml', content: { yaml: j.asyncapiYaml }, contentHash: j.hashes.asyncapi_yaml, meta: metaBase } });\nif (j.sqlSchemaSql) out.push({ json: { artifactType: 'sql_schema_sql', content: { sql: j.sqlSchemaSql }, contentHash: j.hashes.sql_schema_sql, meta: metaBase } });\nif (j.cloudEventsMarkdown) out.push({ json: { artifactType: 'cloudevents_md', content: { markdown: j.cloudEventsMarkdown }, contentHash: j.hashes.cloudevents_md, meta: metaBase } });\nif (j.avroSchemasJson) out.push({ json: { artifactType: 'avro_schemas_json', content: { schemas: j.avroSchemasJson }, contentHash: j.hashes.avro_schemas_json, meta: metaBase } });\n\nreturn out;"
      }
    },
    {
      "id": "store-solution",
      "name": "Store Solution Artifact(s)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        10688,
