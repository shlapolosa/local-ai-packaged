        -48,
        128
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"{{ $('Run Config').first().json.ollamaModel }}\",\n  \"format\": \"json\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an intent classifier for an architecture pipeline. Output ONLY JSON.\\n\\nReturn: {\\\\\"intent\\\\\":\\\\\"create_project|update_project|regenerate_from_stage\\\\\",\\\\\"proposedProjectName\\\\\":string,\\\\\"startAt\\\\\":\\\\\"business_analyst|business_architect\\\\\",\\\\\"confidence\\\\\":number,\\\\\"notes\\\\\":string}.\\n\\nRules:\\n- If user provided startAt, use it.\\n- If no startAt, default to business_analyst unless the user clearly requests business architecture only.\\n- If projectName not provided, propose a short name.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"text={{ $('Initialize Parameters').first().json.text }}\\nprojectName={{ $('Initialize Parameters').first().json.projectName }}\\nstartAt={{ $('Initialize Parameters').first().json.startAt }}\"\n    }\n  ],\n  \"stream\": false,\n  \"options\": {\n    \"num_ctx\": 16384, \"temperature\": {{ $('Run Config').first().json.ollamaTemperature }},\n    \"seed\": {{ $('Run Config').first().json.ollamaSeed }}\n  }\n}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "7fca9f84-b7f2-4609-93af-682411ebc292",
      "name": "Classify Intent (Ollama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        304
      ],
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const init = $('Initialize Parameters').first().json;\nconst classified = $json.message?.content ? JSON.parse($json.message.content) : {};\n\nconst projectName = (init.projectName && init.projectName.trim()) ? init.projectName.trim() : (classified.proposedProjectName || 'architecture-project');\nconst startAt = (init.startAt && init.startAt.trim()) ? init.startAt.trim() : (classified.startAt || 'business_analyst');\n\nconst slugify = (s) => String(s || '')\n  .toLowerCase()\n  .trim()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-+|-+$/g, '')\n  .replace(/--+/g, '-');\n\nconst projectSlug = slugify(projectName) || 'architecture-project';\n\n// Non-crypto stable hash (FNV-1a 32-bit)\nconst fnv1a = (str) => {\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    hash ^= str.charCodeAt(i);\n    hash = (hash * 0x01000193) >>> 0;\n  }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst requestHash = fnv1a(String(init.text || ''));\n\nreturn [{\n  json: {\n    ...init,\n    intent: classified.intent || 'create_project',\n    confidence: classified.confidence ?? null,\n    notes: classified.notes || null,\n    projectName,\n    projectSlug,\n    startAt,\n    runConfig: $('Run Config').first().json,\n    requestHash,\n  }\n}];"
      },
      "id": "07f878eb-8ebe-4afd-9908-403a34ee33ab",
      "name": "Apply Classification + Slugify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE SCHEMA IF NOT EXISTS architecture;\n\nCREATE TABLE IF NOT EXISTS architecture.projects (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  slug text UNIQUE NOT NULL,\n  name text,\n  created_at timestamptz DEFAULT now(),\n  updated_at timestamptz DEFAULT now()\n);\n\nCREATE TABLE IF NOT EXISTS architecture.artifacts (\n  id uuid PRIMARY KEY DEFAULT gen_random_uuid(),\n  project_id uuid NOT NULL REFERENCES architecture.projects(id),\n  type text NOT NULL,\n  version int NOT NULL,\n  content jsonb NOT NULL,\n  content_hash text NOT NULL,\n  meta jsonb NOT NULL DEFAULT '{}'::jsonb,\n  created_at timestamptz DEFAULT now()\n);\n\nCREATE INDEX IF NOT EXISTS artifacts_project_type_version_idx ON architecture.artifacts(project_id, type, version DESC);",
        "options": {}
      },
      "id": "f0ad5120-1342-47d5-adec-b778bf000449",
      "name": "Ensure DB Schema",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        704,
        128
      ],
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      },
      "continueOnFail": false
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO architecture.projects (slug, name, updated_at)\nVALUES ($1, $2, now())\nON CONFLICT (slug) DO UPDATE SET name = EXCLUDED.name, updated_at = now()\nRETURNING id, slug, name;",
        "options": {
          "queryReplacement": "={{ [ $json.projectSlug, $json.projectName ] }}"
        }
      },
      "id": "7a066ccb-99e7-4163-85ee-be26e84fe7ab",
      "name": "Upsert Project",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        704,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT content, version, content_hash, created_at\nFROM architecture.artifacts\nWHERE project_id = $1 AND type = 'brd'\nORDER BY version DESC\nLIMIT 1;",
        "options": {
          "queryReplacement": "={{ [ $json.id ] }}"
        }
      },
      "id": "b0810fac-157f-43d8-8016-98441984c6bb",
      "name": "Load Latest BRD",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        944,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 4,
        "output": "={{ (() => { const s = $('Apply Classification + Slugify').first().json.startAt; if (s === 'infrastructure_architect') return 3; if (s === 'data_architect') return 2; if (s === 'business_architect') return 1; return 0; })() }}",
        "options": {}
      },
      "id": "638b0e6a-73c3-415b-9611-33feb44459ec",
      "name": "StartAt Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1184,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    { role: 'system', content: 'You are a Business Analyst. Output ONLY JSON that matches the schema. No markdown.' },\n    { role: 'user', content: $('Apply Classification + Slugify').first().json.text }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['type','title','version','executiveSummary','problemStatement','businessObjectives','stakeholders','scope','constraints','assumptions','successCriteria'],\n    properties: {\n      type: { const: 'brd' },\n      title: { type: 'string' },\n      version: { type: 'string' },\n      executiveSummary: { type: 'string' },\n      problemStatement: {\n        type: 'object',\n        additionalProperties: false,\n        required: ['currentState','painPoints','impact'],\n        properties: {\n          currentState: { type: 'string' },\n          painPoints: { type: 'array', items: { type: 'string' } },\n          impact: { type: 'string' }\n        }\n      },\n      businessObjectives: { type: 'array' },\n      stakeholders: { type: 'array' },\n      scope: { type: 'object' },\n      constraints: { type: 'array' },\n      assumptions: { type: 'array' },\n      successCriteria: { type: 'array' }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "9e836322-af37-4dec-a317-d16cccb80191",
      "name": "Generate BRD (Llama HTTP)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1664,
        304
      ],
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Basic BRD validation without external modules\nconst raw = $json.message?.content;\nlet brd;\ntry {\n  brd = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { ...$json, valid: false, errors: ['BRD JSON parse failed: ' + e.message], brd: null } }];\n}\n\nconst errors = [];\nif (brd?.type !== 'brd') errors.push('type must be brd');\nif (!brd?.title) errors.push('title is required');\nif (!brd?.executiveSummary) errors.push('executiveSummary is required');\nif (!brd?.problemStatement) errors.push('problemStatement is required');\nif (!Array.isArray(brd?.businessObjectives)) errors.push('businessObjectives must be array');\nif (!Array.isArray(brd?.stakeholders)) errors.push('stakeholders must be array');\nif (!brd?.scope) errors.push('scope is required');\n\n// Non-crypto hash (FNV-1a)\nconst fnv1a = (input) => {\n  const str = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    hash ^= str.charCodeAt(i);\n    hash = (hash * 0x01000193) >>> 0;\n  }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst valid = errors.length === 0;\nconst brdHash = fnv1a(JSON.stringify(brd));\n\nreturn [{ json: { ...$json, valid, errors, brd, brdHash } }];"
      },
      "id": "0f3fd4c0-49bc-44ac-9cd8-bdd37cc2fb8e",
      "name": "Validate BRD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'brd'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'brd', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify($json.brd), $json.brdHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature }) ] }}"
        }
      },
      "id": "36e27cd1-6d30-4727-9134-4fdd20fb45e1",
      "name": "Store BRD Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        2144,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mode": "load",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "capability-maps"
        },
        "prompt": "=healthcare capabilities relevant to this project: {{ JSON.stringify($('Validate BRD').first().json.brd).substring(0, 600) }}",
        "topK": "={{ $('Run Config').first().json.qdrantTopK }}",
        "options": {}
      },
      "id": "e2bb7059-fff7-4a2c-85c1-575c3f336ac5",
      "name": "Qdrant Search (Capabilities) v2",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        2384,
        304
      ],
      "credentials": {
        "qdrantApi": {
          "id": "dh1JSfFyrr9rh7Xr",
          "name": "QdrantApi account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Normalize Qdrant docs into deterministic candidate list with stable ids\nconst items = $input.all();\n\nconst normalizeId = (doc) => {\n  const md = doc.metadata || {};\n  const mdId = md.id || md.path || md.l4 || md.l3 || md.l2 || md.l1;\n  if (mdId) return String(mdId);\n  const firstLine = String(doc.pageContent || '').split('\\n')[0].trim();\n  if (firstLine) return firstLine;\n  return String(doc.pageContent || '').slice(0, 80);\n};\n\nconst candidates = items\n  .map(i => i.json.document)\n  .filter(Boolean)\n  .map((d) => ({\n    id: normalizeId(d),\n    text: d.pageContent,\n    metadata: d.metadata || {},\n    score: typeof d.score === 'number' ? d.score : null,\n  }));\n\ncandidates.sort((a,b) => {\n  const sa = (a.score ?? -1);\n  const sb = (b.score ?? -1);\n  if (sb !== sa) return sb - sa;\n  return String(a.id).localeCompare(String(b.id));\n});\n\nreturn [{ json: { ...$('Validate BRD').first().json, capabilityCandidates: candidates } }];"
      },
      "id": "6a8c008b-f445-4725-a661-40bb0cf7b6a3",
      "name": "Aggregate Capability Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2624,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'Select capabilities relevant to the project.',\n        'Return selection by INDEX into the candidates array (0-based).',\n        'Return integer indexes only.',\n        'Prefer recall over precision (include borderline-relevant capabilities).',\n        'Output ONLY JSON.'\n      ].join('\\n')\n    },\n    {\n      role: 'user',\n      content: 'PROJECT: ' + $('Apply Classification + Slugify').first().json.text +\n        '\\n\\nCANDIDATES (index, preview): ' +\n        JSON.stringify(( $('Aggregate Capability Candidates').first().json.capabilityCandidates || [] ).map((c, idx) => ({ idx, preview: (c.text || '').slice(0, 140) }))).slice(0, 6000)\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['selected'],\n    properties: {\n      selected: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['index','relevanceScore','reason'],\n          properties: {\n            index: { type: 'integer', minimum: 0 },\n            relevanceScore: { type: 'number' },\n            reason: { type: 'string' }\n          }\n        }\n      }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "091189a0-110a-40b0-afc8-196fbe3125e5",
      "name": "Select Relevant Capabilities (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        2864,
        304
      ],
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const threshold = $('Run Config').first().json.capabilityRelevanceThreshold;\nconst candidates = $('Aggregate Capability Candidates').first().json.capabilityCandidates || [];\n\nconst selectionRaw = $json.message?.content;\nlet selection;\ntry { selection = typeof selectionRaw === 'string' ? JSON.parse(selectionRaw) : selectionRaw; }\ncatch (e) { selection = { selected: [] }; }\n\nconst picked = new Set();\nconst selected = [];\nfor (const s of (selection.selected || [])) {\n  const idx = s?.index;\n  if (typeof idx !== 'number') continue;\n  if ((s.relevanceScore ?? 0) < threshold) continue;\n  if (picked.has(idx)) continue;\n\n  const c = candidates[idx];\n  if (!c) continue;\n\n  picked.add(idx);\n  selected.push(c);\n}\n\nconst capabilityContext = selected.map(s => s.text).join('\\n\\n');\n\nreturn [{\n  json: {\n    ...$('Aggregate Capability Candidates').first().json,\n    selectedCapabilities: selected,\n    capabilityContext,\n    capabilitySelection: selection\n  }\n}];"
      },
      "id": "3edbee22-0c84-41ef-9930-65ac9378319d",
      "name": "Build Capability Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3104,
        304
      ]
    },
    {
      "parameters": {
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are a Business Architect.',\n        'Generate an architecture model as JSON with elements and relationships.',\n        'Coverage: represent each key BRD scope item as at least one element.',\n        'Output ONLY JSON. Relationships must reference existing element ids.',\n        'Use stable kebab-case ids.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT: ' + $('Apply Classification + Slugify').first().json.text,\n        'BRD_EXEC_SUMMARY: ' + String((($('Validate BRD').first().json.brd || {}).executiveSummary) || '').slice(0, 800),\n        'BRD_SCOPE_KEYS: ' + JSON.stringify(Object.keys((($('Validate BRD').first().json.brd || {}).scope || {}))),\n        'CAPABILITY_PREVIEWS: ' + JSON.stringify((($('Build Capability Context').first().json.capabilityCandidates || [])).slice(0, 10).map((c, idx) => ({ idx, id: c.id, preview: (c.text || '').slice(0, 120) })))\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['name','layer','elements','relationships'],\n    properties: {\n      name: { type: 'string' },\n      layer: { type: 'string' },\n      elements: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['id','type','name'],\n          properties: {\n            id: { type: 'string' },\n            type: { type: 'string' },\n            name: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      },\n      relationships: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['type','source','target'],\n          properties: {\n            type: { type: 'string' },\n            source: { type: 'string' },\n            target: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "e0b81ed5-f83e-4848-9e1e-13c7fff2c43f",
      "name": "Generate Business Architecture (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        3344,
        304
      ],
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Validate Business Architecture without external modules\nlet model;\ntry { model = JSON.parse($json.message.content); }\ncatch (e) {\n  return [{ json: { ...$json, valid: false, errors: ['Business arch parse failed: ' + e.message], businessArch: null } }];\n}\n\nconst errors = [];\nif (!model?.name) errors.push('name is required');\nif (!model?.layer) errors.push('layer is required');\nif (!Array.isArray(model?.elements)) errors.push('elements must be array');\nif (!Array.isArray(model?.relationships)) errors.push('relationships must be array');\n\nconst elementIds = new Set((model.elements || []).map(e => e.id));\nfor (const rel of (model.relationships || [])) {\n  if (!elementIds.has(rel.source)) errors.push(`Relationship source not found: ${rel.source}`);\n  if (!elementIds.has(rel.target)) errors.push(`Relationship target not found: ${rel.target}`);\n}\n\nconst fnv1a = (str) => {\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < str.length; i++) {\n    hash ^= str.charCodeAt(i);\n    hash = (hash * 0x01000193) >>> 0;\n  }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst valid = errors.length === 0;\nconst businessArchHash = fnv1a(JSON.stringify(model));\n\nreturn [{ json: { ...$('Build Capability Context').first().json, valid, errors, businessArch: model, businessArchHash } }];"
      },
      "id": "fc58c01d-8126-49ac-bd9d-0040b490be5d",
      "name": "Validate Business Architecture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3584,
        304
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'business_arch'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'business_arch', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify($json.businessArch), $json.businessArchHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature, capabilitySelection: $('Build Capability Context').first().json.capabilitySelection }) ] }}"
        }
      },
      "id": "a4bedef5-f738-401f-a1b2-7dccab9da97e",
      "name": "Store Business Arch Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        3824,
        304
      ],
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Business-only deterministic ArchiMate XML (single output item)\nconst inputItems = $input.all();\nconst item = (inputItems[0] && inputItems[0].json) ? inputItems[0].json : {};\n\nconst projectSlug = item.projectSlug || $('Apply Classification + Slugify').first().json.projectSlug;\nconst model = item.businessArch;\n\nif (!model || !Array.isArray(model.elements) || !Array.isArray(model.relationships)) {\n  return [{ json: { ...item, archimateXml: '', elementCount: 0, relationshipCount: 0, xmlError: 'Missing or invalid businessArch for XML conversion' } }];\n}\n\nconst escapeXml = (t) => String(t ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;')\n  .replace(/'/g, '&apos;');\n\n// FNV-1a 32-bit, no explicit returns (validator workaround)\nconst fnv1a32 = (str) => String(str ?? '')\n  .split('')\n  .reduce((hash, ch) => (((hash ^ ch.charCodeAt(0)) * 0x01000193) >>> 0), 0x811c9dc5);\n\nconst stableId = (s) => ('000000000000' + fnv1a32(String(s)).toString(16)).slice(-12);\n\nconst mapElementType = (t) => {\n  const s = String(t || '').toLowerCase();\n  const result = s.includes('capability') ? 'Capability'\n    : (s.includes('actor') || s.includes('user') || s.includes('person')) ? 'BusinessActor'\n    : (s.includes('businessservice') || s.includes('business service')) ? 'BusinessService'\n    : 'BusinessProcess';\n  return result;\n};\n\nconst mapRelType = (kind, typeHint) => {\n  const hint = String(typeHint || '').toLowerCase();\n  const typeMap = {\n    bizapp: 'RealizationRelationship',\n    appdata: 'AccessRelationship',\n    bizdata: 'AccessRelationship',\n    datastore: 'AssignmentRelationship',\n    appinfra: 'ServingRelationship'\n  };\n  let result = typeMap[kind];\n  if (!result) {\n    if (kind === 'infra') {\n      result = (hint.includes('compose') || hint.includes('contain')) ? 'CompositionRelationship'\n        : (hint.includes('deploy') || hint.includes('assign')) ? 'AssignmentRelationship'\n        : (hint.includes('serve') || hint.includes('provide')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'biz') {\n      result = (hint.includes('trigger') || hint.includes('flow')) ? 'TriggeringRelationship'\n        : (hint.includes('serve') || hint.includes('support')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'app') {\n      result = (hint.includes('flow') || hint.includes('call')) ? 'FlowRelationship'\n        : (hint.includes('serve') || hint.includes('use')) ? 'ServingRelationship'\n        : hint.includes('access') ? 'AccessRelationship'\n        : 'AssociationRelationship';\n    } else {\n      result = 'AssociationRelationship';\n    }\n  }\n  return result;\n};\n\nconst elementXmlId = (el) => 'e-' + stableId(projectSlug + ':business_arch:' + el.id);\nconst relXmlId = (rel) => 'r-' + stableId(projectSlug + ':' + rel.type + ':' + rel.source + '->' + rel.target);\n\nconst elements = [...model.elements].sort((a, b) => String(a.id).localeCompare(String(b.id)));\nconst relationships = [...model.relationships].sort((a, b) => (String(a.type) + '|' + a.source + '|' + a.target).localeCompare(String(b.type) + '|' + b.source + '|' + b.target));\n\nconst elementIdMap = {};\nfor (const el of elements) elementIdMap[el.id] = elementXmlId(el);\n\nconst modelId = 'm-' + stableId(projectSlug + ':model:business');\nconst folderId = 'f-' + stableId(projectSlug + ':folder:business-elements');\nconst relFolderId = 'f-' + stableId(projectSlug + ':folder:business-relations');\n\nlet xml = '<?xml version=\"1.0\" encoding=\"UTF-8\"?>\\n' +\n  '<archimate:model xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:archimate=\"http://www.archimatetool.com/archimate\" name=\"' + escapeXml(model.name || 'Business Model') + '\" id=\"' + modelId + '\" version=\"5.0.0\">\\n';\n\nxml += '  <folder name=\"Business\" id=\"' + folderId + '\" type=\"elements\">\\n';\nfor (const el of elements) {\n  xml += '    <element xsi:type=\"archimate:' + mapElementType(el.type) + '\" name=\"' + escapeXml(el.name) + '\" id=\"' + elementIdMap[el.id] + '\"/>\\n';\n}\nxml += '  </folder>\\n';\n\nlet relCount = 0;\nxml += '  <folder name=\"Relations\" id=\"' + relFolderId + '\" type=\"relations\">\\n';\nfor (const rel of relationships) {\n  const sid = elementIdMap[rel.source];\n  const tid = elementIdMap[rel.target];\n  if (!sid || !tid) continue;\n  xml += '    <element xsi:type=\"archimate:' + mapRelType(rel.type) + '\" id=\"' + relXmlId(rel) + '\" source=\"' + sid + '\" target=\"' + tid + '\"/>\\n';\n  relCount++;\n}\nxml += '  </folder>\\n</archimate:model>';\n\nreturn [{ json: { ...item, archimateXml: xml, elementCount: elements.length, relationshipCount: relCount } }];"
      },
      "id": "c8cd3413-16ff-445e-8d5f-9c4f655f15b7",
      "name": "Convert to ArchiMate XML (Deterministic)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4064,
        304
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
