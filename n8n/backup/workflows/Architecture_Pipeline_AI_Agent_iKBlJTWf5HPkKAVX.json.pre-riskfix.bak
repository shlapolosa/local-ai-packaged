    {
      "id": "b9e7151f-8711-4ed8-9f9f-c89c12376ec7",
      "name": "Generate Data Architecture (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        5904,
        512
      ],
      "parameters": {
        "url": "https://ollama.com/api/chat",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are a Data Architect creating a data architecture model.',\n        'CRITICAL: You MUST use the provided BUSINESS_IDS and APPLICATION_IDS to create relationships.',\n        '',\n        'Rules:',\n        '1. Create DataObjects representing core data entities',\n        '2. Create Stores (databases, caches) where data is persisted',\n        '3. Create relationships using EXACT IDs from BUSINESS_IDS and APPLICATION_IDS:',\n        '   - business->data: set businessSourceId from BUSINESS_IDS, dataTargetId from your dataObjects',\n        '   - app->data: set applicationSourceId from APPLICATION_IDS, dataTargetId from your dataObjects',\n        '   - data->store: set dataObjectId from your dataObjects, storeId from your stores',\n        '',\n        'Output ONLY valid JSON. Use provided IDs exactly.'\n      ].join('\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT: ' + $('Apply Classification + Slugify').first().json.projectName,\n        'BRD_EXEC_SUMMARY: ' + String((($('Validate BRD').first().json.brd || {}).executiveSummary) || '').slice(0, 800),\n        'BUSINESS_IDS: ' + JSON.stringify((($('Validate Business Architecture').first().json.businessArch || {}).elements || []).map(e => e.id)),\n        'APPLICATION_IDS: ' + JSON.stringify((($('Validate Application Architecture').first().json.applicationArch || {}).elements || []).map(e => e.id))\n      ].join('\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['name','layer','dataObjects','stores','relationships'],\n    properties: {\n      name: { type: 'string' },\n      layer: { const: 'Data' },\n      dataObjects: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['id','name','type'],\n          properties: {\n            id: { type: 'string' },\n            name: { type: 'string' },\n            type: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      },\n      stores: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['id','name','type'],\n          properties: {\n            id: { type: 'string' },\n            name: { type: 'string' },\n            type: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      },\n      relationships: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['type'],\n          properties: {\n            type: { type: 'string' },\n            businessSourceId: { type: 'string' },\n            applicationSourceId: { type: 'string' },\n            dataTargetId: { type: 'string' },\n            dataObjectId: { type: 'string' },\n            storeId: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "c21298ae-9862-4a57-9052-f21d3777ddb1",
      "name": "Validate Data Architecture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6144,
        512
      ],
      "parameters": {
        "jsCode": "let model;\ntry { model = JSON.parse($json.message.content); } catch (e) {\n  return [{ json: { valid: false, errors: ['Data arch parse failed: ' + e.message], dataArch: null } }];\n}\n\nconst errors = [];\nif (model.layer !== 'Data') errors.push('layer must be Data');\nif (!Array.isArray(model.dataObjects)) errors.push('dataObjects must be array');\nif (!Array.isArray(model.stores)) errors.push('stores must be array');\nif (!Array.isArray(model.relationships)) errors.push('relationships must be array');\n\nconst dataIds = new Set((model.dataObjects || []).map(d => d.id));\nconst storeIds = new Set((model.stores || []).map(s => s.id));\n\nconst appIds = new Set((($('Validate Application Architecture').first().json.applicationArch || {}).elements || []).map(e => e.id));\nconst bizEls = (($('Validate Business Architecture').first().json.businessArch || {}).elements || []);\nconst bizIds = new Set(bizEls.map(e => e.id));\n\nlet hasDataStore = false;\nlet businessDataEdges = 0;\n\nfor (const rel of (model.relationships || [])) {\n  const t = String(rel.type || '').toLowerCase();\n\n  // business -> data required\n  if (rel.businessSourceId) {\n    if (!rel.dataTargetId) {\n      errors.push('Business->Data relationship must include dataTargetId');\n    } else {\n      if (!bizIds.has(rel.businessSourceId)) errors.push(`businessSourceId not found: ${rel.businessSourceId}`);\n      if (!dataIds.has(rel.dataTargetId)) errors.push(`dataTargetId not found: ${rel.dataTargetId}`);\n      businessDataEdges++;\n      if (!t.includes('access') && !t.includes('read') && !t.includes('use')) errors.push(`Business->Data type should indicate access, got: ${rel.type}`);\n    }\n  }\n\n  // optional app -> data\n  if (rel.applicationSourceId) {\n    if (!rel.dataTargetId) {\n      errors.push('App->Data relationship must include dataTargetId');\n    } else {\n      if (!appIds.has(rel.applicationSourceId)) errors.push(`applicationSourceId not found: ${rel.applicationSourceId}`);\n      if (!dataIds.has(rel.dataTargetId)) errors.push(`dataTargetId not found: ${rel.dataTargetId}`);\n    }\n  }\n\n  // data -> store required\n  if (rel.dataObjectId || rel.storeId) {\n    if (!rel.dataObjectId || !rel.storeId) {\n      errors.push('Data->Store relationship must include dataObjectId and storeId');\n    } else {\n      hasDataStore = true;\n      if (!dataIds.has(rel.dataObjectId)) errors.push(`dataObjectId not found: ${rel.dataObjectId}`);\n      if (!storeIds.has(rel.storeId)) errors.push(`storeId not found: ${rel.storeId}`);\n      if (!t.includes('stored')) errors.push(`Data->Store type should be storedIn, got: ${rel.type}`);\n    }\n  }\n}\n\nif (!hasDataStore) errors.push('Missing at least one dataObjectId->storeId storedIn relationship');\nif (businessDataEdges === 0) errors.push('Missing required Business->Data access relationships');\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst valid = errors.length === 0;\nconst dataArchHash = fnv1a(JSON.stringify(model));\n\nreturn [{ json: { ...$('Validate Application Architecture').first().json, valid, errors, dataArch: model, dataArchHash } }];"
      }
    },
    {
      "id": "fbbce172-45f2-45fa-b2ca-ce61b1507191",
      "name": "Store Data Arch Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        6384,
        512
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'data_arch'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'data_arch', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify($json.dataArch), $json.dataArchHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'data_architect', model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature }) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "15f540b4-7823-4535-9ae0-fc141aaf4c9e",
      "name": "Convert to ArchiMate XML (Biz+App+Data)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6624,
        512
      ],
      "parameters": {
        "jsCode": "// Combined Biz + App + Data ArchiMate XML (single output item)\nconst item = ($input.all()[0] && $input.all()[0].json) ? $input.all()[0].json : {};\nconst projectSlug = item.projectSlug || $('Apply Classification + Slugify').first().json.projectSlug;\nconst biz = item.businessArch || $('Validate Business Architecture').first().json.businessArch;\nconst app = item.applicationArch || $('Validate Application Architecture').first().json.applicationArch;\nconst data = item.dataArch || $('Validate Data Architecture').first().json.dataArch;\n\nif (!biz || !app || !data) return [{ json: { ...item, archimateXml: '', xmlError: 'Missing business/application/data model(s)' } }];\n\nconst escapeXml = (t) => String(t ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\\\"/g,'&quot;').replace(/'/g,'&apos;');\nconst fnv1a32 = (str) => String(str ?? '').split('').reduce((h, ch) => (((h ^ ch.charCodeAt(0)) * 0x01000193) >>> 0), 0x811c9dc5);\nconst stableId = (s) => ('000000000000' + fnv1a32(String(s)).toString(16)).slice(-12);\n\nconst mapBizType = (t) => (String(t||'').toLowerCase().includes('capability') ? 'Capability' : 'BusinessProcess');\nconst mapAppType = (t,id) => ((String(id||'').includes('client') || String(t||'').toLowerCase().includes('client')) ? 'ApplicationComponent' : 'ApplicationComponent');\nconst mapDataType = () => 'DataObject';\nconst mapStoreType = (t) => (String(t||'').toLowerCase().includes('postgres') || String(t||'').toLowerCase().includes('mongo') ? 'Artifact' : 'Artifact');\nconst mapRelType = (kind, typeHint) => {\n  const hint = String(typeHint || '').toLowerCase();\n  const typeMap = {\n    bizapp: 'RealizationRelationship',\n    appdata: 'AccessRelationship',\n    bizdata: 'AccessRelationship',\n    datastore: 'AssignmentRelationship',\n    appinfra: 'ServingRelationship'\n  };\n  let result = typeMap[kind];\n  if (!result) {\n    if (kind === 'infra') {\n      result = (hint.includes('compose') || hint.includes('contain')) ? 'CompositionRelationship'\n        : (hint.includes('deploy') || hint.includes('assign')) ? 'AssignmentRelationship'\n        : (hint.includes('serve') || hint.includes('provide')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'biz') {\n      result = (hint.includes('trigger') || hint.includes('flow')) ? 'TriggeringRelationship'\n        : (hint.includes('serve') || hint.includes('support')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'app') {\n      result = (hint.includes('flow') || hint.includes('call')) ? 'FlowRelationship'\n        : (hint.includes('serve') || hint.includes('use')) ? 'ServingRelationship'\n        : hint.includes('access') ? 'AccessRelationship'\n        : 'AssociationRelationship';\n    } else {\n      result = 'AssociationRelationship';\n    }\n  }\n  return result;\n};\n\nconst bizEls = [...(biz.elements||[])].sort((a,b)=>String(a.id).localeCompare(String(b.id)));\nconst appEls = [...(app.elements||[])].sort((a,b)=>String(a.id).localeCompare(String(b.id)));\nconst dataObjs = [...(data.dataObjects||[])].sort((a,b)=>String(a.id).localeCompare(String(b.id)));\nconst stores = [...(data.stores||[])].sort((a,b)=>String(a.id).localeCompare(String(b.id)));\n\nconst bizId = {}; for (const e of bizEls) bizId[e.id] = 'e-' + stableId(projectSlug+':biz:'+e.id);\nconst appId = {}; for (const e of appEls) appId[e.id] = 'e-' + stableId(projectSlug+':app:'+e.id);\nconst dataId = {}; for (const d of dataObjs) dataId[d.id] = 'e-' + stableId(projectSlug+':data:'+d.id);\nconst storeId = {}; for (const s of stores) storeId[s.id] = 'e-' + stableId(projectSlug+':store:'+s.id);\n\nconst rels = [];\nfor (const r of (biz.relationships||[])) rels.push({ kind:'biz', type:r.type, s:r.source, t:r.target });\nfor (const r of (app.relationships||[])) rels.push({ kind:'app', type:r.type, s:r.source, t:r.target });\nfor (const r of (app.crossLayerRelationships||[])) rels.push({ kind:'bizapp', type:r.type, s:r.businessSourceId, t:r.applicationTargetId });\nfor (const r of (data.relationships||[])) {\n  if (r.businessSourceId && r.dataTargetId) rels.push({ kind:'bizdata', type:r.type, s:r.businessSourceId, t:r.dataTargetId });\n  if (r.applicationSourceId && r.dataTargetId) rels.push({ kind:'appdata', type:r.type, s:r.applicationSourceId, t:r.dataTargetId });\n  if (r.dataObjectId && r.storeId) rels.push({ kind:'datastore', type:r.type, s:r.dataObjectId, t:r.storeId });\n}\nrels.sort((a,b)=>(a.kind+'|'+a.type+'|'+a.s+'|'+a.t).localeCompare(a.kind+'|'+b.type+'|'+b.s+'|'+b.t));\n\nconst modelId = 'm-' + stableId(projectSlug+':model:biz+app+data');\nconst fBiz = 'f-' + stableId(projectSlug+':folder:biz');\nconst fApp = 'f-' + stableId(projectSlug+':folder:app');\nconst fData = 'f-' + stableId(projectSlug+':folder:data');\nconst fStore = 'f-' + stableId(projectSlug+':folder:stores');\nconst fRel = 'f-' + stableId(projectSlug+':folder:relations');\n\nlet xml = '<?xml version=\"1.0\" encoding=\"UTF-8\"?>\\n' +\n  '<archimate:model xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:archimate=\"http://www.archimatetool.com/archimate\" name=\"' + escapeXml(projectSlug + ' Architecture') + '\" id=\"' + modelId + '\" version=\"5.0.0\">\\n';\n\nxml += '  <folder name=\"Business\" id=\"' + fBiz + '\" type=\"elements\">\\n';\nfor (const e of bizEls) xml += '    <element xsi:type=\"archimate:' + mapBizType(e.type) + '\" name=\"' + escapeXml(e.name) + '\" id=\"' + bizId[e.id] + '\"/>\\n';\nxml += '  </folder>\\n';\n\nxml += '  <folder name=\"Application\" id=\"' + fApp + '\" type=\"elements\">\\n';\nfor (const e of appEls) xml += '    <element xsi:type=\"archimate:' + mapAppType(e.type,e.id) + '\" name=\"' + escapeXml(e.name) + '\" id=\"' + appId[e.id] + '\"/>\\n';\nxml += '  </folder>\\n';\n\nxml += '  <folder name=\"Data\" id=\"' + fData + '\" type=\"elements\">\\n';\nfor (const d of dataObjs) xml += '    <element xsi:type=\"archimate:' + mapDataType() + '\" name=\"' + escapeXml(d.name) + '\" id=\"' + dataId[d.id] + '\"/>\\n';\nxml += '  </folder>\\n';\n\nxml += '  <folder name=\"Data Stores\" id=\"' + fStore + '\" type=\"elements\">\\n';\nfor (const s of stores) xml += '    <element xsi:type=\"archimate:' + mapStoreType(s.type) + '\" name=\"' + escapeXml(s.name) + '\" id=\"' + storeId[s.id] + '\"/>\\n';\nxml += '  </folder>\\n';\n\nlet relCount = 0;\nxml += '  <folder name=\"Relations\" id=\"' + fRel + '\" type=\"relations\">\\n';\nfor (const r of rels) {\n  let sid = null; let tid = null;\n  if (r.kind === 'biz') { sid = bizId[r.s]; tid = bizId[r.t]; }\n  else if (r.kind === 'app') { sid = appId[r.s]; tid = appId[r.t]; }\n  else if (r.kind === 'bizapp') { sid = bizId[r.s]; tid = appId[r.t]; }\n  else if (r.kind === 'bizdata') { sid = bizId[r.s]; tid = dataId[r.t]; }\n  else if (r.kind === 'appdata') { sid = appId[r.s]; tid = dataId[r.t]; }\n  else if (r.kind === 'datastore') { sid = dataId[r.s]; tid = storeId[r.t]; }\n  if (!sid || !tid) continue;\n  const rid = 'r-' + stableId(projectSlug+':'+r.kind+':'+r.type+':'+r.s+'->'+r.t);\n  xml += '    <element xsi:type=\"archimate:' + mapRelType(r.kind, r.type) + '\" id=\"' + rid + '\" source=\"' + sid + '\" target=\"' + tid + '\"/>\\n';\n  relCount++;\n}\nxml += '  </folder>\\n</archimate:model>';\n\nreturn [{ json: { ...item, archimateXml: xml, relationshipCount: relCount } }];"
      }
    },
    {
      "id": "2b30a54b-dad8-4d08-92c5-5a786b11e631",
      "name": "Hash Biz+App+Data XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6864,
        512
      ],
      "parameters": {
        "jsCode": "const fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\nreturn [{ json: { ...$json, archimateXmlHash: fnv1a($json.archimateXml) } }];"
      }
    },
    {
      "id": "b6ba491c-fa72-4f21-b5fd-b876826132e5",
      "name": "Store Biz+App+Data XML Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        7104,
        512
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'archimate_xml_business_application_data'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'archimate_xml_business_application_data', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify({ xml: $json.archimateXml }), $json.archimateXmlHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'data_architect', model: $('Run Config').first().json.ollamaModel }) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "82e0efcf-3018-42d8-b5ba-92cff4a5e495",
      "name": "Reload Data Arch For XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6528,
        512
      ],
      "parameters": {
        "jsCode": "// Store Data Arch Artifact returns only {id, version}. Reattach the in-flight dataArch.\nreturn [{ json: { ...$json, dataArch: $('Validate Data Architecture').first().json.dataArch } }];"
      }
    },
    {
      "id": "f2b71a5c-1124-412a-9ff9-b0ffe5e9e456",
      "name": "After Data Stage",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        7344,
        512
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition-after-data",
              "leftValue": "={{ true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
