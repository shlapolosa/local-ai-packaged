      ],
      "parameters": {
        "jsCode": "// Prefer in-flight businessArch, fallback to DB insert output (no businessArch)\nif ($json.businessArch) return [{ json: $json }];\nreturn [{ json: { ...$json, businessArch: $('Validate Business Architecture').first().json.businessArch } }];"
      }
    },
    {
      "id": "248993f4-48f0-43be-8439-7776d19dab0e",
      "name": "Repair Business Architecture (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        3584,
        512
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You repair a Business Architecture JSON model.',\n        'Input may have relationship source/target IDs that do not exist in elements.',\n        'Fix by either: (a) changing relationship source/target to existing element ids, or (b) adding missing elements.',\n        'Return ONLY corrected JSON matching the same schema.',\n        'Do not introduce medication/formulary unless project requires it.'\n      ].join('\\n')\n    },\n    {\n      role: 'user',\n      content: 'PROJECT: ' + $('Apply Classification + Slugify').first().json.text +\n        '\\n\\nVALIDATION_ERRORS: ' + JSON.stringify($json.errors || []) +\n        '\\n\\nBUSINESS_ARCH_JSON: ' + JSON.stringify($json.businessArch)\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['name','layer','elements','relationships'],\n    properties: {\n      name: { type: 'string' },\n      layer: { type: 'string' },\n      elements: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['id','type','name'],\n          properties: {\n            id: { type: 'string' },\n            type: { type: 'string' },\n            name: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      },\n      relationships: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['type','source','target'],\n          properties: {\n            type: { type: 'string' },\n            source: { type: 'string' },\n            target: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
