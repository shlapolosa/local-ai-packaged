        656
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = $2\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, $2, next_version.v, $3::jsonb, $4, $5::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, $json.artifactType, JSON.stringify($json.content), $json.contentHash, JSON.stringify($json.meta) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      },
      "retryOnFail": true,
      "maxTries": 3
    },
    {
      "id": "qa-valid-router",
      "name": "QA Valid?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        11680,
        656
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 2,
        "output": "={{ $json.valid === true ? 0 : 1 }}"
      }
    },
    {
      "id": "repair-qa",
      "name": "Repair QA Package (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        11920,
        752
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are repairing a QA Package JSON.',\n        'Return ONLY JSON matching the schema, no extra keys.',\n        'Fix validation issues while keeping semantics.',\n        'Rules:',\n        '- testStrategyMarkdown must start with \"# Test Strategy:\"',\n        '- testScenariosMarkdown must start with \"# Test Scenarios:\"',\n        '- No ``` fences anywhere.',\n        '- Ensure test pyramid ratios sum to 100% and stay within: Unit 60-70, Integration 20-30, E2E 10-20.',\n        '- Ensure coverage targets include line 80%, branch 75%, critical paths 100%.',\n        '- Ensure critical scenarios include auth (OIDC/JWKS), tenant isolation, order/inventory flows, and events if present.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'VALIDATION_ERRORS: ' + JSON.stringify($json.errors || []),\n        'ORIGINAL_QA_PACKAGE: ' + JSON.stringify({\n          testStrategyMarkdown: $json.testStrategyMarkdown,\n          testScenariosMarkdown: $json.testScenariosMarkdown\n        }).slice(0, 14000)\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['testStrategyMarkdown','testScenariosMarkdown'],\n    properties: {\n      testStrategyMarkdown: { type: 'string' },\n      testScenariosMarkdown: { type: 'string' }\n    }\n  },\n  options: {\n    temperature: 0,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "val-qa-repair",
      "name": "Validate Repaired QA",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        12160,
        752
      ],
      "parameters": {
        "jsCode": "const raw = $json.message?.content;\nlet parsed;\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { valid: false, errors: ['QA package parse failed: ' + e.message] } }];\n}\n\nconst errors = [];\nconst ts = String(parsed?.testStrategyMarkdown || '');\nconst sc = String(parsed?.testScenariosMarkdown || '');\n\nif (!ts.startsWith('# Test Strategy:')) errors.push('testStrategyMarkdown must start with \"# Test Strategy:\"');\nif (!sc.startsWith('# Test Scenarios:')) errors.push('testScenariosMarkdown must start with \"# Test Scenarios:\"');\nif (ts.includes('```') || sc.includes('```')) errors.push('No markdown code fences allowed');\n\n// lightweight checks to reduce bad outputs\nif (!(ts.includes('Unit') && ts.includes('Integration') && ts.includes('E2E'))) {\n  errors.push('testStrategyMarkdown must include Unit/Integration/E2E test pyramid');\n}\nconst tsLower = ts.toLowerCase();\nif (!(ts.includes('80%') && ts.includes('75%') && tsLower.includes('critical'))) {\n  errors.push('testStrategyMarkdown must include coverage targets (80%, 75%, critical paths)');\n}\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    testStrategyMarkdown: ts,\n    testScenariosMarkdown: sc,\n    hashes: {\n      test_strategy_md: fnv1a(ts),\n      test_scenarios_md: fnv1a(sc),\n    }\n  }\n}];"
      }
    },
