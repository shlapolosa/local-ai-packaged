    {
      "id": "533b354f-da60-4feb-9d0e-5dae1fba117e",
      "name": "Repair Infrastructure Architecture (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        8064,
        672
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You repair an Infrastructure Architecture JSON model.',\n        'Fix these issues based on validation errors:',\n        '- Ensure infra relationships use infra ids only.',\n        '- Ensure crossLayerRelationships use application ids -> infra ids.',\n        '- Ensure required components exist: aks, agic, apim, external_idp, event_hubs, dapr, postgres, mongodb.',\n        '- Ensure auth flow links exist: web-client->apim, mobile-client->apim, apim->external_idp JWKS validation.',\n        'Return ONLY corrected JSON matching the schema.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'VALIDATION_ERRORS: ' + JSON.stringify($json.errors || []),\n        'APPLICATION_ELEMENT_IDS: ' + JSON.stringify((($('Validate Application Architecture').first().json.applicationArch || {}).elements || []).map(e => e.id)),\n        'CURRENT_INFRA_JSON: ' + JSON.stringify($json.infraArch || {})\n      ].join('\\\\n\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['name','layer','clusters','platformServices','runtimeComponents','dataPlatforms','relationships','crossLayerRelationships'],\n    properties: {\n      name: { type: 'string' },\n      layer: { const: 'Technology' },\n      clusters: { type: 'array' },\n      platformServices: { type: 'array' },\n      runtimeComponents: { type: 'array' },\n      dataPlatforms: { type: 'array' },\n      relationships: { type: 'array' },\n      crossLayerRelationships: { type: 'array' }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "b2f12aba-f334-4d3c-ac1a-9a5f33848645",
      "name": "Validate Repaired Infra Arch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8304,
        672
      ],
      "parameters": {
        "jsCode": "let model;\ntry { model = JSON.parse($json.message.content); } catch (e) {\n  return [{ json: { valid: false, errors: ['Infra repair parse failed: ' + e.message], infraArch: null } }];\n}\n\n// Reuse same checks by calling Validate Infrastructure Architecture logic inline\nconst errors = [];\nif (model.layer !== 'Technology') errors.push('layer must be Technology');\n\nconst infraIds = new Set([\n  ...(model.clusters || []).map(x => x.id),\n  ...(model.platformServices || []).map(x => x.id),\n  ...(model.runtimeComponents || []).map(x => x.id),\n  ...(model.dataPlatforms || []).map(x => x.id),\n]);\n\nconst hasType = (arr, type) => (arr || []).some(x => String(x.type).toLowerCase() === type);\nif (!hasType(model.clusters, 'aks')) errors.push('Missing AKS cluster');\nif (!hasType(model.runtimeComponents, 'agic')) errors.push('Missing AGIC');\nif (!hasType(model.platformServices, 'apim')) errors.push('Missing APIM');\nif (!hasType(model.platformServices, 'external_idp')) errors.push('Missing external IdP');\nif (!hasType(model.platformServices, 'event_hubs')) errors.push('Missing Event Hubs');\nif (!hasType(model.runtimeComponents, 'dapr')) errors.push('Missing Dapr');\nif (!hasType(model.dataPlatforms, 'postgres')) errors.push('Missing Postgres');\nif (!hasType(model.dataPlatforms, 'mongodb')) errors.push('Missing MongoDB');\n\nconst appIds = new Set((($('Validate Application Architecture').first().json.applicationArch || {}).elements || []).map(e => e.id));\n\nfor (const rel of (model.relationships || [])) {\n  if (!infraIds.has(rel.sourceId)) errors.push(`Infra relationship sourceId invalid: ${rel.sourceId}`);\n  if (!infraIds.has(rel.targetId)) errors.push(`Infra relationship targetId invalid: ${rel.targetId}`);\n}\nfor (const rel of (model.crossLayerRelationships || [])) {\n  if (!appIds.has(rel.applicationSourceId)) errors.push(`crossLayer applicationSourceId invalid: ${rel.applicationSourceId}`);\n  if (!infraIds.has(rel.infraTargetId)) errors.push(`crossLayer infraTargetId invalid: ${rel.infraTargetId}`);\n}\n\nconst apim = (model.platformServices || []).find(x => String(x.type).toLowerCase() === 'apim');\nconst idp = (model.platformServices || []).find(x => String(x.type).toLowerCase() === 'external_idp');\nif (apim && idp) {\n  const hasJwks = (model.relationships || []).some(r => r.sourceId === apim.id && r.targetId === idp.id && /jwks|validate/i.test(String(r.type)));\n  if (!hasJwks) errors.push('Missing apim->idp JWKS relationship');\n}\nconst hasClientLink = (clientId) => (model.crossLayerRelationships || []).some(r => r.applicationSourceId === clientId && apim && r.infraTargetId === apim.id);\nif (!hasClientLink('web-client')) errors.push('Missing web-client->apim');\nif (!hasClientLink('mobile-client')) errors.push('Missing mobile-client->apim');\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst valid = errors.length === 0;\nconst infraArchHash = fnv1a(JSON.stringify(model));\n\nreturn [{ json: { ...$('Validate Data Architecture').first().json, valid, errors, infraArch: model, infraArchHash, repaired: true } }];"
      }
    },
    {
      "id": "respond-ack",
      "name": "Respond Ack",
