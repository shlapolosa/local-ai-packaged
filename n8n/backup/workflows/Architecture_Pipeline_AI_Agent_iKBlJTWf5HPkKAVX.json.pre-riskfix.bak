    {
      "id": "8b5973a7-8b29-499e-b722-1c2193c69363",
      "name": "Generate Application Architecture (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        3984,
        512
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are an Application Architect.',\n        'Output ONLY JSON matching the schema.',\n        'Include Web Client and Mobile Client as first-class application components.',\n        'Include API boundary elements (Backend API / BFF) as needed.',\n        'crossLayerRelationships must link BUSINESS_ARCH element ids to application element ids (businessSourceId -> applicationTargetId).',\n        'relationships must be only between application element ids.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT: ' + $('Apply Classification + Slugify').first().json.projectName,\n        'BRD_EXEC_SUMMARY: ' + String((($('Validate BRD').first().json.brd || {}).executiveSummary) || '').slice(0, 800),\n        'BUSINESS_ARCH_ELEMENT_IDS: ' + JSON.stringify((($('Validate Business Architecture').first().json.businessArch || {}).elements || []).map(e => e.id)),\n        'BUSINESS_ARCH_SUMMARY: ' + JSON.stringify((($('Validate Business Architecture').first().json.businessArch || {}).elements || []).map(e => ({ id: e.id, type: e.type, name: e.name }))).slice(0, 4000)\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['name','layer','elements','relationships','crossLayerRelationships'],\n    properties: {\n      name: { type: 'string' },\n      layer: { const: 'Application' },\n      elements: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['id','type','name'],\n          properties: {\n            id: { type: 'string' },\n            type: { type: 'string' },\n            name: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      },\n      relationships: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['type','source','target'],\n          properties: {\n            type: { type: 'string' },\n            source: { type: 'string' },\n            target: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      },\n      crossLayerRelationships: {\n        type: 'array',\n        items: {\n          type: 'object',\n          additionalProperties: false,\n          required: ['type','businessSourceId','applicationTargetId'],\n          properties: {\n            type: { type: 'string' },\n            businessSourceId: { type: 'string' },\n            applicationTargetId: { type: 'string' },\n            description: { type: 'string' }\n          }\n        }\n      }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "67c58af5-ab41-4e7f-a1fe-fc5217a30314",
      "name": "Validate Application Architecture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4224,
        512
      ],
      "parameters": {
        "jsCode": "let model;\ntry { model = JSON.parse($json.message.content); }\ncatch (e) {\n  return [{ json: { valid: false, errors: ['Application arch parse failed: ' + e.message], applicationArch: null } }];\n}\n\nconst errors = [];\nif (model.layer !== 'Application') errors.push('layer must be Application');\nif (!Array.isArray(model.elements)) errors.push('elements must be array');\nif (!Array.isArray(model.relationships)) errors.push('relationships must be array');\nif (!Array.isArray(model.crossLayerRelationships)) errors.push('crossLayerRelationships must be array');\n\nconst appIds = new Set((model.elements || []).map(e => e.id));\nfor (const rel of (model.relationships || [])) {\n  if (!appIds.has(rel.source)) errors.push(`App relationship source not found: ${rel.source}`);\n  if (!appIds.has(rel.target)) errors.push(`App relationship target not found: ${rel.target}`);\n}\n\nconst businessArch = $('Validate Business Architecture').first().json.businessArch;\nconst bizIds = new Set((businessArch?.elements || []).map(e => e.id));\nfor (const rel of (model.crossLayerRelationships || [])) {\n  if (!bizIds.has(rel.businessSourceId)) errors.push(`Cross-layer businessSourceId not found: ${rel.businessSourceId}`);\n  if (!appIds.has(rel.applicationTargetId)) errors.push(`Cross-layer applicationTargetId not found: ${rel.applicationTargetId}`);\n}\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) {\n    hash ^= s.charCodeAt(i);\n    hash = (hash * 0x01000193) >>> 0;\n  }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst valid = errors.length === 0;\nconst applicationArchHash = fnv1a(JSON.stringify(model));\n\nreturn [{ json: { ...$('Validate Business Architecture').first().json, valid, errors, applicationArch: model, applicationArchHash } }];"
      }
    },
    {
      "id": "695ee2ac-06ae-49c6-a6a4-0aa18757d6bd",
      "name": "Store Application Arch Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        4464,
        512
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'application_arch'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'application_arch', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify($json.applicationArch), $json.applicationArchHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'application_architect', model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature }) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "83b0d411-bab9-4611-83fe-deb2103f0a44",
      "name": "Convert to ArchiMate XML (Business+App)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4704,
        512
      ],
      "parameters": {
        "jsCode": "// Combined Business + Application ArchiMate XML (single output item)\nconst all = $input.all();\nconst item = (all[0] && all[0].json) ? all[0].json : {};\nconst projectSlug = item.projectSlug || $('Apply Classification + Slugify').first().json.projectSlug;\nconst biz = item.businessArch || $('Validate Business Architecture').first().json.businessArch;\nconst app = item.applicationArch || $('Validate Application Architecture').first().json.applicationArch;\n\nif (!biz || !app) {\n  return [{ json: { ...item, archimateXml: '', xmlError: 'Missing businessArch or applicationArch' } }];\n}\n\nconst escapeXml = (t) => String(t ?? '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;')\n  .replace(/\\\"/g, '&quot;')\n  .replace(/'/g, '&apos;');\n\nconst fnv1a32 = (str) => String(str ?? '').split('').reduce((h, ch) => (((h ^ ch.charCodeAt(0)) * 0x01000193) >>> 0), 0x811c9dc5);\nconst stableId = (s) => ('000000000000' + fnv1a32(String(s)).toString(16)).slice(-12);\n\nconst mapBizType = (t) => {\n  const s = String(t || '').toLowerCase();\n  const result = s.includes('capability') ? 'Capability'\n    : (s.includes('actor') || s.includes('user') || s.includes('person')) ? 'BusinessActor'\n    : (s.includes('businessservice') || s.includes('business service')) ? 'BusinessService'\n    : 'BusinessProcess';\n  return result;\n};\n\nconst mapAppType = (t, id) => {\n  const s = String(t || '').toLowerCase();\n  const sid = String(id || '').toLowerCase();\n  return (sid.includes('web-client') || sid.includes('mobile-client') || s.includes('client')) ? 'ApplicationComponent'\n    : (s.includes('interface') || s.includes('api')) ? 'ApplicationInterface'\n    : s.includes('service') ? 'ApplicationService'\n    : 'ApplicationComponent';\n};\n\nconst mapRelType = (kind, typeHint) => {\n  const hint = String(typeHint || '').toLowerCase();\n  const typeMap = {\n    bizapp: 'RealizationRelationship',\n    appdata: 'AccessRelationship',\n    bizdata: 'AccessRelationship',\n    datastore: 'AssignmentRelationship',\n    appinfra: 'ServingRelationship'\n  };\n  let result = typeMap[kind];\n  if (!result) {\n    if (kind === 'infra') {\n      result = (hint.includes('compose') || hint.includes('contain')) ? 'CompositionRelationship'\n        : (hint.includes('deploy') || hint.includes('assign')) ? 'AssignmentRelationship'\n        : (hint.includes('serve') || hint.includes('provide')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'biz') {\n      result = (hint.includes('trigger') || hint.includes('flow')) ? 'TriggeringRelationship'\n        : (hint.includes('serve') || hint.includes('support')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'app') {\n      result = (hint.includes('flow') || hint.includes('call')) ? 'FlowRelationship'\n        : (hint.includes('serve') || hint.includes('use')) ? 'ServingRelationship'\n        : hint.includes('access') ? 'AccessRelationship'\n        : 'AssociationRelationship';\n    } else {\n      result = 'AssociationRelationship';\n    }\n  }\n  return result;\n};\n\nconst bizElements = [...(biz.elements || [])].sort((a,b) => String(a.id).localeCompare(String(b.id)));\nconst appElements = [...(app.elements || [])].sort((a,b) => String(a.id).localeCompare(String(b.id)));\n\nconst bizIdMap = {};\nfor (const el of bizElements) bizIdMap[el.id] = 'e-' + stableId(projectSlug + ':business:' + el.id);\n\nconst appIdMap = {};\nfor (const el of appElements) appIdMap[el.id] = 'e-' + stableId(projectSlug + ':application:' + el.id);\n\nconst rels = [];\nfor (const r of (biz.relationships || [])) rels.push({ layer: 'biz', type: r.type, source: r.source, target: r.target });\nfor (const r of (app.relationships || [])) rels.push({ layer: 'app', type: r.type, source: r.source, target: r.target });\nfor (const r of (app.crossLayerRelationships || [])) rels.push({ layer: 'cross', type: r.type, source: r.businessSourceId, target: r.applicationTargetId });\nrels.sort((a,b) => (a.layer + '|' + a.type + '|' + a.source + '|' + a.target).localeCompare(b.layer + '|' + b.type + '|' + b.source + '|' + b.target));\n\nconst modelId = 'm-' + stableId(projectSlug + ':model:biz+app');\nconst folderBiz = 'f-' + stableId(projectSlug + ':folder:biz');\nconst folderApp = 'f-' + stableId(projectSlug + ':folder:app');\nconst folderRel = 'f-' + stableId(projectSlug + ':folder:relations');\n\nlet xml = '<?xml version=\"1.0\" encoding=\"UTF-8\"?>\\n' +\n  '<archimate:model xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:archimate=\"http://www.archimatetool.com/archimate\" name=\"' + escapeXml((biz.name || 'Business') + ' + ' + (app.name || 'Application')) + '\" id=\"' + modelId + '\" version=\"5.0.0\">\\n';\n\nxml += '  <folder name=\"Business\" id=\"' + folderBiz + '\" type=\"elements\">\\n';\nfor (const el of bizElements) {\n  xml += '    <element xsi:type=\"archimate:' + mapBizType(el.type) + '\" name=\"' + escapeXml(el.name) + '\" id=\"' + bizIdMap[el.id] + '\"/>\\n';\n}\nxml += '  </folder>\\n';\n\nxml += '  <folder name=\"Application\" id=\"' + folderApp + '\" type=\"elements\">\\n';\nfor (const el of appElements) {\n  xml += '    <element xsi:type=\"archimate:' + mapAppType(el.type, el.id) + '\" name=\"' + escapeXml(el.name) + '\" id=\"' + appIdMap[el.id] + '\"/>\\n';\n}\nxml += '  </folder>\\n';\n\nlet relCount = 0;\nxml += '  <folder name=\"Relations\" id=\"' + folderRel + '\" type=\"relations\">\\n';\nfor (const r of rels) {\n  const sid = (r.layer === 'app') ? appIdMap[r.source] : bizIdMap[r.source];\n  const tid = (r.layer === 'biz') ? bizIdMap[r.target] : appIdMap[r.target];\n  if (!sid || !tid) continue;\n  const rid = 'r-' + stableId(projectSlug + ':' + r.layer + ':' + r.type + ':' + r.source + '->' + r.target);\n  xml += '    <element xsi:type=\"archimate:' + mapRelType(r.layer, r.type) + '\" id=\"' + rid + '\" source=\"' + sid + '\" target=\"' + tid + '\"/>\\n';\n  relCount++;\n}\nxml += '  </folder>\\n</archimate:model>';\n\nreturn [{ json: { ...item, archimateXml: xml, elementCount: bizElements.length + appElements.length, relationshipCount: relCount } }];"
      }
    },
    {
      "id": "8549940c-eb85-4a1a-8b95-abc9487b4e89",
      "name": "Hash Combined XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4944,
        512
      ],
      "parameters": {
        "jsCode": "const fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) {\n    hash ^= s.charCodeAt(i);\n    hash = (hash * 0x01000193) >>> 0;\n  }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\nreturn [{ json: { ...$json, archimateXmlHash: fnv1a($json.archimateXml) } }];"
      }
    },
    {
      "id": "b93d93ee-1b63-40d4-a3ea-f2fddc8fb88d",
