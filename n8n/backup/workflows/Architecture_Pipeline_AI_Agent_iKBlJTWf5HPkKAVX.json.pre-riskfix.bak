    {
      "id": "552bd617-a44f-4cdf-b82b-e0a02768ed7c",
      "name": "Repair Application Architecture (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        4464,
        672
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You repair an Application Architecture JSON model.',\n        'Fix invalid relationship endpoints and invalid crossLayerRelationships.',\n        'Rules:',\n        '- relationships must reference application element ids only',\n        '- crossLayerRelationships must use BUSINESS_ARCH ids for businessSourceId and application element ids for applicationTargetId',\n        '- Output ONLY corrected JSON matching the schema'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'VALIDATION_ERRORS: ' + JSON.stringify($json.errors || []),\n        'BUSINESS_ARCH_ELEMENT_IDS: ' + JSON.stringify((($('Validate Business Architecture').first().json.businessArch || {}).elements || []).map(e => e.id)),\n        'APPLICATION_ARCH_JSON: ' + JSON.stringify($json.applicationArch)\n      ].join('\\\\n\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['name','layer','elements','relationships','crossLayerRelationships'],\n    properties: {\n      name: { type: 'string' },\n      layer: { const: 'Application' },\n      elements: { type: 'array' },\n      relationships: { type: 'array' },\n      crossLayerRelationships: { type: 'array' }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "8273fe01-12e8-4b6a-a44e-d82f3e7c4bdd",
      "name": "Validate Repaired App Arch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4704,
        672
      ],
      "parameters": {
        "jsCode": "// Reuse same validation rules as Validate Application Architecture\nlet model;\ntry { model = JSON.parse($json.message.content); }\ncatch (e) {\n  return [{ json: { valid: false, errors: ['Application repair parse failed: ' + e.message], applicationArch: null } }];\n}\n\nconst errors = [];\nif (model.layer !== 'Application') errors.push('layer must be Application');\nif (!Array.isArray(model.elements)) errors.push('elements must be array');\nif (!Array.isArray(model.relationships)) errors.push('relationships must be array');\nif (!Array.isArray(model.crossLayerRelationships)) errors.push('crossLayerRelationships must be array');\n\nconst appIds = new Set((model.elements || []).map(e => e.id));\nfor (const rel of (model.relationships || [])) {\n  if (!appIds.has(rel.source)) errors.push(`App relationship source not found: ${rel.source}`);\n  if (!appIds.has(rel.target)) errors.push(`App relationship target not found: ${rel.target}`);\n}\n\nconst businessArch = $('Validate Business Architecture').first().json.businessArch;\nconst bizIds = new Set((businessArch?.elements || []).map(e => e.id));\nfor (const rel of (model.crossLayerRelationships || [])) {\n  if (!bizIds.has(rel.businessSourceId)) errors.push(`Cross-layer businessSourceId not found: ${rel.businessSourceId}`);\n  if (!appIds.has(rel.applicationTargetId)) errors.push(`Cross-layer applicationTargetId not found: ${rel.applicationTargetId}`);\n}\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst valid = errors.length === 0;\nconst applicationArchHash = fnv1a(JSON.stringify(model));\n\nreturn [{ json: { ...$('Validate Business Architecture').first().json, valid, errors, applicationArch: model, applicationArchHash, repaired: true } }];"
      }
    },
    {
      "id": "5a7f231e-ac48-4338-86f7-e3abc988d2d0",
      "name": "After App Stage",
      "type": "n8n-nodes-base.if",
