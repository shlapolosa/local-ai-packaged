      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = $2\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, $2, next_version.v, $3::jsonb, $4, $5::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, $json.artifactType, JSON.stringify($json.content), $json.contentHash, JSON.stringify($json.meta) ] }}"
        }
      },
      "credentials": {
        "postgres": {
