    {
      "id": "gen-qa",
      "name": "Generate QA Package (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        11296,
        656
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are a QA Architect responsible for test strategy and test scenario specification.',\n        'Output ONLY JSON matching the schema.',\n        'You must create two markdown documents:',\n        '1) testStrategyMarkdown starting with \"# Test Strategy:\"',\n        '2) testScenariosMarkdown starting with \"# Test Scenarios:\"',\n        '',\n        'Include a test pyramid with the ratios (Unit 60-70%, Integration 20-30%, E2E 10-20%).',\n        'Include coverage targets table (line 80%, branch 75%, critical paths 100%).',\n        'Include critical test scenarios covering: auth (OIDC/JWKS), tenant isolation, core inventory/order flows, event-driven updates if present, and data consistency.',\n        '',\n        'We may not have modules.md or features.md. Derive modules/services/endpoints from application_arch and openapi_yaml when present.',\n        'If openapi_yaml is present, ensure each major endpoint group has scenarios.',\n        'If asyncapi_yaml is present, ensure each event has producer/consumer and contract validation scenarios.',\n        'Use deterministic IDs for scenarios: UT-<module>-###, IT-<module>-###, E2E-<journey>-###.',\n        'Do not use markdown code fences at all.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT_NAME: ' + $('Apply Classification + Slugify').first().json.projectName,\n        'PROJECT_SLUG: ' + $('Apply Classification + Slugify').first().json.projectSlug,\n        'JOB_ID: ' + ($('Initialize Parameters').first().json.jobId || ''),\n        '',\n        'BRD: ' + JSON.stringify($('Validate BRD').first().json.brd).slice(0, 9000),\n        '',\n        'APPLICATION_ARCH: ' + JSON.stringify($('Validate Application Architecture').first().json.applicationArch).slice(0, 9000),\n        '',\n        'DATA_ARCH: ' + JSON.stringify($('Validate Data Architecture').first().json.dataArch).slice(0, 9000),\n        '',\n        'INFRA_ARCH: ' + JSON.stringify($('Validate Infrastructure Architecture').first().json.infraArch).slice(0, 9000),\n        '',\n        'SOLUTION_STYLE: ' + String($('Validate Solution Package').first().json.integrationStyle || ''),\n        'OPENAPI_YAML (if any): ' + String($('Validate Solution Package').first().json.openapiYaml || '').slice(0, 9000),\n        'ASYNCAPI_YAML (if any): ' + String($('Validate Solution Package').first().json.asyncapiYaml || '').slice(0, 9000)\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['testStrategyMarkdown','testScenariosMarkdown'],\n    properties: {\n      testStrategyMarkdown: { type: 'string' },\n      testScenariosMarkdown: { type: 'string' }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
