    {
      "id": "707043d5-fc1d-471a-bc60-fb965cdb2ef2",
      "name": "Generate Infrastructure Architecture (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        7584,
        512
      ],
      "parameters": {
        "url": "https://ollama.com/api/chat",
        "method": "POST",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are an Infrastructure Architect.',\n        'Output ONLY JSON matching the schema.',\n        'Assume Azure + AKS single cluster; Ingress via AGIC; API Gateway via APIM; External IdP (OIDC); Eventing via Event Hubs; Dapr for sidecars; self-managed Postgres + MongoDB on AKS.',\n        'relationships must be infra->infra only (sourceId/targetId in infra sets).',\n        'crossLayerRelationships must be application ids -> infra ids (applicationSourceId -> infraTargetId).',\n        'Must include auth links: web-client->apim, mobile-client->apim, apim->external_idp (JWKS/validate).'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT: ' + $('Apply Classification + Slugify').first().json.projectName,\n        'APPLICATION_IDS: ' + JSON.stringify((($('Validate Application Architecture').first().json.applicationArch || {}).elements || []).map(e => e.id)),\n        'DATA_STORES: ' + JSON.stringify((($('Validate Data Architecture').first().json.dataArch || {}).stores || []).map(s => ({ id: s.id, type: s.type, name: s.name })))\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['name','layer','clusters','platformServices','runtimeComponents','dataPlatforms','relationships','crossLayerRelationships'],\n    properties: {\n      name: { type: 'string' },\n      layer: { const: 'Technology' },\n      clusters: {\n        type: 'array',\n        items: { type: 'object', additionalProperties: false, required: ['id','name','type'], properties: { id: {type:'string'}, name:{type:'string'}, type:{type:'string'}, description:{type:'string'} } }\n      },\n      platformServices: {\n        type: 'array',\n        items: { type: 'object', additionalProperties: false, required: ['id','name','type'], properties: { id:{type:'string'}, name:{type:'string'}, type:{type:'string'}, description:{type:'string'} } }\n      },\n      runtimeComponents: {\n        type: 'array',\n        items: { type: 'object', additionalProperties: false, required: ['id','name','type'], properties: { id:{type:'string'}, name:{type:'string'}, type:{type:'string'}, description:{type:'string'} } }\n      },\n      dataPlatforms: {\n        type: 'array',\n        items: { type: 'object', additionalProperties: false, required: ['id','name','type'], properties: { id:{type:'string'}, name:{type:'string'}, type:{type:'string'}, description:{type:'string'} } }\n      },\n      relationships: {\n        type: 'array',\n        items: { type: 'object', additionalProperties: false, required: ['type','sourceId','targetId'], properties: { type:{type:'string'}, sourceId:{type:'string'}, targetId:{type:'string'}, description:{type:'string'} } }\n      },\n      crossLayerRelationships: {\n        type: 'array',\n        items: { type: 'object', additionalProperties: false, required: ['type','applicationSourceId','infraTargetId'], properties: { type:{type:'string'}, applicationSourceId:{type:'string'}, infraTargetId:{type:'string'}, description:{type:'string'} } }\n      }\n    }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "3073960e-8212-4cc7-a4a6-59ea9bd6c9fe",
      "name": "Validate Infrastructure Architecture",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7824,
        512
      ],
      "parameters": {
        "jsCode": "let model;\ntry { model = JSON.parse($json.message.content); } catch (e) {\n  return [{ json: { valid: false, errors: ['Infra arch parse failed: ' + e.message], infraArch: null } }];\n}\n\nconst errors = [];\nif (model.layer !== 'Technology') errors.push('layer must be Technology');\nfor (const key of ['clusters','platformServices','runtimeComponents','dataPlatforms','relationships','crossLayerRelationships']) {\n  if (!Array.isArray(model[key])) errors.push(`${key} must be array`);\n}\n\nconst infraIds = new Set([\n  ...(model.clusters || []).map(x => x.id),\n  ...(model.platformServices || []).map(x => x.id),\n  ...(model.runtimeComponents || []).map(x => x.id),\n  ...(model.dataPlatforms || []).map(x => x.id),\n]);\n\n// Required infra types\nconst hasType = (arr, type) => (arr || []).some(x => String(x.type).toLowerCase() === type);\nif (!hasType(model.clusters, 'aks')) errors.push('Missing AKS cluster (clusters[].type=aks)');\nif (!hasType(model.runtimeComponents, 'agic')) errors.push('Missing AGIC runtime component (runtimeComponents[].type=agic)');\nif (!hasType(model.platformServices, 'apim')) errors.push('Missing APIM platform service (platformServices[].type=apim)');\nif (!hasType(model.platformServices, 'external_idp')) errors.push('Missing external IdP platform service (platformServices[].type=external_idp)');\nif (!hasType(model.platformServices, 'event_hubs')) errors.push('Missing Event Hubs platform service (platformServices[].type=event_hubs)');\nif (!hasType(model.runtimeComponents, 'dapr')) errors.push('Missing Dapr runtime component (runtimeComponents[].type=dapr)');\nif (!hasType(model.dataPlatforms, 'postgres')) errors.push('Missing self-managed Postgres (dataPlatforms[].type=postgres)');\nif (!hasType(model.dataPlatforms, 'mongodb')) errors.push('Missing self-managed MongoDB (dataPlatforms[].type=mongodb)');\n\nconst appIds = new Set((($('Validate Application Architecture').first().json.applicationArch || {}).elements || []).map(e => e.id));\n\n// relationships must be infra->infra only\nfor (const rel of (model.relationships || [])) {\n  if (!infraIds.has(rel.sourceId)) errors.push(`Infra relationship sourceId not found (must be infra id): ${rel.sourceId}`);\n  if (!infraIds.has(rel.targetId)) errors.push(`Infra relationship targetId not found (must be infra id): ${rel.targetId}`);\n}\n\n// cross-layer app->infra\nfor (const rel of (model.crossLayerRelationships || [])) {\n  if (!appIds.has(rel.applicationSourceId)) errors.push(`crossLayer applicationSourceId not found: ${rel.applicationSourceId}`);\n  if (!infraIds.has(rel.infraTargetId)) errors.push(`crossLayer infraTargetId not found: ${rel.infraTargetId}`);\n}\n\n// Require auth links: web-client->apim, mobile-client->apim, apim->idp jwks\nconst apim = (model.platformServices || []).find(x => String(x.type).toLowerCase() === 'apim');\nconst idp = (model.platformServices || []).find(x => String(x.type).toLowerCase() === 'external_idp');\nif (apim && idp) {\n  const hasJwks = (model.relationships || []).some(r => r.sourceId === apim.id && r.targetId === idp.id && /jwks|validate/i.test(String(r.type)));\n  if (!hasJwks) errors.push('Missing apim->external_idp JWKS validation relationship (type should mention jwks/validate)');\n}\n\nconst hasClientLink = (clientId) => (model.crossLayerRelationships || []).some(r => r.applicationSourceId === clientId && apim && r.infraTargetId === apim.id);\nif (!hasClientLink('web-client')) errors.push('Missing crossLayer relationship web-client -> apim');\nif (!hasClientLink('mobile-client')) errors.push('Missing crossLayer relationship mobile-client -> apim');\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst valid = errors.length === 0;\nconst infraArchHash = fnv1a(JSON.stringify(model));\n\nreturn [{ json: { ...$('Validate Data Architecture').first().json, valid, errors, infraArch: model, infraArchHash } }];"
      }
    },
    {
      "id": "04a8cb78-0e57-475a-b50f-14809f6a8f48",
      "name": "Store Infra Arch Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        8064,
        512
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'infrastructure_arch'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'infrastructure_arch', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify($json.infraArch), $json.infraArchHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'infrastructure_architect', model: $('Run Config').first().json.ollamaModel }) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
    {
      "id": "80c46102-5134-40d7-9373-4c18a97f9366",
      "name": "Reload Infra Arch For XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8304,
        512
      ],
      "parameters": {
        "jsCode": "// Store Infra Arch Artifact returns only {id, version}. Reattach in-flight infraArch.\nreturn [{ json: { ...$json, infraArch: $('Validate Infrastructure Architecture').first().json.infraArch } }];"
      }
    },
    {
      "id": "7b768c43-bf27-4f31-adf0-267b03194f61",
      "name": "Convert to ArchiMate XML (Biz+App+Data+Infra)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8544,
        512
      ],
      "parameters": {
        "jsCode": "// Combined Biz + App + Data + Infra ArchiMate XML (single output item)\nconst item = ($input.all()[0] && $input.all()[0].json) ? $input.all()[0].json : {};\nconst projectSlug = item.projectSlug || $('Apply Classification + Slugify').first().json.projectSlug;\nconst biz = item.businessArch || $('Validate Business Architecture').first().json.businessArch;\nconst app = item.applicationArch || $('Validate Application Architecture').first().json.applicationArch;\nconst data = item.dataArch || $('Validate Data Architecture').first().json.dataArch;\nconst infra = item.infraArch || $('Validate Infrastructure Architecture').first().json.infraArch;\n\nif (!biz || !app || !data || !infra) return [{ json: { ...item, archimateXml: '', xmlError: 'Missing one or more prerequisite models' } }];\n\nconst escapeXml = (t) => String(t ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\\\"/g,'&quot;').replace(/'/g,'&apos;');\nconst fnv1a32 = (str) => String(str ?? '').split('').reduce((h, ch) => (((h ^ ch.charCodeAt(0)) * 0x01000193) >>> 0), 0x811c9dc5);\nconst stableId = (s) => ('000000000000' + fnv1a32(String(s)).toString(16)).slice(-12);\n\nconst mapRelType = (kind, typeHint) => {\n  const hint = String(typeHint || '').toLowerCase();\n  const typeMap = {\n    bizapp: 'RealizationRelationship',\n    appdata: 'AccessRelationship',\n    bizdata: 'AccessRelationship',\n    datastore: 'AssignmentRelationship',\n    appinfra: 'ServingRelationship'\n  };\n  let result = typeMap[kind];\n  if (!result) {\n    if (kind === 'infra') {\n      result = (hint.includes('compose') || hint.includes('contain')) ? 'CompositionRelationship'\n        : (hint.includes('deploy') || hint.includes('assign')) ? 'AssignmentRelationship'\n        : (hint.includes('serve') || hint.includes('provide')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'biz') {\n      result = (hint.includes('trigger') || hint.includes('flow')) ? 'TriggeringRelationship'\n        : (hint.includes('serve') || hint.includes('support')) ? 'ServingRelationship'\n        : 'AssociationRelationship';\n    } else if (kind === 'app') {\n      result = (hint.includes('flow') || hint.includes('call')) ? 'FlowRelationship'\n        : (hint.includes('serve') || hint.includes('use')) ? 'ServingRelationship'\n        : hint.includes('access') ? 'AccessRelationship'\n        : 'AssociationRelationship';\n    } else {\n      result = 'AssociationRelationship';\n    }\n  }\n  return result;\n};\n\nconst bizEls = [...(biz.elements||[])];\nconst appEls = [...(app.elements||[])];\nconst dataObjs = [...(data.dataObjects||[])];\nconst stores = [...(data.stores||[])];\nconst infraEls = [...(infra.clusters||[]),...(infra.platformServices||[]),...(infra.runtimeComponents||[]),...(infra.dataPlatforms||[])].sort((a,b)=>String(a.id).localeCompare(String(b.id)));\n\nconst bizId = {}; for (const e of bizEls) bizId[e.id] = 'e-' + stableId(projectSlug+':biz:'+e.id);\nconst appId = {}; for (const e of appEls) appId[e.id] = 'e-' + stableId(projectSlug+':app:'+e.id);\nconst dataId = {}; for (const d of dataObjs) dataId[d.id] = 'e-' + stableId(projectSlug+':data:'+d.id);\nconst storeId = {}; for (const s of stores) storeId[s.id] = 'e-' + stableId(projectSlug+':store:'+s.id);\nconst infraId = {}; for (const x of infraEls) infraId[x.id] = 'e-' + stableId(projectSlug+':tech:'+x.id);\n\nconst mapTechType = (t) => {\n  const s = String(t||'').toLowerCase();\n  return s.includes('aks') ? 'Node' : s.includes('dapr') ? 'SystemSoftware' : s.includes('agic') ? 'TechnologyService' : s.includes('apim') ? 'TechnologyService' : s.includes('event') ? 'TechnologyService' : (s.includes('postgres') || s.includes('mongo')) ? 'Node' : 'TechnologyService';\n};\n\nconst modelId = 'm-' + stableId(projectSlug+':model:full');\nconst fBiz = 'f-' + stableId(projectSlug+':folder:biz');\nconst fApp = 'f-' + stableId(projectSlug+':folder:app');\nconst fData = 'f-' + stableId(projectSlug+':folder:data');\nconst fStore = 'f-' + stableId(projectSlug+':folder:stores');\nconst fTech = 'f-' + stableId(projectSlug+':folder:tech');\nconst fRel = 'f-' + stableId(projectSlug+':folder:relations');\n\nlet xml = '<?xml version=\"1.0\" encoding=\"UTF-8\"?>\\n' + '<archimate:model xmlns:xsi=\"http://www.w3.org/2001/XMLSchema-instance\" xmlns:archimate=\"http://www.archimatetool.com/archimate\" name=\"' + escapeXml(projectSlug + ' Architecture') + '\" id=\"' + modelId + '\" version=\"5.0.0\">\\n';\nxml += '  <folder name=\"Business\" id=\"' + fBiz + '\" type=\"elements\">\\n';\nfor (const e of bizEls.sort((a,b)=>String(a.id).localeCompare(String(b.id)))) xml += '    <element xsi:type=\"archimate:BusinessProcess\" name=\"' + escapeXml(e.name) + '\" id=\"' + bizId[e.id] + '\"/>\\n';\nxml += '  </folder>\\n';\nxml += '  <folder name=\"Application\" id=\"' + fApp + '\" type=\"elements\">\\n';\nfor (const e of appEls.sort((a,b)=>String(a.id).localeCompare(String(b.id)))) xml += '    <element xsi:type=\"archimate:ApplicationComponent\" name=\"' + escapeXml(e.name) + '\" id=\"' + appId[e.id] + '\"/>\\n';\nxml += '  </folder>\\n';\nxml += '  <folder name=\"Data\" id=\"' + fData + '\" type=\"elements\">\\n';\nfor (const d of dataObjs.sort((a,b)=>String(a.id).localeCompare(String(b.id)))) xml += '    <element xsi:type=\"archimate:DataObject\" name=\"' + escapeXml(d.name) + '\" id=\"' + dataId[d.id] + '\"/>\\n';\nxml += '  </folder>\\n';\nxml += '  <folder name=\"Data Stores\" id=\"' + fStore + '\" type=\"elements\">\\n';\nfor (const s of stores.sort((a,b)=>String(a.id).localeCompare(String(b.id)))) xml += '    <element xsi:type=\"archimate:Artifact\" name=\"' + escapeXml(s.name) + '\" id=\"' + storeId[s.id] + '\"/>\\n';\nxml += '  </folder>\\n';\nxml += '  <folder name=\"Technology\" id=\"' + fTech + '\" type=\"elements\">\\n';\nfor (const t of infraEls) xml += '    <element xsi:type=\"archimate:' + mapTechType(t.type) + '\" name=\"' + escapeXml(t.name) + '\" id=\"' + infraId[t.id] + '\"/>\\n';\nxml += '  </folder>\\n';\n\nconst rels = [];\nfor (const r of (biz.relationships||[])) rels.push({ kind:'biz', type:r.type, s:r.source, t:r.target });\nfor (const r of (app.relationships||[])) rels.push({ kind:'app', type:r.type, s:r.source, t:r.target });\nfor (const r of (app.crossLayerRelationships||[])) rels.push({ kind:'bizapp', type:r.type, s:r.businessSourceId, t:r.applicationTargetId });\nfor (const r of (data.relationships||[])) {\n  if (r.businessSourceId && r.dataTargetId) rels.push({ kind:'bizdata', type:r.type, s:r.businessSourceId, t:r.dataTargetId });\n  if (r.applicationSourceId && r.dataTargetId) rels.push({ kind:'appdata', type:r.type, s:r.applicationSourceId, t:r.dataTargetId });\n  if (r.dataObjectId && r.storeId) rels.push({ kind:'datastore', type:r.type, s:r.dataObjectId, t:r.storeId });\n}\nfor (const r of (infra.relationships||[])) rels.push({ kind:'infra', type:r.type, s:r.sourceId, t:r.targetId });\nfor (const r of (infra.crossLayerRelationships||[])) rels.push({ kind:'appinfra', type:r.type, s:r.applicationSourceId, t:r.infraTargetId });\nrels.sort((a,b)=>(a.kind+'|'+a.type+'|'+a.s+'|'+a.t).localeCompare(b.kind+'|'+b.type+'|'+b.s+'|'+b.t));\n\nlet relCount = 0;\nconst relStats = {};\nxml += '  <folder name=\"Relations\" id=\"' + fRel + '\" type=\"relations\">\\n';\nfor (const r of rels) {\n  let sid=null, tid=null;\n  if (r.kind==='biz') { sid=bizId[r.s]; tid=bizId[r.t]; }\n  else if (r.kind==='app') { sid=appId[r.s]; tid=appId[r.t]; }\n  else if (r.kind==='bizapp') { sid=bizId[r.s]; tid=appId[r.t]; }\n  else if (r.kind==='bizdata') { sid=bizId[r.s]; tid=dataId[r.t]; }\n  else if (r.kind==='appdata') { sid=appId[r.s]; tid=dataId[r.t]; }\n  else if (r.kind==='datastore') { sid=dataId[r.s]; tid=storeId[r.t]; }\n  else if (r.kind==='infra') { sid=infraId[r.s]; tid=infraId[r.t]; }\n  else if (r.kind==='appinfra') { sid=appId[r.s]; tid=infraId[r.t]; }\n  if (!sid || !tid) continue;\n  const relType = mapRelType(r.kind, r.type);\n  relStats[relType] = (relStats[relType] || 0) + 1;\n  const rid='r-' + stableId(projectSlug+':'+r.kind+':'+r.type+':'+r.s+'->'+r.t);\n  xml += '    <element xsi:type=\"archimate:' + relType + '\" id=\"' + rid + '\" source=\"' + sid + '\" target=\"' + tid + '\"/>\\n';\n  relCount++;\n}\nxml += '  </folder>\\n</archimate:model>';\n\nreturn [{ json: { ...item, archimateXml: xml, relationshipCount: relCount, relationshipStats: relStats } }];\n"
      }
    },
    {
      "id": "017a8aa5-7d2c-4490-97a9-c3e8351f0e3d",
      "name": "Hash Biz+App+Data+Infra XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        8784,
        512
      ],
      "parameters": {
        "jsCode": "const fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\nreturn [{ json: { ...$json, archimateXmlHash: fnv1a($json.archimateXml) } }];"
      }
    },
    {
      "id": "1676844c-b932-4ae4-acfa-4d5faf618985",
