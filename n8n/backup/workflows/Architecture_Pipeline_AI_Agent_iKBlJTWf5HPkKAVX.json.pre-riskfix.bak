    {
      "id": "f103d140-5788-4751-8d9a-56655890d73b",
      "name": "Validate Repaired Business Arch",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4064,
        512
      ],
      "parameters": {
        "jsCode": "// Validate repaired Business Architecture\nlet model;\ntry { model = JSON.parse($json.message.content); }\ncatch (e) {\n  return [{ json: { ...$json, valid: false, errors: ['Repair parse failed: ' + e.message], businessArch: null } }];\n}\n\nconst errors = [];\nconst elementIds = new Set((model.elements || []).map(e => e.id));\nfor (const rel of (model.relationships || [])) {\n  if (!elementIds.has(rel.source)) errors.push(`Relationship source not found: ${rel.source}`);\n  if (!elementIds.has(rel.target)) errors.push(`Relationship target not found: ${rel.target}`);\n}\n\nconst valid = errors.length === 0;\n\n// Hash (FNV-1a)\nconst fnv1a = (str) => {\n  let hash = 0x811c9dc5;\n  const s = String(str ?? '');\n  for (let i = 0; i < s.length; i++) {\n    hash ^= s.charCodeAt(i);\n    hash = (hash * 0x01000193) >>> 0;\n  }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nconst businessArchHash = fnv1a(JSON.stringify(model));\n\nreturn [{ json: { ...$('Build Capability Context').first().json, valid, errors, businessArch: model, businessArchHash, repaired: true } }];"
      }
    },
    {
      "id": "80a1ce19-5008-49e1-a5d8-30792252a85e",
      "name": "Hash Business XML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4224,
        304
      ],
      "parameters": {
        "jsCode": "const fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) {\n    hash ^= s.charCodeAt(i);\n    hash = (hash * 0x01000193) >>> 0;\n  }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nreturn [{ json: { ...$json, archimateXmlHash: fnv1a($json.archimateXml) } }];"
      }
    },
    {
      "id": "d36b1580-dea1-46cc-8494-9a267de608f3",
      "name": "Store Business XML Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        4464,
        304
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'archimate_xml_business'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'archimate_xml_business', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify({ xml: $json.archimateXml }), $json.archimateXmlHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'business_architect', model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature }) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
