        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify({ xml: $json.archimateXml }), $json.archimateXmlHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'application_architect', model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature }) ] }}"
        }
