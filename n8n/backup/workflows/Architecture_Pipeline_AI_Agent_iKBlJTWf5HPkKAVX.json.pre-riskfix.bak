    {
      "id": "after-solution",
      "name": "After Solution Stage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10944,
        512
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Collapse multiple solution artifact insert rows into a single continuation item\nconst jobId = $('Initialize Parameters').first().json.jobId;\nconst projectName = $('Apply Classification + Slugify').first().json.projectName;\nconst projectSlug = $('Apply Classification + Slugify').first().json.projectSlug;\nreturn [{ json: { jobId, projectName, projectSlug } }];"
      }
    },
    {
      "id": "gen-prd",
      "name": "Generate PRD (RPG Template)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        11296,
        512
      ],
      "parameters": {
        "url": "https://ollama.com/api/chat",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are a Business Analyst writing a PRD using the RPG (Repository Planning Graph) Method.',\n        '',\n        'CRITICAL REQUIREMENTS:',\n        '',\n        '1. CAPABILITY TREE - For EACH capability, include Features with:',\n        '   - **Description**: One sentence',\n        '   - **Inputs**: What data/context it needs',\n        '   - **Outputs**: What it produces',\n        '   - **Behavior**: Key logic/transformations',\n        '',\n        '2. MODULE DEFINITIONS - For EACH module:',\n        '   - **Maps to capability**: Reference the capability name',\n        '   - **Responsibility**: Single clear purpose',\n        '   - **File structure**: Show the module files',\n        '   - **Exports**: List functions/classes with descriptions',\n        '',\n        '3. DEPENDENCY CHAIN - Structure as LAYERS (not library dependencies):',\n        '   ### Foundation Layer (Phase 0) - modules with NO dependencies',\n        '   ### Core Layer (Phase 1) - modules depending on Foundation',\n        '   ### Integration Layer (Phase 2) - modules depending on Phase 1',\n        '',\n        '4. DEVELOPMENT PHASES - For EACH phase include:',\n        '   - **Goal**: What this phase establishes',\n        '   - **Entry Criteria**: What must be true before starting',\n        '   - **Tasks**: With [ ] checkboxes and dependencies',\n        '   - **Exit Criteria**: Observable outcome',\n        '   - **Delivers**: What users/devs can do after',\n        '',\n        '5. First line MUST be: # PRD: <Project Name>',\n        '',\n        'Use architecture artifacts to inform all sections. Be detailed and specific.'\n      ].join('\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'PROJECT_NAME: ' + $json.projectName,\n        'PROJECT_SLUG: ' + $json.projectSlug,\n        'JOB_ID: ' + ($json.jobId || ''),\n        '',\n        'RPG TEMPLATE SKELETON (use these headings verbatim):',\n        '# Repository Planning Graph (RPG) Method - PRD Template',\n        '## Problem Statement',\n        '## Target Users',\n        '## Success Metrics',\n        '## Capability Tree',\n        '## Repository Structure',\n        '## Module Definitions',\n        '## Dependency Chain',\n        '## Development Phases',\n        '## Test Pyramid',\n        '## Coverage Requirements',\n        '## Critical Test Scenarios',\n        '## System Components',\n        '## Data Models',\n        '## Technology Stack',\n        '## Technical Risks',\n        '## Dependency Risks',\n        '## Scope Risks',\n        '## References',\n        '## Glossary',\n        '## Open Questions',\n        '',\n        'ARCHITECTURE ARTIFACTS:',\n        'BRD: ' + JSON.stringify($('Validate BRD').first().json.brd).slice(0, 9000),\n        'BUSINESS_ARCH: ' + JSON.stringify($('Validate Business Architecture').first().json.businessArch).slice(0, 9000),\n        'APPLICATION_ARCH: ' + JSON.stringify($('Validate Application Architecture').first().json.applicationArch).slice(0, 9000),\n        'DATA_ARCH: ' + JSON.stringify($('Validate Data Architecture').first().json.dataArch).slice(0, 9000),\n        'INFRA_ARCH: ' + JSON.stringify($('Validate Infrastructure Architecture').first().json.infraArch).slice(0, 9000),\n        'RISK_ASSESSMENT_MD: ' + String($('Validate Risk Markdown').first().json.riskMarkdown || '').slice(0, 9000),\n        'SOLUTION_ARCH_MD: ' + String($('Validate Solution Package').first().json.solutionMarkdown || '').slice(0, 9000),\n        '',\n        'QA INPUTS (use to populate QA-related PRD sections):',\n        'TEST_STRATEGY_MD: ' + String(($('Validate QA Package').first().json.testStrategyMarkdown || '')).slice(0, 9000),\n        'TEST_SCENARIOS_MD: ' + String(($('Validate QA Package').first().json.testScenariosMarkdown || '')).slice(0, 9000)\n      ].join('\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['markdown'],\n    properties: { markdown: { type: 'string' } }\n  },\n  options: {\n    num_ctx: 16384, temperature: $('Run Config').first().json.ollamaTemperature,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "val-prd",
      "name": "Validate PRD",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        11536,
        512
      ],
      "parameters": {
        "jsCode": "const raw = $json.message?.content;\nlet parsed;\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { valid: false, errors: ['PRD parse failed: ' + e.message], prdMarkdown: '' } }];\n}\n\nconst md = String(parsed?.markdown || '');\nconst errors = [];\nif (!md.startsWith('# PRD:')) errors.push('First line must start with \"# PRD:\"');\n\nconst requiredHeadings = [\n  '## Problem Statement',\n  '## Target Users',\n  '## Success Metrics',\n  '## Capability Tree',\n  '## Repository Structure',\n  '## Module Definitions',\n  '## Dependency Chain',\n  '## Development Phases',\n  '## Test Pyramid',\n  '## Coverage Requirements',\n  '## Critical Test Scenarios',\n  '## System Components',\n  '## Data Models',\n  '## Technology Stack',\n  '## Technical Risks',\n  '## Open Questions',\n];\nfor (const h of requiredHeadings) {\n  if (!md.includes(h)) errors.push('Missing heading: ' + h);\n}\n\nif (md.includes('<instruction>') || md.includes('</instruction>')) errors.push('PRD must not include <instruction> tags');\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nreturn [{ json: { valid: errors.length === 0, errors, prdMarkdown: md, prdMarkdownHash: fnv1a(md) } }];"
      }
    },
    {
      "id": "store-prd",
      "name": "Store PRD Artifact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        11776,
        512
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH next_version AS (\n  SELECT COALESCE(MAX(version), 0) + 1 AS v\n  FROM architecture.artifacts\n  WHERE project_id = $1 AND type = 'prd_md'\n)\nINSERT INTO architecture.artifacts (project_id, type, version, content, content_hash, meta)\nSELECT $1, 'prd_md', next_version.v, $2::jsonb, $3, $4::jsonb\nFROM next_version\nRETURNING id, version;",
        "options": {
          "queryReplacement": "={{ [ $('Upsert Project').first().json.id, JSON.stringify({ markdown: $json.prdMarkdown }), $json.prdMarkdownHash, JSON.stringify({ jobId: $('Initialize Parameters').first().json.jobId, stage: 'business_analyst', model: $('Run Config').first().json.ollamaModel, seed: $('Run Config').first().json.ollamaSeed, temperature: $('Run Config').first().json.ollamaTemperature }) ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "M5eIfNwtZu8y3dOp",
          "name": "Postgres account"
        }
      }
    },
