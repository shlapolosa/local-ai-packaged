    {
      "id": "repair-solution",
      "name": "Repair Solution Package (Llama)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        10592,
        608
      ],
      "parameters": {
        "method": "POST",
        "url": "https://ollama.com/api/chat",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ {\n  model: $('Run Config').first().json.ollamaModel,\n  format: 'json',\n  messages: [\n    {\n      role: 'system',\n      content: [\n        'You are repairing a Solution Package JSON to satisfy validation rules.',\n        'Return ONLY JSON matching the schema. Do not add extra keys.',\n        '',\n        'Primary goal: remove all occurrences of ``` from any string fields (especially cloudEventsMarkdown).',\n        'Keep semantics and KEEP NON-NULL FIELDS the same unless a field is truly inconsistent with integrationStyle.',\n        '',\n        'CRITICAL RULE: Do NOT null out openapiYaml/sqlSchemaSql/asyncapiYaml/avroSchemasJson just to make validation pass.',\n        'If integrationStyle is hybrid, you must preserve at least one of openapiYaml or asyncapiYaml AND preserve whichever other artifacts were provided (sqlSchemaSql for Postgres; cloudEventsMarkdown+avroSchemasJson for events).',\n        'If integrationStyle is rest_only, preserve openapiYaml and sqlSchemaSql; set event artifacts to null only if they were null originally.',\n        'If integrationStyle is events_only, preserve asyncapiYaml, cloudEventsMarkdown, avroSchemasJson; set REST artifacts to null only if they were null originally.',\n        '',\n        'Ensure solutionMarkdown starts with \"# Solution Architecture:\" and contains no ``` fences.',\n        'Ensure cloudEventsMarkdown contains no ``` fences.'\n      ].join('\\\\n')\n    },\n    {\n      role: 'user',\n      content: [\n        'VALIDATION_ERRORS: ' + JSON.stringify($json.errors || []),\n        'ORIGINAL_PACKAGE: ' + JSON.stringify({\n          integrationStyle: $json.integrationStyle,\n          solutionMarkdown: $json.solutionMarkdown,\n          openapiYaml: $json.openapiYaml,\n          sqlSchemaSql: $json.sqlSchemaSql,\n          asyncapiYaml: $json.asyncapiYaml,\n          cloudEventsMarkdown: $json.cloudEventsMarkdown,\n          avroSchemasJson: $json.avroSchemasJson\n        }).slice(0, 14000)\n      ].join('\\\\n')\n    }\n  ],\n  stream: false,\n  format: {\n    type: 'object',\n    additionalProperties: false,\n    required: ['integrationStyle','solutionMarkdown','openapiYaml','sqlSchemaSql','asyncapiYaml','cloudEventsMarkdown','avroSchemasJson'],\n    properties: {\n      integrationStyle: { type: 'string', enum: ['rest_only','events_only','hybrid'] },\n      solutionMarkdown: { type: 'string' },\n      openapiYaml: { type: ['string','null'] },\n      sqlSchemaSql: { type: ['string','null'] },\n      asyncapiYaml: { type: ['string','null'] },\n      cloudEventsMarkdown: { type: ['string','null'] },\n      avroSchemasJson: { type: ['object','null'] }\n    }\n  },\n  options: {\n    temperature: 0,\n    seed: $('Run Config').first().json.ollamaSeed\n  }\n} }}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "retryOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "ollamacloudhdr01",
          "name": "Ollama Cloud"
        }
      }
    },
    {
      "id": "val-solution-repair",
      "name": "Validate Repaired Solution",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        10832,
        608
      ],
      "parameters": {
        "jsCode": "// Same validation logic as Validate Solution Package, but for repaired output\nconst raw = $json.message?.content;\nlet parsed;\ntry {\n  parsed = typeof raw === 'string' ? JSON.parse(raw) : raw;\n} catch (e) {\n  return [{ json: { valid: false, errors: ['Solution package parse failed: ' + e.message] } }];\n}\n\nconst errors = [];\nconst style = String(parsed?.integrationStyle || '');\nconst md = String(parsed?.solutionMarkdown || '');\nconst openapi = parsed?.openapiYaml ?? null;\nconst asyncapi = parsed?.asyncapiYaml ?? null;\nconst sql = parsed?.sqlSchemaSql ?? null;\nconst ce = parsed?.cloudEventsMarkdown ?? null;\nconst avro = parsed?.avroSchemasJson ?? null;\n\nif (!['rest_only','events_only','hybrid'].includes(style)) errors.push('integrationStyle invalid');\nif (!md.startsWith('# Solution Architecture:')) errors.push('solutionMarkdown first line must start with \"# Solution Architecture:\"');\nif (md.includes('```')) errors.push('solutionMarkdown must not include code fences');\n\nconst hasOpenApi = (typeof openapi === 'string' && openapi.trim().length > 0);\nconst hasAsyncApi = (typeof asyncapi === 'string' && asyncapi.trim().length > 0);\nconst hasSql = (typeof sql === 'string' && sql.trim().length > 0);\nconst hasCe = (typeof ce === 'string' && ce.trim().length > 0);\nconst hasAvro = (avro && typeof avro === 'object' && !Array.isArray(avro) && Object.keys(avro).length > 0);\n\nif (style === 'rest_only' && !hasOpenApi) errors.push('rest_only requires openapiYaml');\nif (style === 'rest_only' && !hasSql) errors.push('rest_only requires sqlSchemaSql');\nif (style === 'events_only' && !hasAsyncApi) errors.push('events_only requires asyncapiYaml');\nif (style === 'events_only' && !hasCe) errors.push('events_only requires cloudEventsMarkdown');\nif (style === 'events_only' && !hasAvro) errors.push('events_only requires avroSchemasJson');\nif (style === 'hybrid' && !(hasOpenApi || hasAsyncApi)) errors.push('hybrid requires at least one of openapiYaml or asyncapiYaml');\n\nconst forbidFence = (s, label) => {\n  if (typeof s === 'string' && s.includes('```')) errors.push(label + ' must not include code fences');\n};\nforbidFence(openapi, 'openapiYaml');\nforbidFence(asyncapi, 'asyncapiYaml');\nforbidFence(sql, 'sqlSchemaSql');\nforbidFence(ce, 'cloudEventsMarkdown');\n\nconst fnv1a = (input) => {\n  const s = String(input ?? '');\n  let hash = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) { hash ^= s.charCodeAt(i); hash = (hash * 0x01000193) >>> 0; }\n  return ('0000000' + hash.toString(16)).slice(-8);\n};\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors,\n    integrationStyle: style,\n    solutionMarkdown: md,\n    openapiYaml: hasOpenApi ? openapi : null,\n    asyncapiYaml: hasAsyncApi ? asyncapi : null,\n    sqlSchemaSql: hasSql ? sql : null,\n    cloudEventsMarkdown: hasCe ? ce : null,\n    avroSchemasJson: hasAvro ? avro : null,\n    hashes: {\n      solution_arch_md: fnv1a(md),\n      openapi_yaml: hasOpenApi ? fnv1a(openapi) : null,\n      asyncapi_yaml: hasAsyncApi ? fnv1a(asyncapi) : null,\n      sql_schema_sql: hasSql ? fnv1a(sql) : null,\n      cloudevents_md: hasCe ? fnv1a(ce) : null,\n      avro_schemas_json: hasAvro ? fnv1a(JSON.stringify(avro)) : null,\n    }\n  }\n}];"
      }
    },
