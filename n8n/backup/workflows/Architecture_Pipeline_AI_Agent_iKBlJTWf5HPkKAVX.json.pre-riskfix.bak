              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "2f32eea1-6568-444c-a379-1e2f2bcda299",
      "name": "Compile Response",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        4304,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "// Input is output of \"Normalize BRD Rows\" which returns { rows: [...] }\nconst rows = Array.isArray($json.rows) ? $json.rows : [];\nconst first = rows[0] || null;\nconst brd = first && typeof first.content === 'object' ? first.content : null;\n\n// Consider BRD present only if it looks like a real BRD\nconst hasBrd = !!(brd && brd.type === 'brd' && brd.title && brd.executiveSummary);\n\nreturn hasBrd\n  ? [{ json: { hasBrd: true, brdFromDb: brd } }]\n  : [{ json: { hasBrd: false } }];"
      },
      "id": "5166e003-7622-4fc6-9f85-edf9c99a0b41",
      "name": "Determine BRD Flow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1424,
        304
      ],
      "notes": "Output 0=generate BRD if missing, Output 1=use existing BRD (TODO: load into validator)"
    },
    {
