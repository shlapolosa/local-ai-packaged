      "name": "Pass Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        216
      ],
      "parameters": {
        "jsCode": "// Carry forward the original request context (slug/name/startAt)\nreturn [{ json: $('Apply Classification + Slugify').first().json }];"
      }
    },
    {
      "id": "cad4012d-f94b-45cc-9291-52e07583e31d",
      "name": "Normalize BRD Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1088,
        304
      ],
      "parameters": {
        "jsCode": "// Ensure we always output exactly one item with rows[]\nconst items = $input.all();\nif (!items.length) return [{ json: { rows: [] } }];\n\n// Postgres node returns one item per row. Normalize into rows array.\nconst rows = items.map(i => i.json);\nreturn [{ json: { rows } }];"
      },
      "alwaysOutputData": true
    },
    {
