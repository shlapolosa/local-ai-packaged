    {
      "id": "read-file",
      "name": "Read File Content",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        1760,
        400
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "={{ $json.filePath }}",
        "options": {}
