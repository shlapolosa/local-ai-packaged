    {
      "id": "read-config",
      "name": "Read Config",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [
        440,
        400
      ],
      "parameters": {
        "operation": "read",
        "fileSelector": "/data/shared/knowledge/knowledge-config.json",
        "options": {}
      }
    },
    {
      "id": "parse-config",
      "name": "Parse Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        400
      ],
      "parameters": {
        "jsCode": "const buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst config = JSON.parse(buffer.toString('utf-8'));\nconst targetCollection = $('Set Defaults').first().json.collection;\nconst basePath = $('Set Defaults').first().json.basePath;\n\nconst collectionConfig = config.collections.find(c => c.collection_name === targetCollection);\n\nif (!collectionConfig) {\n  throw new Error(`Collection '${targetCollection}' not found in config`);\n}\n\nreturn [{\n  json: {\n    collection: targetCollection,\n    folder: collectionConfig.folder,\n    folderPath: `${basePath}/${collectionConfig.folder}`,\n    fileTypes: collectionConfig.file_types,\n    chunkSize: collectionConfig.chunk_size,\n    chunkOverlap: collectionConfig.chunk_overlap,\n    consumers: collectionConfig.consumers,\n    description: collectionConfig.description\n  }\n}];"
      }
    },
    {
      "id": "list-files",
      "name": "List Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        400
      ],
      "parameters": {
        "jsCode": "const defaults = $('Set Defaults').first().json;\nconst collectionConfig = $input.first().json;\n\nif (defaults.isUpload && defaults.uploadContent) {\n  return [{ \n    json: { \n      files: [], \n      isUpload: true,\n      uploadContent: defaults.uploadContent,\n      uploadFilename: defaults.uploadFilename,\n      folderPath: collectionConfig.folderPath, \n      collection: collectionConfig.collection \n    } \n  }];\n}\n\nconst fileMapping = {\n  'capability-maps': 'capability_map_documents.json',\n  'reference-architectures': 'reference_architectures.json',\n  'guardrails-principles': 'guardrails_principles.json',\n  'existing-landscape': 'existing_landscape.json',\n  'compliance-requirements': 'compliance_requirements.json',\n  'data-standards': 'data_standards.json',\n  'security-standards': 'security_standards.json',\n  'testing-standards': 'testing_standards.json'\n};\n\nconst fileName = fileMapping[collectionConfig.collection] || `${collectionConfig.collection.replace(/-/g, '_')}.json`;\nconst filePath = `${collectionConfig.folderPath}/${fileName}`;\n\nreturn [{ json: { files: [filePath], folderPath: collectionConfig.folderPath, collection: collectionConfig.collection, isUpload: false } }];"
      }
    },
    {
      "id": "split-files",
      "name": "Split Files",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        400
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst collectionConfig = $('Parse Config').first().json;\n\nif (input.isUpload && input.uploadContent) {\n  return [{\n    json: {\n      isUpload: true,\n      content: input.uploadContent,\n      filename: input.uploadFilename,\n      collection: collectionConfig.collection,\n      chunkSize: collectionConfig.chunkSize,\n      chunkOverlap: collectionConfig.chunkOverlap\n    }\n  }];\n}\n\nconst files = input.files;\n\nif (!files || files.length === 0) {\n  return [{ json: { error: 'No files found', collection: collectionConfig.collection } }];\n}\n\nreturn files.map(filePath => ({\n  json: {\n    filePath,\n    isUpload: false,\n    collection: collectionConfig.collection,\n    chunkSize: collectionConfig.chunkSize,\n    chunkOverlap: collectionConfig.chunkOverlap\n  }\n}));"
      }
    },
    {
      "id": "check-files",
      "name": "Check Valid Input",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "or",
          "conditions": [
            {
              "id": "check-upload",
              "leftValue": "={{ $json.isUpload }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            },
            {
              "id": "check-file",
              "leftValue": "={{ $json.filePath }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists"
              }
            }
          ]
        }
      }
    },
    {
      "id": "check-upload",
      "name": "Is Upload?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-upload",
              "leftValue": "={{ $json.isUpload }}",
              "rightValue": true,
