    {
      "id": "process-upload",
      "name": "Process Upload Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        200
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst collection = $('Parse Config').first().json.collection;\n\nreturn [{\n  json: {\n    text: input.content,\n    metadata: {\n      source: input.filename || 'uploaded_content.md',\n      collection: collection,\n      fileType: 'md',\n      uploadedAt: new Date().toISOString()\n    }\n  }\n}];"
      }
    },
    {
      "id": "process-file",
      "name": "Process File Content",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        400
      ],
      "parameters": {
        "jsCode": "const input = $input.first();\nconst collection = $('Parse Config').first().json.collection;\n\nconst binaryData = input.binary?.data;\nconst filePath = binaryData ? `${binaryData.directory}/${binaryData.fileName}` : 'unknown';\n\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst fileContent = buffer.toString('utf-8');\n\nconst ext = binaryData?.fileExtension?.toLowerCase() || 'json';\nlet documents = [];\n\ntry {\n  if (ext === 'json') {\n    const data = JSON.parse(fileContent);\n    if (Array.isArray(data)) {\n      documents = data.map((item, idx) => ({\n        text: item.text || JSON.stringify(item),\n        metadata: {\n          source: filePath,\n          index: idx,\n          collection: collection,\n          ...item.metadata\n        }\n      }));\n    } else {\n      documents = [{\n        text: data.text || JSON.stringify(data),\n        metadata: {\n          source: filePath,\n          collection: collection,\n          ...data.metadata\n        }\n      }];\n    }\n  } else {\n    documents = [{\n      text: fileContent,\n      metadata: {\n        source: filePath,\n        collection: collection,\n        fileType: ext\n      }\n    }];\n  }\n} catch (e) {\n  documents = [{\n    text: fileContent,\n    metadata: {\n      source: filePath,\n      collection: collection,\n      parseError: e.message\n    }\n  }];\n}\n\nreturn documents.map(doc => ({ json: doc }));"
      }
    },
