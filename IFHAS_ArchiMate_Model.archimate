<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="IFHAS Preventive Screening Initiative" id="id-ifhas-model-001" version="5.0.0">
  <purpose>ArchiMate model for IFHAS (Integrated Family Health and Screening) initiative for Abu Dhabi Department of Health</purpose>

  <!-- ==================== MOTIVATION LAYER ==================== -->
  <folder name="Motivation" id="id-folder-motivation" type="motivation">

    <!-- STAKEHOLDERS -->
    <element xsi:type="archimate:Stakeholder" name="Department of Health Abu Dhabi (DOH/ADPHC)" id="id-sh-doh" documentation="Government entity responsible for healthcare policy and preventive screening programs"/>
    <element xsi:type="archimate:Stakeholder" name="Sahatna/TAMM Platform" id="id-sh-sahatna" documentation="Digital health super app providing citizen health services"/>
    <element xsi:type="archimate:Stakeholder" name="Daman Health Insurance" id="id-sh-daman" documentation="Insurance provider managing Thiqa coverage and IFHAS eligibility"/>
    <element xsi:type="archimate:Stakeholder" name="Malaffi HIE" id="id-sh-malaffi" documentation="Abu Dhabi Health Information Exchange for health records"/>
    <element xsi:type="archimate:Stakeholder" name="Healthcare Providers/Facilities" id="id-sh-providers" documentation="Hospitals and clinics delivering IFHAS screening services"/>
    <element xsi:type="archimate:Stakeholder" name="Accela/DOH Licensing" id="id-sh-accela" documentation="Facility licensing system identifying IFHAS providers"/>
    <element xsi:type="archimate:Stakeholder" name="Citizens (Thiqa C1-C4 Members)" id="id-sh-citizens" documentation="Target population eligible for IFHAS screening"/>
    <element xsi:type="archimate:Stakeholder" name="DOH Business Owners" id="id-sh-doh-business" documentation="Program managers responsible for IFHAS outcomes"/>
    <element xsi:type="archimate:Stakeholder" name="DOH Data Teams" id="id-sh-doh-data" documentation="Analytics teams measuring program effectiveness"/>

    <!-- DRIVERS -->
    <element xsi:type="archimate:Driver" name="Low IFHAS participation (~40%)" id="id-dr-low-participation" documentation="Current screening uptake is significantly below target"/>
    <element xsi:type="archimate:Driver" name="Rising chronic disease burden" id="id-dr-chronic-disease" documentation="Increasing prevalence of cardiovascular, mental health, and cancer conditions"/>
    <element xsi:type="archimate:Driver" name="Need to improve population health" id="id-dr-population-health" documentation="Strategic imperative to shift from reactive to preventive care"/>
    <element xsi:type="archimate:Driver" name="Fragmented citizen screening journeys" id="id-dr-fragmented-journey" documentation="Disconnected touchpoints across eligibility, booking, and results"/>
    <element xsi:type="archimate:Driver" name="Poor visibility of IFHAS services" id="id-dr-poor-visibility" documentation="Citizens unaware of available screening programs"/>
    <element xsi:type="archimate:Driver" name="Complex booking processes" id="id-dr-complex-booking" documentation="Difficult multi-step appointment booking across providers"/>
    <element xsi:type="archimate:Driver" name="Low engagement with preventive services" id="id-dr-low-engagement" documentation="Citizens not proactively seeking preventive care"/>
    <element xsi:type="archimate:Driver" name="Manual eligibility verification" id="id-dr-manual-eligibility" documentation="Fragmented IFHAS history and eligibility checks"/>
    <element xsi:type="archimate:Driver" name="Inconsistent user follow-through" id="id-dr-inconsistent-followthrough" documentation="Eligible users not completing available packages"/>
    <element xsi:type="archimate:Driver" name="Screening results not accessible" id="id-dr-results-inaccessible" documentation="Citizens cannot easily view their screening results"/>
    <element xsi:type="archimate:Driver" name="Difficulty distinguishing IFHAS encounters" id="id-dr-encounter-identification" documentation="No standardized way to identify IFHAS visits"/>
    <element xsi:type="archimate:Driver" name="Inconsistent IFHAS service identification" id="id-dr-service-identification" documentation="Facilities not consistently flagging IFHAS services"/>
    <element xsi:type="archimate:Driver" name="No centralized IFHAS provider list" id="id-dr-no-provider-list" documentation="Lack of authoritative facility registry"/>
    <element xsi:type="archimate:Driver" name="Limited preventive screening information" id="id-dr-limited-info" documentation="Citizens lack access to eligibility and package details"/>
    <element xsi:type="archimate:Driver" name="Difficulty managing appointments/results" id="id-dr-appointment-difficulty" documentation="No unified digital access to booking and results"/>
    <element xsi:type="archimate:Driver" name="Lack of proactive health engagement" id="id-dr-no-proactive-engagement" documentation="No system to remind citizens of preventive care"/>
    <element xsi:type="archimate:Driver" name="Lack of screening experience feedback" id="id-dr-no-feedback" documentation="No mechanism to collect post-appointment surveys"/>
    <element xsi:type="archimate:Driver" name="Limited program effectiveness visibility" id="id-dr-limited-visibility" documentation="Insufficient data on engagement and outcomes"/>

    <!-- GOALS -->
    <element xsi:type="archimate:Goal" name="Increase IFHAS participation by 75% by 2026" id="id-gl-increase-participation" documentation="Primary KPI for program success"/>
    <element xsi:type="archimate:Goal" name="Enable early detection through preventive screening" id="id-gl-early-detection" documentation="Identify chronic conditions before complications"/>
    <element xsi:type="archimate:Goal" name="Shift healthcare to preventive model" id="id-gl-preventive-model" documentation="Transform from reactive to proactive care"/>
    <element xsi:type="archimate:Goal" name="Provide unified digital IFHAS experience" id="id-gl-unified-experience" documentation="Single integrated journey for all IFHAS touchpoints"/>
    <element xsi:type="archimate:Goal" name="Increase awareness of IFHAS programs" id="id-gl-increase-awareness" documentation="Educate citizens on benefits and eligibility"/>
    <element xsi:type="archimate:Goal" name="Digitize and simplify IFHAS booking" id="id-gl-digitize-booking" documentation="Enable seamless appointment booking"/>
    <element xsi:type="archimate:Goal" name="Proactively engage users via nudges" id="id-gl-proactive-engagement" documentation="Send timely reminders based on eligibility"/>
    <element xsi:type="archimate:Goal" name="Centralize eligibility and package data via APIs" id="id-gl-centralize-data" documentation="Real-time integration with Daman"/>
    <element xsi:type="archimate:Goal" name="Enable proactive engagement using insurance data" id="id-gl-insurance-engagement" documentation="Use Thiqa data to drive engagement"/>
    <element xsi:type="archimate:Goal" name="Digitally expose IFHAS screening results" id="id-gl-expose-results" documentation="Make results accessible in Sahatna"/>
    <element xsi:type="archimate:Goal" name="Standardize IFHAS encounter identification" id="id-gl-standardize-encounters" documentation="Use ICS codes for encounter tagging"/>
    <element xsi:type="archimate:Goal" name="Clearly flag IFHAS services and encounters" id="id-gl-flag-services" documentation="Providers tag IFHAS appointments"/>
    <element xsi:type="archimate:Goal" name="Maintain authoritative IFHAS facility list" id="id-gl-facility-list" documentation="DOH licensing integration"/>
    <element xsi:type="archimate:Goal" name="Easily discover eligible IFHAS packages" id="id-gl-discover-packages" documentation="Personalized package display"/>
    <element xsi:type="archimate:Goal" name="Access booking, questionnaires, results digitally" id="id-gl-digital-access" documentation="Full digital journey access"/>
    <element xsi:type="archimate:Goal" name="Receive reminders and nudges" id="id-gl-receive-reminders" documentation="Proactive notifications"/>
    <element xsi:type="archimate:Goal" name="Collect post-appointment survey feedback" id="id-gl-collect-feedback" documentation="Survey mechanism for quality improvement"/>
    <element xsi:type="archimate:Goal" name="Measure engagement, completion, satisfaction" id="id-gl-measure-kpis" documentation="Analytics and reporting"/>

    <!-- OUTCOMES -->
    <element xsi:type="archimate:Outcome" name="Higher population screening uptake" id="id-oc-higher-uptake" documentation="Increased number of citizens completing IFHAS screenings"/>
    <element xsi:type="archimate:Outcome" name="Earlier diagnosis and reduced complications" id="id-oc-earlier-diagnosis" documentation="Chronic conditions detected before progression"/>
    <element xsi:type="archimate:Outcome" name="Improved public health indicators" id="id-oc-improved-health" documentation="Better population health metrics and longevity"/>
    <element xsi:type="archimate:Outcome" name="Seamless end-to-end screening journey" id="id-oc-seamless-journey" documentation="Unified citizen experience from discovery to results"/>
    <element xsi:type="archimate:Outcome" name="Citizens understand eligibility and value" id="id-oc-citizen-understanding" documentation="Improved awareness of IFHAS benefits"/>
    <element xsi:type="archimate:Outcome" name="Reduced booking friction" id="id-oc-reduced-friction" documentation="Faster, easier appointment completion"/>
    <element xsi:type="archimate:Outcome" name="Increased booking and completion rates" id="id-oc-increased-completion" documentation="More citizens booking and attending screenings"/>
    <element xsi:type="archimate:Outcome" name="Reliable real-time eligibility determination" id="id-oc-reliable-eligibility" documentation="Accurate Thiqa status and package availability"/>
    <element xsi:type="archimate:Outcome" name="Higher utilization of approved packages" id="id-oc-higher-utilization" documentation="More eligible packages being used"/>
    <element xsi:type="archimate:Outcome" name="Citizens can view results in Sahatna" id="id-oc-results-accessible" documentation="Screening results visible in app"/>
    <element xsi:type="archimate:Outcome" name="Accurate IFHAS report classification" id="id-oc-accurate-classification" documentation="Correct encounter identification"/>
    <element xsi:type="archimate:Outcome" name="Facilities correctly appear in journeys" id="id-oc-facilities-visible" documentation="Licensed facilities shown appropriately"/>
    <element xsi:type="archimate:Outcome" name="Users only see licensed facilities" id="id-oc-licensed-facilities" documentation="Filtered facility list"/>
    <element xsi:type="archimate:Outcome" name="Increased awareness of preventive options" id="id-oc-increased-awareness" documentation="Citizens know their eligible packages"/>
    <element xsi:type="archimate:Outcome" name="Improved citizen experience and satisfaction" id="id-oc-improved-experience" documentation="Higher NPS and satisfaction scores"/>
    <element xsi:type="archimate:Outcome" name="Increased screening completion and follow-up" id="id-oc-completion-followup" documentation="More screenings completed"/>
    <element xsi:type="archimate:Outcome" name="Continuous IFHAS service quality improvement" id="id-oc-quality-improvement" documentation="Feedback-driven enhancements"/>
    <element xsi:type="archimate:Outcome" name="Data-driven program optimization" id="id-oc-data-driven" documentation="Analytics-informed decisions"/>

  </folder>

  <!-- ==================== STRATEGY LAYER ==================== -->
  <folder name="Strategy" id="id-folder-strategy" type="strategy">

    <!-- COURSES OF ACTION -->
    <element xsi:type="archimate:CourseOfAction" name="Implement digital eligibility checks and booking via Sahatna" id="id-coa-digital-eligibility" documentation="Digital IFHAS discovery, eligibility, booking journeys, reminders, and nudges"/>
    <element xsi:type="archimate:CourseOfAction" name="Provide age/gender-based IFHAS packages" id="id-coa-age-gender-packages" documentation="Enable timely booking of preventive screenings by demographic"/>
    <element xsi:type="archimate:CourseOfAction" name="Operationalize DOH preventive strategy" id="id-coa-operationalize-strategy" documentation="Scalable digital screening access"/>
    <element xsi:type="archimate:CourseOfAction" name="Deliver unified IFHAS flow" id="id-coa-unified-flow" documentation="Eligibility, packages, facility selection, booking, questionnaires, results, history"/>
    <element xsi:type="archimate:CourseOfAction" name="Publish IFHAS educational content" id="id-coa-publish-content" documentation="Benefits, FAQs, offerings through landing pages and CMS"/>
    <element xsi:type="archimate:CourseOfAction" name="Integrate Sahatna with EMRs for booking" id="id-coa-emr-integration" documentation="Direct in-app booking of IFHAS appointments"/>
    <element xsi:type="archimate:CourseOfAction" name="Send proactive nudges and reminders" id="id-coa-send-nudges" documentation="Based on eligibility, insurance status, pending packages"/>
    <element xsi:type="archimate:CourseOfAction" name="Integrate with Daman APIs" id="id-coa-daman-integration" documentation="Retrieve Thiqa status, packages, authorization history"/>
    <element xsi:type="archimate:CourseOfAction" name="Surface actionable booking prompts" id="id-coa-booking-prompts" documentation="Use Daman eligibility data for prompts"/>
    <element xsi:type="archimate:CourseOfAction" name="Integrate with Malaffi for results" id="id-coa-malaffi-integration" documentation="Retrieve and expose IFHAS screening results"/>
    <element xsi:type="archimate:CourseOfAction" name="Enforce IFHAS encounter identification" id="id-coa-enforce-encounter-id" documentation="Use ICS visit codes and encounter IDs"/>
    <element xsi:type="archimate:CourseOfAction" name="Maintain IFHAS facility list via Accela" id="id-coa-maintain-facility-list" documentation="DOH licensing integration"/>
    <element xsi:type="archimate:CourseOfAction" name="Filter facilities using DOH licensing flags" id="id-coa-filter-facilities" documentation="Show only licensed IFHAS providers"/>
    <element xsi:type="archimate:CourseOfAction" name="Display personalized eligible packages" id="id-coa-personalized-packages" documentation="Based on age, gender, and history"/>
    <element xsi:type="archimate:CourseOfAction" name="Implement UX improvements and surveys" id="id-coa-ux-surveys" documentation="Collect post-appointment feedback"/>
    <element xsi:type="archimate:CourseOfAction" name="Trigger appointment reminders" id="id-coa-trigger-reminders" documentation="24H and 1H before appointments"/>
    <element xsi:type="archimate:CourseOfAction" name="Collect and analyze survey feedback" id="id-coa-analyze-feedback" documentation="Post-appointment survey analysis"/>
    <element xsi:type="archimate:CourseOfAction" name="Track KPIs across program" id="id-coa-track-kpis" documentation="Engagement, completion, satisfaction, outcomes"/>

    <!-- CAPABILITIES -->
    <element xsi:type="archimate:Capability" name="Patient Identification" id="id-cap-patient-id" documentation="Ability to identify and authenticate patients"/>
    <element xsi:type="archimate:Capability" name="Patient Profile Management" id="id-cap-patient-profile" documentation="Ability to manage patient demographic and preference data"/>
    <element xsi:type="archimate:Capability" name="Patient Preference Management" id="id-cap-patient-preference" documentation="Ability to capture and apply patient communication preferences"/>
    <element xsi:type="archimate:Capability" name="Patient History Management" id="id-cap-patient-history" documentation="Ability to maintain longitudinal patient records"/>
    <element xsi:type="archimate:Capability" name="Patient Analytics Management" id="id-cap-patient-analytics" documentation="Ability to analyze patient engagement and outcomes"/>
    <element xsi:type="archimate:Capability" name="Healthcare Service Portfolio Management" id="id-cap-service-portfolio" documentation="Ability to manage catalog of healthcare services"/>
    <element xsi:type="archimate:Capability" name="Healthcare Service/Patient Matching" id="id-cap-service-patient-matching" documentation="Ability to match services to eligible patients"/>
    <element xsi:type="archimate:Capability" name="Healthcare Case Establishment" id="id-cap-case-establishment" documentation="Ability to create and initialize healthcare cases"/>
    <element xsi:type="archimate:Capability" name="Healthcare Case Encounter Management" id="id-cap-encounter-mgmt" documentation="Ability to manage patient encounters"/>
    <element xsi:type="archimate:Capability" name="Healthcare Case Information Management" id="id-cap-case-info-mgmt" documentation="Ability to manage case data and history"/>
    <element xsi:type="archimate:Capability" name="Medical Facility Management" id="id-cap-facility-mgmt" documentation="Ability to manage facility information and status"/>
    <element xsi:type="archimate:Capability" name="Medical Facility/Service Matching" id="id-cap-facility-service-matching" documentation="Ability to link facilities to services"/>
    <element xsi:type="archimate:Capability" name="Agreement Eligibility Determination" id="id-cap-agreement-eligibility" documentation="Ability to determine insurance eligibility"/>
    <element xsi:type="archimate:Capability" name="Agreement Lifecycle Management" id="id-cap-agreement-lifecycle" documentation="Ability to track insurance policy states"/>
    <element xsi:type="archimate:Capability" name="Agreement Information Management" id="id-cap-agreement-info" documentation="Ability to manage insurance data"/>
    <element xsi:type="archimate:Capability" name="Message Management" id="id-cap-message-mgmt" documentation="Ability to create and deliver messages"/>
    <element xsi:type="archimate:Capability" name="Message/Patient Matching" id="id-cap-message-patient-matching" documentation="Ability to target messages to patients"/>
    <element xsi:type="archimate:Capability" name="Message/Schedule Matching" id="id-cap-message-schedule-matching" documentation="Ability to schedule messages"/>
    <element xsi:type="archimate:Capability" name="Channel Management" id="id-cap-channel-mgmt" documentation="Ability to manage delivery channels"/>
    <element xsi:type="archimate:Capability" name="Content Management" id="id-cap-content-mgmt" documentation="Ability to create and publish content"/>
    <element xsi:type="archimate:Capability" name="Meeting/Appointment Management" id="id-cap-meeting-mgmt" documentation="Ability to schedule and manage appointments"/>
    <element xsi:type="archimate:Capability" name="Schedule Management" id="id-cap-schedule-mgmt" documentation="Ability to manage time slots and availability"/>
    <element xsi:type="archimate:Capability" name="Work Item Management" id="id-cap-work-item-mgmt" documentation="Ability to track work items and tasks"/>
    <element xsi:type="archimate:Capability" name="Inquiry/Feedback Management" id="id-cap-inquiry-mgmt" documentation="Ability to collect and manage feedback"/>
    <element xsi:type="archimate:Capability" name="Health Condition Management" id="id-cap-health-condition" documentation="Ability to track health conditions"/>
    <element xsi:type="archimate:Capability" name="Information Transformation" id="id-cap-info-transformation" documentation="Ability to transform data formats"/>
    <element xsi:type="archimate:Capability" name="Information Security Management" id="id-cap-info-security" documentation="Ability to secure information access"/>
    <element xsi:type="archimate:Capability" name="Partner Management" id="id-cap-partner-mgmt" documentation="Ability to manage healthcare partners"/>
    <element xsi:type="archimate:Capability" name="Performance Management" id="id-cap-performance-mgmt" documentation="Ability to measure and report performance"/>

    <!-- RESOURCES -->
    <element xsi:type="archimate:Resource" name="Daman API" id="id-res-daman-api" documentation="External API for Thiqa eligibility and IFHAS data"/>
    <element xsi:type="archimate:Resource" name="Malaffi API" id="id-res-malaffi-api" documentation="External API for health records and results"/>
    <element xsi:type="archimate:Resource" name="DOH Licensing Data" id="id-res-doh-licensing" documentation="Facility licensing information from Accela"/>
    <element xsi:type="archimate:Resource" name="IFHAS Package Definitions" id="id-res-ifhas-packages" documentation="DOH-defined screening packages"/>

  </folder>

  <!-- ==================== BUSINESS LAYER ==================== -->
  <folder name="Business" id="id-folder-business" type="business">

    <!-- BUSINESS PROCESSES -->
    <element xsi:type="archimate:BusinessProcess" name="Check User Eligibility" id="id-bp-check-eligibility" documentation="Verify user IFHAS eligibility via Daman"/>
    <element xsi:type="archimate:BusinessProcess" name="Display IFHAS Landing Page" id="id-bp-landing-page" documentation="Show IFHAS information and options to eligible users"/>
    <element xsi:type="archimate:BusinessProcess" name="Determine Available Packages" id="id-bp-determine-packages" documentation="Calculate available packages based on age/gender/history"/>
    <element xsi:type="archimate:BusinessProcess" name="Select IFHAS Package" id="id-bp-select-package" documentation="User selects desired screening package"/>
    <element xsi:type="archimate:BusinessProcess" name="Select IFHAS Facility" id="id-bp-select-facility" documentation="User chooses from licensed IFHAS providers"/>
    <element xsi:type="archimate:BusinessProcess" name="Select Physician" id="id-bp-select-physician" documentation="User selects physician with available slots"/>
    <element xsi:type="archimate:BusinessProcess" name="Choose Appointment Slot" id="id-bp-choose-slot" documentation="User selects available time slot"/>
    <element xsi:type="archimate:BusinessProcess" name="Book IFHAS Appointment" id="id-bp-book-appointment" documentation="Confirm and create appointment"/>
    <element xsi:type="archimate:BusinessProcess" name="Fill Pre-screening Questionnaire" id="id-bp-fill-questionnaire" documentation="Complete digital questionnaire for Major package"/>
    <element xsi:type="archimate:BusinessProcess" name="Send Appointment Reminders" id="id-bp-send-reminders" documentation="24H and 1H reminder notifications"/>
    <element xsi:type="archimate:BusinessProcess" name="View IFHAS Results" id="id-bp-view-results" documentation="Display screening results from Malaffi"/>
    <element xsi:type="archimate:BusinessProcess" name="View Encounter History" id="id-bp-view-history" documentation="Display past IFHAS appointments and packages"/>
    <element xsi:type="archimate:BusinessProcess" name="Send Eligibility Nudges" id="id-bp-send-nudges" documentation="Proactive notifications based on eligibility"/>
    <element xsi:type="archimate:BusinessProcess" name="Collect Post-Appointment Survey" id="id-bp-collect-survey" documentation="Gather feedback after screening"/>
    <element xsi:type="archimate:BusinessProcess" name="Sync Facility Data" id="id-bp-sync-facilities" documentation="Daily sync with DOH licensing system"/>

    <!-- BUSINESS SERVICES -->
    <element xsi:type="archimate:BusinessService" name="IFHAS Eligibility Service" id="id-bs-eligibility" documentation="Provides eligibility verification"/>
    <element xsi:type="archimate:BusinessService" name="IFHAS Booking Service" id="id-bs-booking" documentation="Provides appointment booking"/>
    <element xsi:type="archimate:BusinessService" name="IFHAS Information Service" id="id-bs-information" documentation="Provides program information and education"/>
    <element xsi:type="archimate:BusinessService" name="IFHAS Results Service" id="id-bs-results" documentation="Provides access to screening results"/>
    <element xsi:type="archimate:BusinessService" name="IFHAS Notification Service" id="id-bs-notification" documentation="Provides reminders and nudges"/>

    <!-- BUSINESS ACTORS -->
    <element xsi:type="archimate:BusinessActor" name="Citizen/Patient" id="id-ba-citizen" documentation="User of Sahatna seeking IFHAS screening"/>
    <element xsi:type="archimate:BusinessActor" name="Healthcare Provider" id="id-ba-provider" documentation="Facility delivering IFHAS screening"/>
    <element xsi:type="archimate:BusinessActor" name="DOH Administrator" id="id-ba-doh-admin" documentation="Program administrator"/>

  </folder>

  <!-- ==================== APPLICATION LAYER ==================== -->
  <folder name="Application" id="id-folder-application" type="application">

    <!-- APPLICATION COMPONENTS -->
    <element xsi:type="archimate:ApplicationComponent" name="Identity Service Module" id="id-ac-identity" documentation="Authentication and token management"/>
    <element xsi:type="archimate:ApplicationComponent" name="Patient Service Module" id="id-ac-patient" documentation="Patient information and preferences"/>
    <element xsi:type="archimate:ApplicationComponent" name="Provider Service Module" id="id-ac-provider" documentation="Facility and physician management"/>
    <element xsi:type="archimate:ApplicationComponent" name="Integration Service Module" id="id-ac-integration" documentation="FHIR transformation and provider integration"/>
    <element xsi:type="archimate:ApplicationComponent" name="Appointment Service Module" id="id-ac-appointment" documentation="Appointment lifecycle management"/>
    <element xsi:type="archimate:ApplicationComponent" name="PHR Service Module" id="id-ac-phr" documentation="Patient health records from Malaffi"/>
    <element xsi:type="archimate:ApplicationComponent" name="Notification Service Module" id="id-ac-notification" documentation="SMS, Email, Push notifications"/>
    <element xsi:type="archimate:ApplicationComponent" name="Reference Service Module" id="id-ac-reference" documentation="Lookup values and reference data"/>
    <element xsi:type="archimate:ApplicationComponent" name="CMS Service Module" id="id-ac-cms" documentation="Content management via Strapi"/>
    <element xsi:type="archimate:ApplicationComponent" name="Batch Worker Service Module" id="id-ac-batch" documentation="Background jobs and data sync"/>
    <element xsi:type="archimate:ApplicationComponent" name="Sahatna Mobile App" id="id-ac-mobile" documentation="iOS and Android mobile application"/>

    <!-- APPLICATION SERVICES -->
    <element xsi:type="archimate:ApplicationService" name="UAE Pass Login Service" id="id-as-uaepass" documentation="User authentication via UAE Pass"/>
    <element xsi:type="archimate:ApplicationService" name="Patient Info API" id="id-as-patient-info" documentation="Patient data retrieval"/>
    <element xsi:type="archimate:ApplicationService" name="Eligibility Check API" id="id-as-eligibility" documentation="Daman eligibility verification"/>
    <element xsi:type="archimate:ApplicationService" name="Package Determination API" id="id-as-packages" documentation="Available packages calculation"/>
    <element xsi:type="archimate:ApplicationService" name="Facility Search API" id="id-as-facility-search" documentation="IFHAS facility lookup"/>
    <element xsi:type="archimate:ApplicationService" name="Physician Search API" id="id-as-physician-search" documentation="Physician availability lookup"/>
    <element xsi:type="archimate:ApplicationService" name="Slot Availability API" id="id-as-slots" documentation="Time slot availability"/>
    <element xsi:type="archimate:ApplicationService" name="Appointment Booking API" id="id-as-booking" documentation="Appointment creation"/>
    <element xsi:type="archimate:ApplicationService" name="PHR Retrieval API" id="id-as-phr" documentation="Health records from Malaffi"/>
    <element xsi:type="archimate:ApplicationService" name="Notification API" id="id-as-notification" documentation="Message delivery"/>
    <element xsi:type="archimate:ApplicationService" name="Survey API" id="id-as-survey" documentation="Feedback collection"/>
    <element xsi:type="archimate:ApplicationService" name="Content Delivery API" id="id-as-content" documentation="CMS content retrieval"/>
    <element xsi:type="archimate:ApplicationService" name="DOH Licensing Sync API" id="id-as-licensing-sync" documentation="Facility data synchronization"/>

    <!-- EXTERNAL APPLICATION COMPONENTS -->
    <element xsi:type="archimate:ApplicationComponent" name="Daman Insurance System" id="id-ac-ext-daman" documentation="External: Thiqa eligibility and IFHAS history"/>
    <element xsi:type="archimate:ApplicationComponent" name="Malaffi HIE System" id="id-ac-ext-malaffi" documentation="External: Health information exchange"/>
    <element xsi:type="archimate:ApplicationComponent" name="DOH Licensing System (Accela)" id="id-ac-ext-accela" documentation="External: Facility licensing"/>
    <element xsi:type="archimate:ApplicationComponent" name="Provider EMR Systems" id="id-ac-ext-emr" documentation="External: Facility EMR systems"/>
    <element xsi:type="archimate:ApplicationComponent" name="UAE Pass" id="id-ac-ext-uaepass" documentation="External: Digital identity platform"/>
    <element xsi:type="archimate:ApplicationComponent" name="Strapi CMS" id="id-ac-ext-strapi" documentation="External: Content management system"/>
    <element xsi:type="archimate:ApplicationComponent" name="Firebase" id="id-ac-ext-firebase" documentation="External: Push notification service"/>

  </folder>

  <!-- ==================== RELATIONS ==================== -->
  <folder name="Relations" id="id-folder-relations" type="relations">

    <!-- STAKEHOLDER-DRIVER ASSOCIATIONS -->
    <element xsi:type="archimate:AssociationRelationship" id="id-rel-001" source="id-sh-doh" target="id-dr-low-participation"/>
